---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This road wandered off the map.">
  <section class="section">
    <div class="site-shell lost">
      <p class="eyebrow">404</p>
      <h1 class="section-title">This road isn’t marked.</h1>
      <p class="section-lead">
        Wrong turn, missing sign, or a page that was never written. Still rolling — try the rides,
        or head back to camp.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Back home</a>
        <a class="btn btn-ghost" href="/stories">Browse the rides</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    max-width: 36rem;
    padding-block: 2rem 4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
