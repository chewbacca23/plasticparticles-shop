---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="Wrong turn. This page is not on the route.">
  <section class="section">
    <div class="site-shell lost">
      <p class="eyebrow">404</p>
      <h1 class="section-title">Wrong turn.</h1>
      <p class="section-lead">
        This page is not on the cue sheet. Check the map, roll back to the rides, or open a ride
        note.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/stories">The rides</a>
        <a class="btn btn-ghost" href="/journal">Ride notes</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    max-width: 36rem;
    padding-block: 2rem 4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
