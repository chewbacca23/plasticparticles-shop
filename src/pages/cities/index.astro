---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cities } from '../../lib/cities';
import { existingMedia } from '../../lib/media';

const list = [...cities].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Cities"
  description="Soul Searchers cities: Berlin, Nice, Cologne, and the stops where rides, shops, and pins meet. Start here when you search a place by name."
  image={list.find((c) => c.cover)?.cover}
>
  <section class="section">
    <div class="site-shell cities">
      <p class="eyebrow reveal">Places</p>
      <h1 class="section-title reveal reveal-delay-1">Cities</h1>
      <p class="section-lead reveal reveal-delay-2">
        Each city gathers the rides, shops, and pins that belong there.<br />
        Open one when you want Berlin kilometres, Nice light, or a workshop stop on the map.
      </p>

      <ul class="city-grid">
        {
          list.map((city, index) => {
            const cover = city.cover ? existingMedia([city.cover])[0] : undefined;
            const delay =
              index === 0 ? 'reveal reveal-delay-2' : index === 1 ? 'reveal reveal-delay-3' : 'reveal';
            return (
              <li class:list={['city-card', delay]}>
                <a class="city-link" href={`/cities/${city.slug}`}>
                  {cover ? (
                    <img
                      class="city-cover"
                      src={cover}
                      alt=""
                      width="1200"
                      height="800"
                      loading={index < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ) : (
                    <span class="city-cover city-cover--empty" aria-hidden="true" />
                  )}
                  <span class="city-copy">
                    <span class="city-name">{city.name}</span>
                    <span class="city-country">{city.country}</span>
                    <span class="city-blurb">{city.lead}</span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .cities {
    max-width: 52rem;
  }

  .city-grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.35rem;
  }

  @media (min-width: 720px) {
    .city-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .city-link {
    display: grid;
    gap: 0.85rem;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }

  .city-link:hover .city-name,
  .city-link:focus-visible .city-name {
    color: var(--amber-hot, #f0c27a);
  }

  .city-cover {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 2px;
    background: rgba(30, 58, 69, 0.45);
  }

  .city-cover--empty {
    background: linear-gradient(145deg, rgba(30, 58, 69, 0.7), rgba(12, 18, 24, 0.9));
  }

  .city-copy {
    display: grid;
    gap: 0.25rem;
  }

  .city-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--paper);
    transition: color 0.18s ease;
  }

  .city-country {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(215, 224, 232, 0.55);
  }

  .city-blurb {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(215, 224, 232, 0.72);
  }
</style>
