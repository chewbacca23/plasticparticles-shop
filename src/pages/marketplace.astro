---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Marketplace"
  description="The Soul Searchers marketplace. A crowd of riders — ride together, or trade a tire, a stem, a saddle, a frame."
>
  <section class="section">
    <div class="site-shell hooks">
      <p class="eyebrow">Marketplace</p>
      <h1 class="section-title">The marketplace</h1>
      <p class="section-lead">
        Room for a thousand. People who want to ride, and people with a tire, a stem, a saddle,
        even a frame from time to time. Each dot is a person. Neighbours were drawn there. Click
        one and it opens. Email stays off the page.
      </p>

      <!-- Live crowd sign: real count from the board so hesitant riders see they are not alone. -->
      <aside class="crowd-sign" id="crowd-sign" aria-live="polite">
        <p class="crowd-sign-kicker">Already here</p>
        <p class="crowd-sign-count">
          <span id="crowd-sign-num">0</span>
          <span class="crowd-sign-unit" id="crowd-sign-unit">riders standing</span>
        </p>
        <p class="crowd-sign-line" id="crowd-sign-line">
          Be the first. Open a stall, show up for a ride, make coming back a habit.
        </p>
        <a class="btn btn-primary crowd-sign-cta" href="#pin-form">Stand with them</a>
      </aside>

      <p id="board-error" class="error" hidden></p>
      <p id="board-hint" class="hint" hidden></p>

      <section class="group" id="group" aria-label="The group">
        <p class="group-kicker">The crowd <span id="group-count"></span></p>
        <div class="group-room" id="group-room">
          <svg class="group-links" id="group-links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"></svg>
          <div class="group-dots" id="group-dots">
            <p class="group-empty">No one standing here yet.</p>
          </div>
          <aside class="group-open" id="group-open" hidden></aside>
        </div>
      </section>

      <p class="floor-kicker">The floor</p>
      <ol id="hook-list" class="market">
        <li class="empty">The market is empty. Open the first stall.</li>
      </ol>

      <div id="pin-success" class="success" hidden>
        <h2>It’s on the floor</h2>
        <p>If you left a mail, offers can also land in your inbox. Either way, they show here.</p>
      </div>

      <form id="pin-form" class="form" method="post" action="/api/hooks">
        <h2 class="form-title">Open a stall</h2>
        <label>
          <span>A name — any name</span>
          <input type="text" name="name" required maxlength="80" placeholder="The dog, Alex, nobody" />
        </label>
        <label>
          <span>Where</span>
          <input
            type="text"
            name="place"
            required
            maxlength="80"
            placeholder="Berlin, Nice, a train, a climb"
          />
        </label>
        <label>
          <span>The offer</span>
          <textarea
            name="note"
            rows="3"
            required
            maxlength="400"
            placeholder="Sunday ride from Kreuzberg. 28mm tires, take them. A stem, a saddle, a frame from time to time."
          ></textarea>
        </label>
        <label>
          <span>Email — optional, stays off the page</span>
          <input type="email" name="email" autocomplete="email" maxlength="200" />
        </label>
        <label class="hp" aria-hidden="true">
          <span>Company</span>
          <input type="text" name="fax_number_leave_blank" tabindex="-1" autocomplete="off" />
        </label>
        <button class="btn btn-primary" type="submit">Put it on the floor</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var list = document.getElementById('hook-list');
    var pinForm = document.getElementById('pin-form');
    var pinSuccess = document.getElementById('pin-success');
    var errorBox = document.getElementById('board-error');
    var hintBox = document.getElementById('board-hint');
    var dotsBox = document.getElementById('group-dots');
    var linksBox = document.getElementById('group-links');
    var openBox = document.getElementById('group-open');
    var roomBox = document.getElementById('group-room');
    var countBox = document.getElementById('group-count');
    var signNum = document.getElementById('crowd-sign-num');
    var signUnit = document.getElementById('crowd-sign-unit');
    var signLine = document.getElementById('crowd-sign-line');
    var signRoot = document.getElementById('crowd-sign');
    var canModerate = false;
    var lastPayload = null;
    var openKey = '';

    function writeCrowdSign(n) {
      var count = Math.max(0, Number(n) || 0);
      if (signNum) signNum.textContent = String(count);
      if (signUnit) {
        signUnit.textContent = count === 1 ? 'rider standing' : 'riders standing';
      }
      if (signLine) {
        signLine.textContent =
          count === 0
            ? 'Be the first. Open a stall, show up for a ride, make coming back a habit.'
            : count === 1
              ? 'One soul is already here. Stand with them — rides get easier when you come back.'
              : count +
                ' souls already here. Come for the rides. Make showing up a habit.';
      }
      if (signRoot) {
        signRoot.classList.toggle('has-crowd', count > 0);
        signRoot.setAttribute('data-count', String(count));
      }
    }

    function showError(text) {
      if (!errorBox) return;
      errorBox.textContent = text || 'Could not do that just now.';
      errorBox.hidden = false;
    }

    function hideError() {
      if (!errorBox) return;
      errorBox.hidden = true;
      errorBox.textContent = '';
    }

    function esc(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function flatten(hooks) {
      var cards = [];
      (hooks || []).forEach(function (hook) {
        cards.push({
          kind: 'stall',
          id: hook.id,
          hookId: hook.id,
          name: hook.name,
          place: hook.place,
          note: hook.note,
          at: hook.at,
          offerCount: (hook.offers || []).length,
        });
        (hook.offers || []).forEach(function (offer) {
          cards.push({
            kind: 'offer',
            id: offer.id,
            hookId: hook.id,
            name: offer.name,
            place: hook.place,
            forName: hook.name,
            note: offer.note,
            at: offer.at,
          });
        });
      });
      cards.sort(function (a, b) {
        return String(b.at || '').localeCompare(String(a.at || ''));
      });
      return cards;
    }

    function cardsFrom(payload) {
      if (payload && payload.market) return payload.market;
      return flatten(payload && payload.hooks);
    }

    function writeForm(hookId) {
      return (
        '<form class="write-form" hidden data-for="' +
        esc(hookId) +
        '">' +
        '<label><span>A name — any name</span><input type="text" name="name" required maxlength="80" /></label>' +
        '<label><span>Your offer</span><textarea name="message" rows="3" required maxlength="2000"></textarea></label>' +
        '<label><span>Email — optional</span><input type="email" name="email" maxlength="200" /></label>' +
        '<label class="hp" aria-hidden="true"><span>Fax</span><input type="text" name="fax_number_leave_blank" tabindex="-1" autocomplete="off" /></label>' +
        '<button class="btn btn-primary" type="submit">Leave offer</button>' +
        '</form>'
      );
    }

    function renderCard(card) {
      var isStall = card.kind !== 'offer';
      var hookId = card.hookId || card.id;
      var remove =
        canModerate && isStall
          ? '<button type="button" class="hook-remove" data-remove="' +
            esc(hookId) +
            '">Take down</button>'
          : '';
      var kind = isStall ? 'Stall' : 'Offer';
      var forLine = !isStall && card.forName
        ? '<p class="card-for">for ' + esc(card.forName) + '</p>'
        : isStall && card.offerCount
          ? '<p class="card-for">' +
            card.offerCount +
            (card.offerCount === 1 ? ' offer on the floor' : ' offers on the floor') +
            '</p>'
          : '';
      return (
        '<li class="card card-' +
        (isStall ? 'stall' : 'offer') +
        '" data-id="' +
        esc(card.id) +
        '">' +
        '<p class="card-kind">' +
        kind +
        '</p>' +
        '<p class="hook-place">' +
        esc(card.place) +
        '</p>' +
        '<h2 class="hook-name">' +
        esc(card.name) +
        '</h2>' +
        forLine +
        '<p class="hook-note">' +
        esc(card.note) +
        '</p>' +
        '<button type="button" class="btn btn-ghost hook-write" data-write="' +
        esc(hookId) +
        '">' +
        (isStall ? 'Make an offer' : 'Offer on that stall') +
        '</button>' +
        remove +
        writeForm(hookId) +
        '</li>'
      );
    }

    function peopleFrom(payload) {
      if (payload && payload.group && payload.group.people) return payload.group.people;
      var cards = cardsFrom(payload);
      var byKey = {};
      cards.forEach(function (card, index) {
        var key = String(card.name || '').trim().toLowerCase();
        if (!key) return;
        if (!byKey[key]) {
          byKey[key] = {
            key: key,
            name: card.name,
            stalls: [],
            offers: [],
            neighborKeys: [],
            x: 22 + (index * 17) % 60,
            y: 28 + (index * 11) % 48,
            cluster: 0,
          };
        }
        if (card.kind === 'offer') {
          byKey[key].offers.push({
            id: card.id,
            hookId: card.hookId,
            forName: card.forName,
            place: card.place,
            note: card.note,
            at: card.at,
          });
        } else {
          byKey[key].stalls.push({
            id: card.id,
            place: card.place,
            note: card.note,
            at: card.at,
            offerCount: card.offerCount,
          });
        }
      });
      return Object.keys(byKey).map(function (key) {
        return byKey[key];
      });
    }

    function writeTarget(person) {
      if (person.stalls && person.stalls[0]) return person.stalls[0].id;
      if (person.offers && person.offers[0]) return person.offers[0].hookId;
      return '';
    }

    function floatOpen(person) {
      if (!openBox || !person) return;
      openBox.style.left = person.x + '%';
      openBox.style.top = person.y + '%';
      openBox.style.setProperty('--nudge-x', '0px');
      openBox.style.setProperty('--nudge-y', '0px');
      openBox.classList.toggle('is-left', Number(person.x) >= 55);
      openBox.classList.toggle('is-below', Number(person.y) < 36);
      requestAnimationFrame(function () {
        if (!roomBox || openBox.hidden) return;
        var room = roomBox.getBoundingClientRect();
        var card = openBox.getBoundingClientRect();
        var pad = 12;
        var dx = 0;
        var dy = 0;
        if (card.right > room.right - pad) dx -= card.right - (room.right - pad);
        if (card.left < room.left + pad) dx += room.left + pad - card.left;
        if (card.bottom > room.bottom - pad) dy -= card.bottom - (room.bottom - pad);
        if (card.top < room.top + pad) dy += room.top + pad - card.top;
        openBox.style.setProperty('--nudge-x', dx + 'px');
        openBox.style.setProperty('--nudge-y', dy + 'px');
      });
    }

    function renderOpen(person) {
      if (!openBox) return;
      if (!person) {
        openBox.hidden = true;
        openBox.innerHTML = '';
        openBox.removeAttribute('style');
        openBox.classList.remove('is-left', 'is-below');
        return;
      }
      var hookId = writeTarget(person);
      var remove =
        canModerate && person.stalls && person.stalls[0]
          ? '<button type="button" class="hook-remove" data-remove="' +
            esc(person.stalls[0].id) +
            '">Take down</button>'
          : '';
      var stalls = (person.stalls || [])
        .map(function (stall) {
          return (
            '<article class="open-bit">' +
            '<p class="card-kind">Stall</p>' +
            '<p class="hook-place">' +
            esc(stall.place) +
            '</p>' +
            '<p class="hook-note">' +
            esc(stall.note) +
            '</p>' +
            '</article>'
          );
        })
        .join('');
      var offers = (person.offers || [])
        .map(function (offer) {
          return (
            '<article class="open-bit">' +
            '<p class="card-kind">Offer</p>' +
            '<p class="card-for">for ' +
            esc(offer.forName) +
            '</p>' +
            '<p class="hook-note">' +
            esc(offer.note) +
            '</p>' +
            '</article>'
          );
        })
        .join('');
      var near = (person.neighborKeys || [])
        .map(function (key) {
          var other = peopleFrom(lastPayload).find(function (row) {
            return row.key === key;
          });
          return other ? '<button type="button" class="near-name" data-open="' + esc(other.key) + '">' + esc(other.name) + '</button>' : '';
        })
        .filter(Boolean)
        .join('');
      openBox.hidden = false;
      openBox.innerHTML =
        '<div class="open-head">' +
        '<p class="card-kind">Opened</p>' +
        '<h2 class="hook-name">' +
        esc(person.name) +
        '</h2>' +
        (near ? '<p class="open-near">Standing with ' + near + '</p>' : '') +
        '<button type="button" class="open-close" data-close="1">Close</button>' +
        '</div>' +
        (stalls || offers ? stalls + offers : '<p class="hook-note">Nothing pinned yet.</p>') +
        (hookId
          ? '<button type="button" class="btn btn-ghost hook-write" data-write="' +
            esc(hookId) +
            '">Make an offer</button>' +
            remove +
            writeForm(hookId)
          : '');
      floatOpen(person);
    }

    function renderGroup(payload) {
      if (!dotsBox) return;
      var people = peopleFrom(payload);
      writeCrowdSign(people.length);
      if (countBox) {
        countBox.textContent = people.length
          ? people.length === 1
            ? '· 1 standing'
            : '· ' + people.length + ' standing'
          : '';
      }
      if (!people.length) {
        dotsBox.className = 'group-dots';
        dotsBox.innerHTML = '<p class="group-empty">No one standing here yet.</p>';
        if (linksBox) linksBox.innerHTML = '';
        renderOpen(null);
        return;
      }
      dotsBox.className =
        'group-dots' + (people.length > 200 ? ' is-pack' : people.length > 40 ? ' is-crowd' : '');
      var byKey = {};
      people.forEach(function (person) {
        byKey[person.key] = person;
      });
      var selected = byKey[openKey] || null;
      if (openKey && !selected) openKey = '';
      var near = {};
      if (selected) {
        (selected.neighborKeys || []).forEach(function (key) {
          near[key] = true;
        });
      }
      var lines = [];
      var seen = {};
      var drawAll = people.length < 80;
      people.forEach(function (person) {
        if (!drawAll && (!selected || (person.key !== selected.key && !near[person.key]))) return;
        (person.neighborKeys || []).forEach(function (key) {
          var edge = person.key < key ? person.key + '|' + key : key + '|' + person.key;
          if (seen[edge]) return;
          seen[edge] = true;
          var other = byKey[key];
          if (!other) return;
          var hot = selected && (person.key === selected.key || other.key === selected.key);
          if (!drawAll && !hot) return;
          lines.push(
            '<line x1="' +
              person.x +
              '" y1="' +
              person.y +
              '" x2="' +
              other.x +
              '" y2="' +
              other.y +
              '" class="' +
              (hot ? 'is-hot' : '') +
              '" />',
          );
        });
      });
      if (linksBox) linksBox.innerHTML = lines.join('');
      dotsBox.innerHTML = people
        .map(function (person) {
          var host = person.stalls && person.stalls.length;
          var state = person.key === openKey ? ' is-open' : near[person.key] ? ' is-near' : '';
          return (
            '<button type="button" class="dot' +
            (host ? ' is-host' : '') +
            state +
            '" style="left:' +
            person.x +
            '%;top:' +
            person.y +
            '%" data-open="' +
            esc(person.key) +
            '" aria-pressed="' +
            (person.key === openKey ? 'true' : 'false') +
            '" aria-label="' +
            esc(person.name) +
            '">' +
            '<span class="dot-mark"></span>' +
            '<span class="dot-name">' +
            esc(person.name) +
            '</span>' +
            '</button>'
          );
        })
        .join('');
      renderOpen(selected || null);
    }

    function render(payload) {
      if (payload && payload.ok && !payload.hooks && !payload.market && !payload.group) {
        load();
        return;
      }
      lastPayload = payload || lastPayload;
      renderGroup(lastPayload);
      if (!list) return;
      var cards = cardsFrom(lastPayload);
      if (!cards.length) {
        list.innerHTML = '<li class="empty">The market is empty. Open the first stall.</li>';
        return;
      }
      list.innerHTML = cards.map(renderCard).join('');
    }

    function openPerson(key) {
      openKey = openKey === key ? '' : key;
      render(lastPayload);
    }

    function load() {
      fetch('/api/hooks', { headers: { accept: 'application/json' } })
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          canModerate = !!(data && data.canModerate);
          if (hintBox && data && data.mailWired === false) {
            hintBox.hidden = false;
            hintBox.textContent =
              'Mail is not wired yet. Offers still show on the floor.';
          }
          render(data);
        })
        .catch(function () {
          writeCrowdSign(0);
          showError('The board could not load just now.');
        });
    }

    if (pinForm) {
      pinForm.addEventListener('submit', function (event) {
        event.preventDefault();
        hideError();
        var data = new FormData(pinForm);
        var button = pinForm.querySelector('button[type="submit"]');
        if (button) button.disabled = true;
        fetch('/api/hooks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: String(data.get('name') || '').trim(),
            place: String(data.get('place') || '').trim(),
            note: String(data.get('note') || '').trim(),
            email: String(data.get('email') || '').trim(),
            company: String(data.get('fax_number_leave_blank') || data.get('company') || '').trim(),
          }),
        })
          .then(function (res) {
            return res.json().then(function (body) {
              return { res: res, body: body };
            });
          })
          .then(function (out) {
            if (out.res.ok && out.body.ok) {
              pinForm.hidden = true;
              if (pinSuccess) pinSuccess.hidden = false;
              render(out.body);
              return;
            }
            showError((out.body && out.body.error) || 'Could not pin that just now.');
          })
          .catch(function () {
            showError('Could not pin that just now.');
          })
          .finally(function () {
            if (button) button.disabled = false;
          });
      });
    }

    if (list) {
      list.addEventListener('click', function (event) {
        var write = event.target.closest('[data-write]');
        if (write) {
          var card = write.closest('.card');
          var form = card && card.querySelector('[data-for="' + write.getAttribute('data-write') + '"]');
          if (form) form.hidden = !form.hidden;
          return;
        }
        var remove = event.target.closest('[data-remove]');
        if (!remove) return;
        hideError();
        fetch('/api/hooks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'remove', id: remove.getAttribute('data-remove') }),
        })
          .then(function (res) {
            return res.json();
          })
          .then(function (body) {
            if (body && body.ok) {
              render(body);
              return;
            }
            showError((body && body.error) || 'Could not take that down.');
          })
          .catch(function () {
            showError('Could not take that down.');
          });
      });

      list.addEventListener('submit', function (event) {
        var form = event.target.closest('.write-form');
        if (!form) return;
        event.preventDefault();
        hideError();
        var data = new FormData(form);
        var button = form.querySelector('button[type="submit"]');
        if (button) button.disabled = true;
        fetch('/api/hooks/write', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            hookId: form.getAttribute('data-for'),
            name: String(data.get('name') || '').trim(),
            email: String(data.get('email') || '').trim(),
            message: String(data.get('message') || '').trim(),
            company: String(data.get('fax_number_leave_blank') || data.get('company') || '').trim(),
          }),
        })
          .then(function (res) {
            return res.json().then(function (body) {
              return { res: res, body: body };
            });
          })
          .then(function (out) {
            if (out.res.ok && out.body.ok) {
              form.hidden = true;
              form.reset();
              render(out.body);
              return;
            }
            showError((out.body && out.body.error) || 'Could not leave that offer.');
          })
          .catch(function () {
            showError('Could not leave that offer.');
          })
          .finally(function () {
            if (button) button.disabled = false;
          });
      });
    }

    var group = document.getElementById('group');
    if (group) {
      group.addEventListener('click', function (event) {
        var close = event.target.closest('[data-close]');
        if (close) {
          openKey = '';
          render(lastPayload);
          return;
        }
        var pick = event.target.closest('[data-open]');
        if (pick) {
          openPerson(pick.getAttribute('data-open'));
          return;
        }
        var write = event.target.closest('[data-write]');
        if (write && openBox) {
          var form = openBox.querySelector('[data-for="' + write.getAttribute('data-write') + '"]');
          if (form) form.hidden = !form.hidden;
          var opened = peopleFrom(lastPayload).find(function (row) {
            return row.key === openKey;
          });
          if (opened) floatOpen(opened);
          return;
        }
        var remove = event.target.closest('[data-remove]');
        if (!remove) return;
        hideError();
        fetch('/api/hooks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'remove', id: remove.getAttribute('data-remove') }),
        })
          .then(function (res) {
            return res.json();
          })
          .then(function (body) {
            if (body && body.ok) {
              openKey = '';
              render(body);
              return;
            }
            showError((body && body.error) || 'Could not take that down.');
          })
          .catch(function () {
            showError('Could not take that down.');
          });
      });

      group.addEventListener('submit', function (event) {
        var form = event.target.closest('.write-form');
        if (!form) return;
        event.preventDefault();
        hideError();
        var data = new FormData(form);
        var button = form.querySelector('button[type="submit"]');
        if (button) button.disabled = true;
        fetch('/api/hooks/write', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            hookId: form.getAttribute('data-for'),
            name: String(data.get('name') || '').trim(),
            email: String(data.get('email') || '').trim(),
            message: String(data.get('message') || '').trim(),
            company: String(data.get('fax_number_leave_blank') || data.get('company') || '').trim(),
          }),
        })
          .then(function (res) {
            return res.json().then(function (body) {
              return { res: res, body: body };
            });
          })
          .then(function (out) {
            if (out.res.ok && out.body.ok) {
              form.hidden = true;
              form.reset();
              render(out.body);
              return;
            }
            showError((out.body && out.body.error) || 'Could not leave that offer.');
          })
          .catch(function () {
            showError('Could not leave that offer.');
          })
          .finally(function () {
            if (button) button.disabled = false;
          });
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && openKey) {
        openKey = '';
        render(lastPayload);
      }
    });

    load();
  })();
</script>

