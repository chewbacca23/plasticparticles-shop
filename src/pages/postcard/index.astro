---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostcardMarks from '../../components/PostcardMarks.astro';
import { existingMedia, galleryMedia } from '../../lib/media';
import { newestFirst } from '../../lib/newest';
import { site } from '../../site.config';

const stories = await getCollection('stories', ({ data }) => !data.draft);
const weeks = await getCollection('week', ({ data }) => !data.draft);

const cards = newestFirst(
  [
    ...stories.map((story) => ({
      id: story.id,
      date: story.data.pubDate,
      title: story.data.headline,
      cover: galleryMedia(story.data.cover, story.data.gallery)[0] || '',
    })),
    ...weeks.map((entry) => ({
      id: entry.id,
      date: entry.data.pubDate,
      title: entry.data.title,
      cover: existingMedia(entry.data.photos)[0] || '',
    })),
  ],
  (card) => card.date,
);

const wall = newestFirst(
  await getCollection('postcardWall', ({ data }) => !data.draft),
  (entry) => entry.data.sentAt,
);

const wallDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  timeZone: 'Europe/Berlin',
});
---

<BaseLayout
  title="Postcards"
  description="A postcard from each Soul Searchers ride. The crest is on every picture. Send one to someone who loves the road."
>
  <section class="section">
    <div class="site-shell">
      <p class="eyebrow">Postcards</p>
      <h1 class="section-title">From the ride</h1>
      <p class="section-lead">
        One postcard for each ride. A few words, up to twenty pictures, and the crest on every one.<br />
        Send it to someone who loves the road.<br />
        <a href="/#become-a-member">Become a free member</a>. Add your email on the list. Still free of charge.
      </p>

      {
        wall.length > 0 ? (
          <section class="wall" aria-labelledby="wall-title">
            <p class="wall-kicker">The wall</p>
            <h2 id="wall-title" class="wall-title">Postcards on the move</h2>
            <p class="wall-lead">
              First names only. A quiet tick when someone sends a ride to a friend.
            </p>
            <ol class="wall-list">
              {wall.map((entry) => (
                <li class="wall-card">
                  <p class="wall-when">
                    <time datetime={entry.data.sentAt.toISOString().slice(0, 10)}>
                      {wallDate.format(entry.data.sentAt)}
                    </time>
                  </p>
                  <p class="wall-who">{entry.data.who}</p>
                  <p class="wall-ride">
                    sent{' '}
                    <a href={`/postcard/${entry.data.rideSlug}`}>{entry.data.rideTitle}</a>
                  </p>
                  {entry.data.line ? <p class="wall-line">{entry.data.line}</p> : null}
                </li>
              ))}
            </ol>
          </section>
        ) : null
      }

      {
        cards.length === 0 ? (
          <p>Postcards show here when a ride is ready to send.</p>
        ) : (
          <div class="grid">
            {cards.map((card, index) => (
              <a class="tile" href={`/postcard/${card.id}`}>
                <span class="frame">
                  {card.cover ? (
                    <span class="window">
                      <img
                        class="shot"
                        src={card.cover}
                        alt=""
                        width="800"
                        height="1000"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                        sizes="(max-width: 640px) 92vw, 400px"
                      />
                      <PostcardMarks variant={index} />
                    </span>
                    <span class="keep" aria-hidden="true"></span>
                  ) : (
                    <span class="awaiting">
                      <img src={site.logo} alt="" width="56" height="71" loading="lazy" />
                      <span>Crest only</span>
                    </span>
                  )}
                </span>
                <h2>{card.title}</h2>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .wall {
    margin: 0 0 2.75rem;
    padding: 1.35rem 1.4rem 1.5rem;
    border: 1px solid rgba(212, 163, 90, 0.22);
    border-radius: 1.1rem;
    background:
      radial-gradient(ellipse 70% 80% at 10% 0%, rgba(212, 163, 90, 0.1), transparent 55%),
      rgba(18, 26, 34, 0.45);
  }

  .wall-kicker {
    margin: 0 0 0.35rem;
    color: var(--amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .wall-title {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--paper);
  }

  .wall-lead {
    margin: 0 0 1.15rem;
    color: rgba(215, 224, 232, 0.72);
    max-width: 32rem;
  }

  .wall-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .wall-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .wall-card {
    padding: 0.9rem 1rem;
    border: 1px solid rgba(215, 224, 232, 0.1);
    border-radius: 0.75rem;
    background: rgba(10, 14, 20, 0.35);
  }

  .wall-when {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .wall-who {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--paper);
  }

  .wall-ride {
    margin: 0.2rem 0 0;
    color: rgba(215, 224, 232, 0.78);
    font-size: 0.95rem;
  }

  .wall-ride a {
    color: var(--amber-hot);
    text-decoration: none;
  }

  .wall-ride a:hover {
    text-decoration: underline;
  }

  .wall-line {
    margin: 0.45rem 0 0;
    color: rgba(215, 224, 232, 0.68);
    font-size: 0.92rem;
  }

  .grid {
    display: grid;
    gap: 1.75rem 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .tile {
    display: grid;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }

  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    padding: 0.55rem;
    background: #f4f1ea;
    border: 3px solid #111;
    box-shadow: 8px 8px 0 #111;
  }

  .window {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 3px solid #111;
  }

  .keep {
    position: absolute;
    inset: 0;
    z-index: 4;
    -webkit-touch-callout: none;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .shot {
    filter: contrast(1.08) saturate(0.9);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tile:hover .shot {
    transform: scale(1.04);
  }

  .awaiting {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    width: 100%;
    height: 100%;
    background: #f6efe2;
  }

  .awaiting img {
    width: 3.5rem;
    height: auto;
    transition: none;
  }

  .awaiting span {
    color: #8a5a12;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tile h2 {
    margin: 0;
    color: #111;
    font-family: Figtree, system-ui, sans-serif;
    font-size: 1.2rem;
    font-weight: 760;
    letter-spacing: -0.03em;
  }
</style>

<script is:inline>
  document.addEventListener('contextmenu', function (event) {
    var node = event.target;
    if (node && node.closest && node.closest('.frame')) event.preventDefault();
  });
  document.addEventListener('dragstart', function (event) {
    var node = event.target;
    if (node && node.closest && node.closest('.frame')) event.preventDefault();
  });
</script>
