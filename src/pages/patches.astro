---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import saved from '../content/settings/patches.json';
import { mediaExists } from '../lib/media';

const PATCH_MAIL = 'henrik@thenewsoulsearchers.de';
const mailto = `mailto:${PATCH_MAIL}?subject=${encodeURIComponent('Patch')}`;

const headline = (saved.headline || 'Handmade crest patches').trim();
const blurb = (
  saved.blurb ||
  'The Soul Searchers crest, stitched by hand. If you want one, drop Henrik an email.'
).trim();
const photo = mediaExists(saved.photo) ? saved.photo : site.logo;
const usingCrestFallback = !mediaExists(saved.photo);
---

<BaseLayout
  title="Patches"
  description="Handmade Soul Searchers crest patches. Drop Henrik an email if you want one."
>
  <section class="section">
    <div class="site-shell patches">
      <p class="eyebrow">Patches</p>
      <h1 class="section-title">{headline}</h1>
      <p class="section-lead">{blurb}</p>

      <figure class="patch-figure">
        <img
          class:list={['patch-photo', { 'patch-photo--crest': usingCrestFallback }]}
          src={photo}
          alt={usingCrestFallback ? 'The Soul Searchers crest' : 'Handmade Soul Searchers crest patch'}
          width="800"
          height="800"
          decoding="async"
        />
        {
          usingCrestFallback ? (
            <figcaption class="patch-caption">
              Crest for now — swap in a photo of the real patch in the editor under Site → Patches.
            </figcaption>
          ) : null
        }
      </figure>

      <div class="cta-row">
        <a class="btn btn-primary" href={mailto}>Email Henrik for a patch</a>
        <a class="btn btn-ghost" href={`mailto:${PATCH_MAIL}`}>{PATCH_MAIL}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .patches {
    max-width: 40rem;
  }

  .patch-figure {
    margin: 2rem 0 0;
  }

  .patch-photo {
    display: block;
    width: min(100%, 28rem);
    height: auto;
    border: 1px solid rgba(215, 224, 232, 0.12);
    background: rgba(238, 243, 247, 0.03);
  }

  .patch-photo--crest {
    width: min(100%, 14rem);
    padding: 1.5rem;
    background: radial-gradient(circle at 30% 25%, rgba(240, 194, 122, 0.12), transparent 60%),
      rgba(238, 243, 247, 0.03);
  }

  .patch-caption {
    margin: 0.75rem 0 0;
    color: rgba(215, 224, 232, 0.55);
    font-size: 0.9rem;
    max-width: 28rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
</style>
