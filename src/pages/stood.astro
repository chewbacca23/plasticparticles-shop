---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveStoodCoords } from '../lib/stood-geocode';

/** Equirectangular fit for Natural Earth land (public domain) in world.svg. */
function pinPercent(lat: number, lng: number) {
  return {
    left: Math.min(98, Math.max(2, ((lng + 180) / 360) * 100)),
    top: Math.min(96, Math.max(4, ((90 - lat) / 180) * 100)),
  };
}

const places = (await getCollection('stood', ({ data }) => !data.draft)).sort((a, b) => {
  const aTime = a.data.stoodAt ? a.data.stoodAt.getTime() : 0;
  const bTime = b.data.stoodAt ? b.data.stoodAt.getTime() : 0;
  if (bTime !== aTime) return bTime - aTime;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const resolved = await Promise.all(
  places.map(async (entry) => {
    const coords = await resolveStoodCoords({
      place: entry.data.place,
      lat: entry.data.lat,
      lng: entry.data.lng,
    });
    const when = entry.data.stoodAt
      ? new Intl.DateTimeFormat('en-GB', {
          month: 'short',
          year: 'numeric',
          timeZone: 'Europe/Berlin',
        }).format(entry.data.stoodAt)
      : '';
    return {
      id: entry.id,
      place: entry.data.place,
      note: entry.data.note,
      href: entry.data.href,
      when,
      coords,
      pin: coords ? pinPercent(coords.lat, coords.lng) : null,
    };
  }),
);

const pins = resolved.filter((row) => row.pin);
---

<BaseLayout
  title="Where I stood"
  description="A quiet trail of places The Soul Searchers have been — soft pins on the map, brother to brother."
  watermark={false}
>
  <section class="section stood">
    <div class="site-shell stood-copy">
      <p class="eyebrow reveal">The trail</p>
      <h1 class="section-title reveal reveal-delay-1">Where I stood</h1>
      <p class="section-lead reveal reveal-delay-2">
        Type a place name in the editor — we put the pin on the map. Tap a town on the right or a
        pin on the map. Brother to brother.
      </p>

      <div class="stood-board reveal reveal-delay-3">
        <div class="map-frame" aria-label="Map of places I stood">
          <img
            class="map-world"
            src="/stood/world.svg"
            alt=""
            width="1000"
            height="500"
            decoding="async"
          />
          <ul class="map-pins">
            {
              pins.map((pin) => (
                <li class="map-pin" style={`left: ${pin.pin!.left}%; top: ${pin.pin!.top}%;`}>
                  {pin.href ? (
                    <a
                      class="map-pin-hit"
                      href={pin.href}
                      title={pin.place}
                      aria-label={`${pin.place}${pin.note ? `. ${pin.note}` : ''}`}
                    >
                      <span class="map-pin-dot" aria-hidden="true"></span>
                      <span class="map-pin-label">
                        <strong>{pin.place}</strong>
                        {pin.when ? <span class="map-pin-when">{pin.when}</span> : null}
                      </span>
                    </a>
                  ) : (
                    <span class="map-pin-hit map-pin-hit--plain" title={pin.place}>
                      <span class="map-pin-dot" aria-hidden="true"></span>
                      <span class="map-pin-label">
                        <strong>{pin.place}</strong>
                        {pin.when ? <span class="map-pin-when">{pin.when}</span> : null}
                      </span>
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <aside class="stood-side" aria-label="Places I have been">
          <p class="stood-side-kicker">Places</p>
          {
            resolved.length === 0 ? (
              <p class="empty">
                Add a place in the editor under <strong>Where I stood</strong> — just the name. We
                drop the pin.
              </p>
            ) : (
              <ol class="stood-list">
                {resolved.map((entry) => (
                  <li class="stood-item">
                    {entry.href ? (
                      <a class="stood-link" href={entry.href}>
                        <span class="stood-place">{entry.place}</span>
                        {entry.when ? <span class="stood-when">{entry.when}</span> : null}
                        {entry.note ? <span class="stood-note">{entry.note}</span> : null}
                        {!entry.pin ? (
                          <span class="stood-miss">Name saved — pin needs a clearer place name.</span>
                        ) : null}
                      </a>
                    ) : (
                      <div class="stood-link stood-link--plain">
                        <span class="stood-place">{entry.place}</span>
                        {entry.when ? <span class="stood-when">{entry.when}</span> : null}
                        {entry.note ? <span class="stood-note">{entry.note}</span> : null}
                        {!entry.pin ? (
                          <span class="stood-miss">Name saved — pin needs a clearer place name.</span>
                        ) : null}
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            )
          }
        </aside>
      </div>

      <p class="stood-credit">
        World map is free — Natural Earth, public domain. Place names find pins via OpenStreetMap
        Nominatim (free, no key). No Carto.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .stood {
    position: relative;
    padding-bottom: 3.5rem;
    min-height: calc(100vh - 4.25rem);
  }

  .stood-copy {
    position: relative;
    z-index: 1;
  }

  .stood-credit {
    margin: 2rem 0 0;
    color: rgba(215, 224, 232, 0.45);
    font-size: 0.78rem;
  }

  .stood-board {
    display: grid;
    gap: 1.25rem;
    margin: 1.75rem 0 0;
    align-items: start;
  }

  @media (min-width: 900px) {
    .stood-board {
      grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.9fr);
      gap: 1.35rem;
    }
  }

  .map-frame {
    position: relative;
    border: 1px solid rgba(215, 224, 232, 0.12);
    border-radius: 1rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 70% at 50% 45%, rgba(30, 58, 69, 0.55), rgba(12, 18, 24, 0.96));
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    aspect-ratio: 2 / 1;
    min-height: 14rem;
  }

  .map-world {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    opacity: 0.48;
    filter: saturate(0.75) brightness(1.05);
    pointer-events: none;
    user-select: none;
  }

  .map-pins {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .map-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 2;
    pointer-events: auto;
  }

  .map-pin-hit {
    position: relative;
    display: block;
    width: 0.78rem;
    height: 0.78rem;
    text-decoration: none;
    color: inherit;
  }

  .map-pin-hit--plain {
    cursor: default;
  }

  .map-pin-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    margin: 0.12rem auto 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f0c27a, #d4a35a 55%, #8a5a28);
    box-shadow:
      0 0 0 2px rgba(12, 18, 24, 0.85),
      0 0 10px rgba(240, 194, 122, 0.45);
    transition: transform 0.2s ease;
  }

  .map-pin-hit:hover .map-pin-dot,
  .map-pin-hit:focus-visible .map-pin-dot {
    transform: scale(1.25);
  }

  .map-pin-label {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.45rem);
    transform: translateX(-50%) translateY(0.25rem);
    min-width: max-content;
    max-width: 11rem;
    padding: 0.45rem 0.65rem;
    border-radius: 0.65rem;
    background: rgba(12, 18, 24, 0.92);
    border: 1px solid rgba(215, 224, 232, 0.14);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .map-pin-hit:hover .map-pin-label,
  .map-pin-hit:focus-visible .map-pin-label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .map-pin-label strong {
    display: block;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .map-pin-when {
    display: block;
    margin-top: 0.15rem;
    color: var(--amber-hot);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stood-side {
    border: 1px solid rgba(215, 224, 232, 0.1);
    border-radius: 1rem;
    background: rgba(18, 26, 34, 0.45);
    padding: 1rem 1rem 1.1rem;
    max-height: min(68vh, 34rem);
    overflow: auto;
  }

  .stood-side-kicker {
    margin: 0 0 0.75rem;
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .stood-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .stood-item {
    margin: 0;
  }

  .stood-link {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid rgba(215, 224, 232, 0.1);
    border-radius: 0.85rem;
    background: rgba(12, 18, 24, 0.35);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .stood-link:hover {
    border-color: rgba(240, 194, 122, 0.35);
    background: rgba(30, 58, 69, 0.35);
    color: inherit;
  }

  .stood-link--plain {
    cursor: default;
  }

  .stood-place {
    font-family: var(--font-display);
    font-size: 1.08rem;
    color: var(--paper);
  }

  .stood-when {
    color: var(--amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stood-note {
    color: rgba(215, 224, 232, 0.78);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .stood-miss {
    color: rgba(240, 194, 122, 0.75);
    font-size: 0.8rem;
  }

  .empty {
    color: rgba(215, 224, 232, 0.72);
    margin: 0;
  }

  @media (max-width: 640px) {
    .map-pin-label {
      max-width: 9rem;
      font-size: 0.85rem;
    }

    .stood-side {
      max-height: none;
    }
  }
</style>
