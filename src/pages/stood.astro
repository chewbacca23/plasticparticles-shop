---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveStoodCoords } from '../lib/stood-geocode';

/** Equirectangular fit for Natural Earth land (public domain) in world.svg. */
function pinPercent(lat: number, lng: number) {
  return {
    left: Math.min(98, Math.max(2, ((lng + 180) / 360) * 100)),
    top: Math.min(96, Math.max(4, ((90 - lat) / 180) * 100)),
  };
}

const places = (await getCollection('stood', ({ data }) => !data.draft)).sort((a, b) => {
  const aTime = a.data.stoodAt ? a.data.stoodAt.getTime() : 0;
  const bTime = b.data.stoodAt ? b.data.stoodAt.getTime() : 0;
  if (bTime !== aTime) return bTime - aTime;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const resolved = await Promise.all(
  places.map(async (entry) => {
    const coords = await resolveStoodCoords({
      place: entry.data.place,
      lat: entry.data.lat,
      lng: entry.data.lng,
    });
    const when = entry.data.stoodAt
      ? new Intl.DateTimeFormat('en-GB', {
          month: 'short',
          year: 'numeric',
          timeZone: 'Europe/Berlin',
        }).format(entry.data.stoodAt)
      : '';
    return {
      id: entry.id,
      place: entry.data.place,
      note: entry.data.note,
      detail: '',
      href: entry.data.href,
      when,
      coords,
      pin: coords ? pinPercent(coords.lat, coords.lng) : null,
    };
  }),
);

const pins = resolved.filter((row) => row.pin);
---

<BaseLayout
  title="Where I stood"
  description="A quiet trail of places The Soul Searchers have been — soft pins on the map, brother to brother."
  watermark={false}
>
  <section class="section stood">
    <div class="site-shell stood-copy">
      <p class="eyebrow reveal">The trail</p>
      <h1 class="section-title reveal reveal-delay-1">Where I stood</h1>
      <p class="section-lead reveal reveal-delay-2">
        Add a place on the right — name, when you were there, and two short lines. We drop the pin.
        Brother to brother.
      </p>

      <div class="stood-board reveal reveal-delay-3">
        <div class="map-frame" aria-label="Map of places I stood">
          <img
            class="map-world"
            src="/stood/world.svg"
            alt=""
            width="1000"
            height="500"
            decoding="async"
          />
          <ul class="map-pins" data-stood-pins>
            {
              pins.map((pin) => (
                <li
                  class="map-pin"
                  data-stood-id={pin.id}
                  style={`left: ${pin.pin!.left}%; top: ${pin.pin!.top}%;`}
                >
                  {pin.href ? (
                    <a
                      class="map-pin-hit"
                      href={pin.href}
                      title={pin.place}
                      aria-label={`${pin.place}${pin.note ? `. ${pin.note}` : ''}`}
                    >
                      <span class="map-pin-dot" aria-hidden="true"></span>
                      <span class="map-pin-label">
                        <strong>{pin.place}</strong>
                        {pin.when ? <span class="map-pin-when">{pin.when}</span> : null}
                      </span>
                    </a>
                  ) : (
                    <span class="map-pin-hit map-pin-hit--plain" title={pin.place}>
                      <span class="map-pin-dot" aria-hidden="true"></span>
                      <span class="map-pin-label">
                        <strong>{pin.place}</strong>
                        {pin.when ? <span class="map-pin-when">{pin.when}</span> : null}
                      </span>
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <aside class="stood-side" aria-label="Places I have been">
          <p class="stood-side-kicker">Add a place</p>
          <form class="stood-form" data-stood-form>
            <label class="stood-field">
              <span>Where I was</span>
              <input type="text" name="place" maxlength="120" required placeholder="Mallorca" autocomplete="off" />
            </label>
            <label class="stood-field">
              <span>When I was there</span>
              <input
                type="text"
                name="when"
                maxlength="80"
                placeholder="2008 – 2015"
                autocomplete="off"
              />
            </label>
            <label class="stood-field">
              <span>A line</span>
              <input type="text" name="note" maxlength="280" placeholder="Salt air, long climbs." autocomplete="off" />
            </label>
            <label class="stood-field">
              <span>Another line</span>
              <input type="text" name="detail" maxlength="280" placeholder="With mates from the road." autocomplete="off" />
            </label>
            <label class="stood-honey" aria-hidden="true">
              <span>Website</span>
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <p class="stood-status" data-stood-status hidden></p>
            <button class="btn btn-primary" type="submit">Put it on the map</button>
          </form>

          <p class="stood-side-kicker stood-side-kicker--list">Places</p>
          <ol class="stood-list" data-stood-list>
            {
              resolved.length === 0 ? (
                <li class="stood-item stood-item--empty">
                  <p class="empty">No places yet. Add one above — we drop the pin.</p>
                </li>
              ) : (
                resolved.map((entry) => (
                  <li class="stood-item" data-stood-id={entry.id}>
                    {entry.href ? (
                      <a class="stood-link" href={entry.href}>
                        <span class="stood-place">{entry.place}</span>
                        {entry.when ? <span class="stood-when">{entry.when}</span> : null}
                        {entry.note ? <span class="stood-note">{entry.note}</span> : null}
                        {entry.detail ? <span class="stood-note">{entry.detail}</span> : null}
                        {!entry.pin ? (
                          <span class="stood-miss">Name saved — pin needs a clearer place name.</span>
                        ) : null}
                      </a>
                    ) : (
                      <div class="stood-link stood-link--plain">
                        <span class="stood-place">{entry.place}</span>
                        {entry.when ? <span class="stood-when">{entry.when}</span> : null}
                        {entry.note ? <span class="stood-note">{entry.note}</span> : null}
                        {entry.detail ? <span class="stood-note">{entry.detail}</span> : null}
                        {!entry.pin ? (
                          <span class="stood-miss">Name saved — pin needs a clearer place name.</span>
                        ) : null}
                      </div>
                    )}
                  </li>
                ))
              )
            }
          </ol>
        </aside>
      </div>

      <p class="stood-credit">
        World map is free — Natural Earth, public domain. Place names find pins via OpenStreetMap
        Nominatim (free, no key). No Carto.
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.querySelector('[data-stood-form]');
    var list = document.querySelector('[data-stood-list]');
    var pins = document.querySelector('[data-stood-pins]');
    var status = document.querySelector('[data-stood-status]');
    if (!form || !list || !pins) return;

    function pinPercent(lat, lng) {
      return {
        left: Math.min(98, Math.max(2, ((lng + 180) / 360) * 100)),
        top: Math.min(96, Math.max(4, ((90 - lat) / 180) * 100)),
      };
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function formatWhen(raw) {
      var text = String(raw || '').trim();
      if (!text) return '';
      // Single calendar day → short label. Ranges stay as typed (e.g. 2008 – 2015).
      if (/^\d{4}-\d{2}-\d{2}$/.test(text)) {
        var date = new Date(text + 'T12:00:00');
        if (!Number.isNaN(date.getTime())) {
          try {
            return new Intl.DateTimeFormat('en-GB', {
              month: 'short',
              year: 'numeric',
              timeZone: 'Europe/Berlin',
            }).format(date);
          } catch (_) {}
        }
      }
      return text;
    }

    function setStatus(text, tone) {
      if (!status) return;
      status.hidden = !text;
      status.textContent = text || '';
      status.setAttribute('data-tone', tone || '');
    }

    function listItemHtml(row) {
      var when = formatWhen(row.when || row.stoodAt || '');
      var miss =
        row.lat == null || row.lng == null
          ? '<span class="stood-miss">Name saved — pin needs a clearer place name.</span>'
          : '';
      return (
        '<li class="stood-item" data-stood-id="' +
        escapeHtml(row.id) +
        '"><div class="stood-link stood-link--plain">' +
        '<span class="stood-place">' +
        escapeHtml(row.place) +
        '</span>' +
        (when ? '<span class="stood-when">' + escapeHtml(when) + '</span>' : '') +
        (row.note ? '<span class="stood-note">' + escapeHtml(row.note) + '</span>' : '') +
        (row.detail ? '<span class="stood-note">' + escapeHtml(row.detail) + '</span>' : '') +
        miss +
        '</div></li>'
      );
    }

    function pinItemHtml(row) {
      if (row.lat == null || row.lng == null) return '';
      var pos = pinPercent(Number(row.lat), Number(row.lng));
      var when = formatWhen(row.when || '');
      return (
        '<li class="map-pin" data-stood-id="' +
        escapeHtml(row.id) +
        '" style="left:' +
        pos.left +
        '%;top:' +
        pos.top +
        '%;">' +
        '<span class="map-pin-hit map-pin-hit--plain" title="' +
        escapeHtml(row.place) +
        '">' +
        '<span class="map-pin-dot" aria-hidden="true"></span>' +
        '<span class="map-pin-label"><strong>' +
        escapeHtml(row.place) +
        '</strong>' +
        (when ? '<span class="map-pin-when">' + escapeHtml(when) + '</span>' : '') +
        '</span></span></li>'
      );
    }

    function mergeLivePlaces(places) {
      if (!Array.isArray(places) || !places.length) return;
      var empty = list.querySelector('.stood-item--empty');
      if (empty) empty.remove();
      places
        .slice()
        .reverse()
        .forEach(function (row) {
          if (!row || !row.id) return;
          if (!list.querySelector('[data-stood-id="' + row.id + '"]')) {
            list.insertAdjacentHTML('afterbegin', listItemHtml(row));
          }
          // Always drop a map dot when we have coordinates.
          var pinHtml = pinItemHtml(row);
          if (pinHtml && !pins.querySelector('[data-stood-id="' + row.id + '"]')) {
            pins.insertAdjacentHTML('beforeend', pinHtml);
          }
        });
    }

    function loadLive() {
      fetch('/api/stood-places', { credentials: 'same-origin' })
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          if (data && data.ok) mergeLivePlaces(data.places || []);
        })
        .catch(function () {});
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var fd = new FormData(form);
      var payload = {
        place: String(fd.get('place') || '').trim(),
        when: String(fd.get('when') || '').trim(),
        note: String(fd.get('note') || '').trim(),
        detail: String(fd.get('detail') || '').trim(),
        website: String(fd.get('website') || '').trim(),
      };
      var button = form.querySelector('button[type="submit"]');
      if (button) button.disabled = true;
      setStatus('Saving…', '');
      fetch('/api/stood-places', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (res) {
          return res.json().then(function (data) {
            return { res: res, data: data };
          });
        })
        .then(function (pack) {
          if (button) button.disabled = false;
          if (!pack.data || !pack.data.ok) {
            setStatus(
              (pack.data && pack.data.error) || 'Could not save that just now.',
              'bad',
            );
            return;
          }
          form.reset();
          setStatus('On the map.', 'ok');
          mergeLivePlaces([pack.data.place]);
        })
        .catch(function () {
          if (button) button.disabled = false;
          setStatus('Could not save that just now.', 'bad');
        });
    });

    loadLive();
  })();
</script>

<style>
  .stood {
    position: relative;
    padding-bottom: 3.5rem;
    min-height: calc(100vh - 4.25rem);
  }

  .stood-copy {
    position: relative;
    z-index: 1;
  }

  .stood-credit {
    margin: 2rem 0 0;
    color: rgba(215, 224, 232, 0.45);
    font-size: 0.78rem;
  }

  .stood-board {
    display: grid;
    gap: 1.25rem;
    margin: 1.75rem 0 0;
    align-items: start;
  }

  @media (min-width: 900px) {
    .stood-board {
      grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.9fr);
      gap: 1.35rem;
    }
  }

  .map-frame {
    position: relative;
    border: 1px solid rgba(215, 224, 232, 0.12);
    border-radius: 1rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 70% at 50% 45%, rgba(30, 58, 69, 0.55), rgba(12, 18, 24, 0.96));
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    aspect-ratio: 2 / 1;
    min-height: 14rem;
  }

  .map-world {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    opacity: 0.48;
    filter: saturate(0.75) brightness(1.05);
    pointer-events: none;
    user-select: none;
  }

  .map-pins {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  /* :global so dots added from the form still get styles (Astro scope otherwise hides them). */
  :global(.map-pin) {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 2;
    pointer-events: auto;
  }

  :global(.map-pin-hit) {
    position: relative;
    display: block;
    width: 0.7rem;
    height: 0.7rem;
    text-decoration: none;
    color: inherit;
  }

  :global(.map-pin-hit--plain) {
    cursor: default;
  }

  :global(.map-pin-dot) {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    margin: 0.1rem auto 0;
    border-radius: 50%;
    background: #f0c27a;
    box-shadow:
      0 0 0 2px rgba(12, 18, 24, 0.9),
      0 0 8px rgba(240, 194, 122, 0.55);
    transition: transform 0.2s ease;
  }

  :global(.map-pin-hit:hover .map-pin-dot),
  :global(.map-pin-hit:focus-visible .map-pin-dot) {
    transform: scale(1.3);
  }

  :global(.map-pin-label) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.45rem);
    transform: translateX(-50%) translateY(0.25rem);
    min-width: max-content;
    max-width: 11rem;
    padding: 0.45rem 0.65rem;
    border-radius: 0.65rem;
    background: rgba(12, 18, 24, 0.92);
    border: 1px solid rgba(215, 224, 232, 0.14);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  :global(.map-pin-hit:hover .map-pin-label),
  :global(.map-pin-hit:focus-visible .map-pin-label) {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  :global(.map-pin-label strong) {
    display: block;
    color: #eef3f7;
    font-family: Fraunces, Georgia, serif;
    font-size: 0.92rem;
    font-weight: 500;
  }

  :global(.map-pin-when) {
    display: block;
    margin-top: 0.15rem;
    color: #f0c27a;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stood-side {
    border: 1px solid rgba(215, 224, 232, 0.1);
    border-radius: 1rem;
    background: rgba(18, 26, 34, 0.45);
    padding: 1rem 1rem 1.1rem;
    max-height: min(68vh, 34rem);
    overflow: auto;
  }

  .stood-side-kicker {
    margin: 0 0 0.75rem;
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .stood-side-kicker--list {
    margin-top: 1.35rem;
  }

  .stood-form {
    display: grid;
    gap: 0.7rem;
  }

  .stood-field {
    display: grid;
    gap: 0.3rem;
  }

  .stood-field span {
    color: rgba(215, 224, 232, 0.72);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .stood-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(215, 224, 232, 0.14);
    border-radius: 0.7rem;
    background: rgba(12, 18, 24, 0.55);
    color: var(--paper);
    font: inherit;
  }

  .stood-field input:focus {
    outline: 1px solid rgba(240, 194, 122, 0.55);
    border-color: rgba(240, 194, 122, 0.45);
  }

  .stood-honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .stood-status {
    margin: 0;
    font-size: 0.88rem;
    color: rgba(215, 224, 232, 0.78);
  }

  .stood-status[data-tone='ok'] {
    color: var(--amber-hot);
  }

  .stood-status[data-tone='bad'] {
    color: #f0a27a;
  }

  .stood-form .btn {
    justify-self: start;
    margin-top: 0.15rem;
  }

  .stood-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  :global(.stood-item) {
    margin: 0;
  }

  :global(.stood-link) {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid rgba(215, 224, 232, 0.1);
    border-radius: 0.85rem;
    background: rgba(12, 18, 24, 0.35);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  :global(.stood-link:hover) {
    border-color: rgba(240, 194, 122, 0.35);
    background: rgba(30, 58, 69, 0.35);
    color: inherit;
  }

  :global(.stood-link--plain) {
    cursor: default;
  }

  :global(.stood-place) {
    font-family: Fraunces, Georgia, serif;
    font-size: 1.08rem;
    color: #eef3f7;
  }

  :global(.stood-when) {
    color: #d4a35a;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :global(.stood-note) {
    color: rgba(215, 224, 232, 0.78);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  :global(.stood-miss) {
    color: rgba(240, 194, 122, 0.75);
    font-size: 0.8rem;
  }

  .empty {
    color: rgba(215, 224, 232, 0.72);
    margin: 0;
  }

  @media (max-width: 640px) {
    .map-pin-label {
      max-width: 9rem;
      font-size: 0.85rem;
    }

    .stood-side {
      max-height: none;
    }
  }
</style>
