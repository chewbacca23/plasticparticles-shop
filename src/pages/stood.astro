---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveStoodCoords } from '../lib/stood-geocode';

/** Equirectangular fit for Natural Earth land (public domain) in world.svg. */
function pinPercent(lat: number, lng: number) {
  return {
    left: Math.min(98, Math.max(2, ((lng + 180) / 360) * 100)),
    top: Math.min(96, Math.max(4, ((90 - lat) / 180) * 100)),
  };
}

const places = (await getCollection('stood', ({ data }) => !data.draft)).sort((a, b) => {
  const aTime = a.data.stoodAt ? a.data.stoodAt.getTime() : 0;
  const bTime = b.data.stoodAt ? b.data.stoodAt.getTime() : 0;
  if (bTime !== aTime) return bTime - aTime;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const resolved = await Promise.all(
  places.map(async (entry) => {
    const coords = await resolveStoodCoords({
      place: entry.data.place,
      lat: entry.data.lat,
      lng: entry.data.lng,
    });
    const when = entry.data.stoodAt
      ? new Intl.DateTimeFormat('en-GB', {
          month: 'short',
          year: 'numeric',
          timeZone: 'Europe/Berlin',
        }).format(entry.data.stoodAt)
      : '';
    return {
      id: entry.id,
      place: entry.data.place,
      note: entry.data.note,
      detail: '',
      href: entry.data.href,
      when,
      coords,
      pin: coords ? pinPercent(coords.lat, coords.lng) : null,
    };
  }),
);

const pins = resolved.filter((row) => row.pin);
---

<BaseLayout
  title="Where I stood"
  description="A quiet trail of places The Soul Searchers have been. Soft pins on the map, brother to brother."
  watermark={false}
>
  <section class="section stood">
    <div class="site-shell stood-copy">
      <p class="eyebrow reveal">The trail</p>
      <h1 class="section-title reveal reveal-delay-1">Where I stood</h1>
      <p class="section-lead reveal reveal-delay-2">
        Add a place as a dot, or a whole ride as a thin line.<br />
        List the stops in order (Perth, then east to Melbourne). Take one off anytime, then add
        another. Zoom with the buttons or a drag. Brother to brother.
      </p>

      <div class="stood-board reveal reveal-delay-3">
        <div class="map-frame" data-stood-map aria-label="Map of places I stood">
          <div class="map-stage" data-stood-stage>
            <img
              class="map-world"
              src="/stood/world.svg"
              alt=""
              width="1000"
              height="500"
              decoding="async"
              draggable="false"
            />
            <svg
              class="map-routes"
              data-stood-routes
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
            ></svg>
            <ul class="map-pins" data-stood-pins>
              {
                pins.map((pin) => (
                  <li
                    class="map-pin"
                    data-stood-id={pin.id}
                    style={`left: ${pin.pin!.left}%; top: ${pin.pin!.top}%;`}
                  >
                    {pin.href ? (
                      <a
                        class="map-pin-hit"
                        href={pin.href}
                        title={pin.place}
                        aria-label={`${pin.place}${pin.note ? `. ${pin.note}` : ''}`}
                      >
                        <span class="map-pin-dot" aria-hidden="true"></span>
                        <span class="map-pin-label">
                          <strong>{pin.place}</strong>
                          {pin.when ? <span class="map-pin-when">{pin.when}</span> : null}
                        </span>
                      </a>
                    ) : (
                      <span class="map-pin-hit map-pin-hit--plain" title={pin.place}>
                        <span class="map-pin-dot" aria-hidden="true"></span>
                        <span class="map-pin-label">
                          <strong>{pin.place}</strong>
                          {pin.when ? <span class="map-pin-when">{pin.when}</span> : null}
                        </span>
                      </span>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="map-zoom" role="group" aria-label="Zoom the map">
            <button type="button" class="map-zoom-btn" data-zoom-in aria-label="Zoom in">+</button>
            <button type="button" class="map-zoom-btn" data-zoom-out aria-label="Zoom out">−</button>
            <button type="button" class="map-zoom-btn" data-zoom-reset aria-label="Reset zoom">⌂</button>
          </div>
        </div>

        <aside class="stood-side" aria-label="Places I have been">
          <p class="stood-side-kicker">Add a place</p>
          <form class="stood-form" data-stood-form>
            <label class="stood-field">
              <span>Where I was</span>
              <input type="text" name="place" maxlength="120" required placeholder="Mallorca" autocomplete="off" />
            </label>
            <label class="stood-field">
              <span>When I was there</span>
              <input
                type="text"
                name="when"
                maxlength="80"
                placeholder="2008-2015"
                autocomplete="off"
              />
            </label>
            <label class="stood-field">
              <span>A line</span>
              <input type="text" name="note" maxlength="280" placeholder="Salt air, long climbs." autocomplete="off" />
            </label>
            <label class="stood-field">
              <span>Another line</span>
              <input type="text" name="detail" maxlength="280" placeholder="With mates from the road." autocomplete="off" />
            </label>
            <label class="stood-honey" aria-hidden="true">
              <span>Website</span>
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <p class="stood-status" data-stood-status hidden></p>
            <button class="btn btn-primary" type="submit">Put it on the map</button>
          </form>

          <p class="stood-side-kicker stood-side-kicker--list">Add a ride line</p>
          <form class="stood-form" data-stood-route-form>
            <label class="stood-field">
              <span>Name of the ride</span>
              <input
                type="text"
                name="place"
                maxlength="120"
                required
                placeholder="Perth to Melbourne"
                autocomplete="off"
              />
            </label>
            <label class="stood-field">
              <span>The line: stops in order</span>
              <input
                type="text"
                name="path"
                maxlength="800"
                required
                placeholder="Perth, Esperance, Adelaide, Melbourne"
                autocomplete="off"
              />
            </label>
            <label class="stood-field">
              <span>When</span>
              <input type="text" name="when" maxlength="80" placeholder="2012" autocomplete="off" />
            </label>
            <label class="stood-field">
              <span>A line</span>
              <input
                type="text"
                name="note"
                maxlength="280"
                placeholder="First south, then east all the way."
                autocomplete="off"
              />
            </label>
            <label class="stood-field">
              <span>Another line</span>
              <input
                type="text"
                name="detail"
                maxlength="280"
                placeholder="Thin tyres, big sky."
                autocomplete="off"
              />
            </label>
            <label class="stood-honey" aria-hidden="true">
              <span>Website</span>
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
            <p class="stood-status" data-stood-route-status hidden></p>
            <button class="btn btn-primary" type="submit">Draw the line</button>
          </form>

          <p class="stood-side-kicker stood-side-kicker--list">Places</p>
          <ol class="stood-list" data-stood-list>
            {
              resolved.length === 0 ? (
                <li class="stood-item stood-item--empty">
                  <p class="empty">Places show here when you add one above. We drop the pin.</p>
                </li>
              ) : (
                resolved.map((entry) => (
                  <li class="stood-item" data-stood-id={entry.id}>
                    {entry.href ? (
                      <a class="stood-link" href={entry.href}>
                        <span class="stood-place">{entry.place}</span>
                        {entry.when ? <span class="stood-when">{entry.when}</span> : null}
                        {entry.note ? <span class="stood-note">{entry.note}</span> : null}
                        {entry.detail ? <span class="stood-note">{entry.detail}</span> : null}
                        {!entry.pin ? (
                          <span class="stood-miss">Name saved. Try a clearer place name for the pin.</span>
                        ) : null}
                      </a>
                    ) : (
                      <div class="stood-link stood-link--plain">
                        <span class="stood-place">{entry.place}</span>
                        {entry.when ? <span class="stood-when">{entry.when}</span> : null}
                        {entry.note ? <span class="stood-note">{entry.note}</span> : null}
                        {entry.detail ? <span class="stood-note">{entry.detail}</span> : null}
                        {!entry.pin ? (
                          <span class="stood-miss">Name saved. Try a clearer place name for the pin.</span>
                        ) : null}
                      </div>
                    )}
                  </li>
                ))
              )
            }
          </ol>

          <p class="stood-side-kicker stood-side-kicker--list">Ride lines</p>
          <ol class="stood-list" data-stood-route-list>
            <li class="stood-item stood-item--empty-routes">
              <p class="empty">Ride lines show here when you add stops in order above. We draw the thin line.</p>
            </li>
          </ol>
        </aside>
      </div>

      <p class="stood-credit">
        World map is free: Natural Earth, public domain. Place names find pins and ride lines via
        OpenStreetMap Nominatim (free, open).
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.querySelector('[data-stood-form]');
    var routeForm = document.querySelector('[data-stood-route-form]');
    var list = document.querySelector('[data-stood-list]');
    var routeList = document.querySelector('[data-stood-route-list]');
    var pins = document.querySelector('[data-stood-pins]');
    var routesSvg = document.querySelector('[data-stood-routes]');
    var status = document.querySelector('[data-stood-status]');
    var routeStatus = document.querySelector('[data-stood-route-status]');
    var map = document.querySelector('[data-stood-map]');
    var stage = document.querySelector('[data-stood-stage]');
    if (!form || !list || !pins) return;

    // Zoom + pan on the free world map (no tile keys).
    if (map && stage) {
      var scale = 1;
      var tx = 0;
      var ty = 0;
      var minScale = 1;
      var maxScale = 8;
      var dragging = false;
      var lastX = 0;
      var lastY = 0;

      function clamp(n, a, b) {
        return Math.min(b, Math.max(a, n));
      }

      function applyMap() {
        if (scale <= 1.001) {
          scale = 1;
          tx = 0;
          ty = 0;
        }
        // Counter-scale pins so they shrink (on screen) as you zoom into the map.
        var pinScale = 1 / Math.pow(scale, 1.15);
        stage.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')';
        stage.style.setProperty('--pin-scale', String(pinScale));
        map.classList.toggle('is-zoomed', scale > 1.01);
      }

      function zoomAt(factor, cx, cy) {
        var next = clamp(scale * factor, minScale, maxScale);
        if (next === scale) return;
        var ratio = next / scale;
        tx = cx - (cx - tx) * ratio;
        ty = cy - (cy - ty) * ratio;
        scale = next;
        applyMap();
      }

      function zoomButton(factor) {
        var rect = map.getBoundingClientRect();
        zoomAt(factor, rect.width / 2, rect.height / 2);
      }

      map.addEventListener(
        'wheel',
        function (event) {
          event.preventDefault();
          var rect = map.getBoundingClientRect();
          var factor = event.deltaY < 0 ? 1.18 : 1 / 1.18;
          zoomAt(factor, event.clientX - rect.left, event.clientY - rect.top);
        },
        { passive: false },
      );

      map.addEventListener('pointerdown', function (event) {
        if (event.target.closest('.map-zoom')) return;
        if (event.target.closest('a')) return;
        dragging = true;
        lastX = event.clientX;
        lastY = event.clientY;
        map.classList.add('is-dragging');
        try {
          map.setPointerCapture(event.pointerId);
        } catch (_) {}
      });

      map.addEventListener('pointermove', function (event) {
        if (!dragging) return;
        tx += event.clientX - lastX;
        ty += event.clientY - lastY;
        lastX = event.clientX;
        lastY = event.clientY;
        applyMap();
      });

      function endDrag(event) {
        if (!dragging) return;
        dragging = false;
        map.classList.remove('is-dragging');
        try {
          map.releasePointerCapture(event.pointerId);
        } catch (_) {}
      }

      map.addEventListener('pointerup', endDrag);
      map.addEventListener('pointercancel', endDrag);

      var zin = map.querySelector('[data-zoom-in]');
      var zout = map.querySelector('[data-zoom-out]');
      var zreset = map.querySelector('[data-zoom-reset]');
      if (zin)
        zin.addEventListener('click', function () {
          zoomButton(1.35);
        });
      if (zout)
        zout.addEventListener('click', function () {
          zoomButton(1 / 1.35);
        });
      if (zreset)
        zreset.addEventListener('click', function () {
          scale = 1;
          tx = 0;
          ty = 0;
          applyMap();
        });

      applyMap();
    }

    function pinPercent(lat, lng) {
      return {
        left: Math.min(98, Math.max(2, ((lng + 180) / 360) * 100)),
        top: Math.min(96, Math.max(4, ((90 - lat) / 180) * 100)),
      };
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function formatWhen(raw) {
      var text = String(raw || '').trim();
      if (!text) return '';
      // Single calendar day → short label. Ranges stay as typed (e.g. 2008 – 2015).
      if (/^\d{4}-\d{2}-\d{2}$/.test(text)) {
        var date = new Date(text + 'T12:00:00');
        if (!Number.isNaN(date.getTime())) {
          try {
            return new Intl.DateTimeFormat('en-GB', {
              month: 'short',
              year: 'numeric',
              timeZone: 'Europe/Berlin',
            }).format(date);
          } catch (_) {}
        }
      }
      return text;
    }

    function setStatus(el, text, tone) {
      if (!el) return;
      el.hidden = !text;
      el.textContent = text || '';
      el.setAttribute('data-tone', tone || '');
    }

    function listItemHtml(row) {
      var when = formatWhen(row.when || row.stoodAt || '');
      var miss =
        row.lat == null || row.lng == null
          ? '<span class="stood-miss">Name saved. Try a clearer place name for the pin.</span>'
          : '';
      return (
        '<li class="stood-item" data-stood-id="' +
        escapeHtml(row.id) +
        '"><div class="stood-link stood-link--plain">' +
        '<span class="stood-place">' +
        escapeHtml(row.place) +
        '</span>' +
        (when ? '<span class="stood-when">' + escapeHtml(when) + '</span>' : '') +
        (row.note ? '<span class="stood-note">' + escapeHtml(row.note) + '</span>' : '') +
        (row.detail ? '<span class="stood-note">' + escapeHtml(row.detail) + '</span>' : '') +
        miss +
        '<button type="button" class="stood-remove" data-stood-remove="place" data-id="' +
        escapeHtml(row.id) +
        '">Take off the map</button>' +
        '</div></li>'
      );
    }

    function pinItemHtml(row) {
      if (row.lat == null || row.lng == null) return '';
      var pos = pinPercent(Number(row.lat), Number(row.lng));
      var when = formatWhen(row.when || '');
      return (
        '<li class="map-pin" data-stood-id="' +
        escapeHtml(row.id) +
        '" style="left:' +
        pos.left +
        '%;top:' +
        pos.top +
        '%;">' +
        '<span class="map-pin-hit map-pin-hit--plain" title="' +
        escapeHtml(row.place) +
        '">' +
        '<span class="map-pin-dot" aria-hidden="true"></span>' +
        '<span class="map-pin-label"><strong>' +
        escapeHtml(row.place) +
        '</strong>' +
        (when ? '<span class="map-pin-when">' + escapeHtml(when) + '</span>' : '') +
        '</span></span></li>'
      );
    }

    function routeListItemHtml(row) {
      var when = formatWhen(row.when || '');
      var stops = Array.isArray(row.points)
        ? row.points
            .map(function (p) {
              return p.name;
            })
            .join(' → ')
        : row.path || '';
      return (
        '<li class="stood-item" data-stood-route-id="' +
        escapeHtml(row.id) +
        '"><div class="stood-link stood-link--plain">' +
        '<span class="stood-place">' +
        escapeHtml(row.title || row.place || 'A ride') +
        '</span>' +
        (when ? '<span class="stood-when">' + escapeHtml(when) + '</span>' : '') +
        (stops ? '<span class="stood-note">' + escapeHtml(stops) + '</span>' : '') +
        (row.note ? '<span class="stood-note">' + escapeHtml(row.note) + '</span>' : '') +
        (row.detail ? '<span class="stood-note">' + escapeHtml(row.detail) + '</span>' : '') +
        '<button type="button" class="stood-remove" data-stood-remove="route" data-id="' +
        escapeHtml(row.id) +
        '">Take off the map</button>' +
        '</div></li>'
      );
    }

    function removeFromDom(kind, id) {
      if (kind === 'route') {
        var routeRow = routeList && routeList.querySelector('[data-stood-route-id="' + id + '"]');
        if (routeRow) routeRow.remove();
        if (routesSvg) {
          var line = routesSvg.querySelector('[data-stood-route-id="' + id + '"]');
          if (line) line.remove();
        }
        // Dots for that ride’s stops.
        pins.querySelectorAll('[data-stood-id^="' + id + '-"]').forEach(function (node) {
          node.remove();
        });
        if (routeList && !routeList.querySelector('.stood-item:not(.stood-item--empty-routes)')) {
          routeList.innerHTML =
            '<li class="stood-item stood-item--empty-routes"><p class="empty">Ride lines show here when you add stops in order above. We draw the thin line.</p></li>';
        }
        return;
      }
      var placeRow = list.querySelector('[data-stood-id="' + id + '"]');
      if (placeRow) placeRow.remove();
      var pin = pins.querySelector('[data-stood-id="' + id + '"]');
      if (pin) pin.remove();
    }

    function bindRemove(root) {
      if (!root) return;
      root.addEventListener('click', function (event) {
        var btn = event.target && event.target.closest
          ? event.target.closest('[data-stood-remove]')
          : null;
        if (!btn) return;
        event.preventDefault();
        var id = btn.getAttribute('data-id') || '';
        var kind = btn.getAttribute('data-stood-remove') === 'route' ? 'route' : 'place';
        if (!id) return;
        btn.disabled = true;
        fetch('/api/stood-places', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'remove', kind: kind, id: id }),
        })
          .then(function (res) {
            return res.json().then(function (data) {
              return { res: res, data: data };
            });
          })
          .then(function (pack) {
            if (!pack.data || !pack.data.ok) {
              btn.disabled = false;
              window.alert(
                (pack.data && pack.data.error) ||
                  'Could not take that off. Open Looks once while signed in, then try again.',
              );
              return;
            }
            removeFromDom(kind, id);
          })
          .catch(function () {
            btn.disabled = false;
            window.alert('Could not take that off just now.');
          });
      });
    }

    function drawRouteLine(row) {
      if (!routesSvg || !row || !row.id || !Array.isArray(row.points) || row.points.length < 2) {
        return;
      }
      if (routesSvg.querySelector('[data-stood-route-id="' + row.id + '"]')) return;
      var pairs = [];
      row.points.forEach(function (point) {
        if (point.lat == null || point.lng == null) return;
        var pos = pinPercent(Number(point.lat), Number(point.lng));
        pairs.push(pos.left.toFixed(2) + ',' + pos.top.toFixed(2));
        // Soft dots on each stop of the ride.
        var stopId = row.id + '-' + String(point.name || '').toLowerCase().replace(/\s+/g, '-');
        if (!pins.querySelector('[data-stood-id="' + stopId + '"]')) {
          pins.insertAdjacentHTML(
            'beforeend',
            pinItemHtml({
              id: stopId,
              place: point.name,
              when: row.when || '',
              lat: point.lat,
              lng: point.lng,
            }),
          );
        }
      });
      if (pairs.length < 2) return;
      var poly = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
      poly.setAttribute('data-stood-route-id', row.id);
      poly.setAttribute('points', pairs.join(' '));
      poly.setAttribute('fill', 'none');
      poly.setAttribute('class', 'map-route-line');
      routesSvg.appendChild(poly);
    }

    function mergeLivePlaces(places) {
      if (!Array.isArray(places) || !places.length) return;
      var empty = list.querySelector('.stood-item--empty');
      if (empty) empty.remove();
      places
        .slice()
        .reverse()
        .forEach(function (row) {
          if (!row || !row.id) return;
          if (!list.querySelector('[data-stood-id="' + row.id + '"]')) {
            list.insertAdjacentHTML('afterbegin', listItemHtml(row));
          }
          var pinHtml = pinItemHtml(row);
          if (pinHtml && !pins.querySelector('[data-stood-id="' + row.id + '"]')) {
            pins.insertAdjacentHTML('beforeend', pinHtml);
          }
        });
    }

    function mergeLiveRoutes(routes) {
      if (!Array.isArray(routes) || !routes.length || !routeList) return;
      var empty = routeList.querySelector('.stood-item--empty-routes');
      if (empty) empty.remove();
      routes
        .slice()
        .reverse()
        .forEach(function (row) {
          if (!row || !row.id) return;
          if (!routeList.querySelector('[data-stood-route-id="' + row.id + '"]')) {
            routeList.insertAdjacentHTML('afterbegin', routeListItemHtml(row));
          }
          drawRouteLine(row);
        });
    }

    function loadLive() {
      fetch('/api/stood-places', { credentials: 'same-origin' })
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          if (!data || !data.ok) return;
          mergeLivePlaces(data.places || []);
          mergeLiveRoutes(data.routes || []);
        })
        .catch(function () {});
    }

    function bindSave(formEl, statusEl, onOk) {
      if (!formEl) return;
      formEl.addEventListener('submit', function (event) {
        event.preventDefault();
        var fd = new FormData(formEl);
        var payload = {
          place: String(fd.get('place') || '').trim(),
          when: String(fd.get('when') || '').trim(),
          note: String(fd.get('note') || '').trim(),
          detail: String(fd.get('detail') || '').trim(),
          path: String(fd.get('path') || '').trim(),
          website: String(fd.get('website') || '').trim(),
        };
        var button = formEl.querySelector('button[type="submit"]');
        if (button) button.disabled = true;
        setStatus(statusEl, payload.path ? 'Drawing the line…' : 'Saving…', '');
        fetch('/api/stood-places', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (res) {
            return res.json().then(function (data) {
              return { data: data };
            });
          })
          .then(function (pack) {
            if (button) button.disabled = false;
            if (!pack.data || !pack.data.ok) {
              setStatus(
                statusEl,
                (pack.data && pack.data.error) || 'Could not save that just now.',
                'bad',
              );
              return;
            }
            formEl.reset();
            setStatus(statusEl, pack.data.kind === 'route' ? 'Line on the map.' : 'On the map.', 'ok');
            onOk(pack.data);
          })
          .catch(function () {
            if (button) button.disabled = false;
            setStatus(statusEl, 'Could not save that just now.', 'bad');
          });
      });
    }

    bindSave(form, status, function (data) {
      if (data.place) mergeLivePlaces([data.place]);
    });
    bindSave(routeForm, routeStatus, function (data) {
      if (data.route) mergeLiveRoutes([data.route]);
    });
    bindRemove(list);
    bindRemove(routeList);

    loadLive();
  })();
</script>

