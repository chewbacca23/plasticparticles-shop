---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberDelete from '../components/MemberDelete.astro';
---

<BaseLayout
  title="Members"
  description="Private free-member signup list for The Soul Searchers."
  robots="noindex, nofollow"
>
  <section class="section">
    <div class="site-shell members">
      <p class="eyebrow members-private">Private · only for you</p>
      <h1 class="section-title members-title">
        Free members <span data-members-count>—</span>
      </h1>
      <p class="section-lead">
        Only for you. Everyone who joined the free list, newest first. Names and emails stay off the
        public site.
      </p>

      <ol class="pages" data-members-list>
        <li class="empty">No free members yet. When someone joins, they show here.</li>
      </ol>

      <p class="note">
        <a href="/looks">Looks</a>
        ·
        <a href="/admin/">Editor</a>
      </p>
    </div>
  </section>
  <MemberDelete />
</BaseLayout>

<style>
  .members {
    max-width: 40rem;
  }

  .members-private {
    color: #6fcf8a;
  }

  .members-title {
    color: #8fe0a4;
  }

  .members-title :global([data-members-count]) {
    color: #6fcf8a;
  }

  .pages {
    margin: 1.5rem 0 1.75rem;
    padding: 0;
    list-style: none;
    border: 1px solid rgba(215, 224, 232, 0.1);
    border-radius: 1rem;
    overflow: hidden;
  }

  .pages :global(li) {
    padding: 0.9rem 1.15rem;
    border-top: 1px solid rgba(215, 224, 232, 0.08);
  }

  .pages :global(li:first-child) {
    border-top: 0;
  }

  .pages :global(a) {
    color: var(--paper);
  }

  .pages :global(.empty) {
    color: rgba(215, 224, 232, 0.68);
  }

  .note {
    margin: 0;
    color: rgba(215, 224, 232, 0.62);
    font-size: 0.92rem;
  }

  .note a {
    color: var(--amber-hot);
    text-decoration: none;
    font-weight: 600;
  }
</style>
