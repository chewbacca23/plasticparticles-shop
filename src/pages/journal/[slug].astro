---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { galleryMedia } from '../../lib/media';
import { renderMarkdown } from '../../../cloudflare/fresh-ride.js';
import { planRidePhotos } from '../../../cloudflare/story-photos.js';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const photos = galleryMedia(post.data.cover, post.data.gallery);
const plan = planRidePhotos(photos, post.body, post.data.cover);
const noteHtml = renderMarkdown(plan.wovenBody);
const formatted = post.data.pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <article class="section">
    <div class="site-shell article-shell">
      <header class="article-header">
        {post.data.heroLabel && <p class="eyebrow">{post.data.heroLabel}</p>}
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.description}</p>
        <time datetime={post.data.pubDate.toISOString()}>{formatted}</time>
      </header>

      {
        plan.hero && (
          <figure class="hero">
            <img src={plan.hero} alt="" width="1200" height="900" loading="eager" />
          </figure>
        )
      }

      <div class="prose" set:html={noteHtml} />
      <p class="back">
        <a href="/journal">← All ride notes</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .article-shell {
    max-width: 44rem;
  }

  .article-header {
    margin-bottom: 2.25rem;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
  }

  .dek {
    margin: 0 0 1rem;
    color: rgba(215, 224, 232, 0.78);
    font-size: 1.1rem;
  }

  time {
    color: var(--amber);
    font-size: 0.86rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero {
    margin: 0 0 2rem;
    overflow: hidden;
    border-radius: 0.9rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }

  .hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  .prose :global(figure) {
    margin: 1.8rem 0;
    overflow: hidden;
    border-radius: 0.9rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }

  .prose :global(figure img) {
    margin: 0;
    box-shadow: none;
  }

  .back {
    margin-top: 3rem;
  }

  .back a {
    color: var(--amber-hot);
    text-decoration: none;
    font-weight: 600;
  }
</style>
