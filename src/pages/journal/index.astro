---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Journal"
  description="Notes from the saddle — cycling, travel, and looking closer at this wonderful planet."
>
  <section class="section">
    <div class="site-shell">
      <p class="eyebrow">Journal</p>
      <h1 class="section-title">Notes from the saddle</h1>
      <p class="section-lead">
        Ride thoughts, travel notes, and the search that keeps you clipping in. Come back after the
        kilometres — the page will wait.
      </p>
      <div class="post-list">
        {
          posts.map((post) => (
            <PostCard
              href={`/journal/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              date={post.data.pubDate}
              label={post.data.heroLabel}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-list {
    display: grid;
  }
</style>
