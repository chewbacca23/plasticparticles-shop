---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Ride notes"
  description="Ride notes from The Soul Searchers cycling blog — packing, trains, cafés, touring."
>
  <section class="section">
    <div class="site-shell">
      <p class="eyebrow">Ride notes</p>
      <h1 class="section-title">Ride notes</h1>
      <p class="section-lead">
        How we pack the bike, get it on a train, ride without a cue sheet, and write it down after
        the kilometres. This is the cycling blog’s notebook.
      </p>
      <div class="post-list">
        {
          posts.map((post) => (
            <PostCard
              href={`/journal/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              date={post.data.pubDate}
              label={post.data.heroLabel}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-list {
    display: grid;
  }
</style>
