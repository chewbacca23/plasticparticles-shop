---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import LogoBackdrop from '../components/LogoBackdrop.astro';
import { site } from '../site.config';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout watermark={false}>
  <section class="hero" aria-label="Welcome">
    <div class="sky" aria-hidden="true">
      <LogoBackdrop variant="hero" />
      <div class="sky-aurora"></div>
      <div class="sky-stars">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="sky-horizon"></div>
    </div>

    <div class="site-shell hero-copy">
      <img class="hero-logo reveal" src={site.logo} alt="" width="88" height="88" decoding="async" />
      <p class="brand-hero reveal reveal-delay-1">{site.name}</p>
      <h1 class="reveal reveal-delay-2">Walk your own path — the net will appear.</h1>
      <p class="hero-lead reveal reveal-delay-3">
        {site.tagline} Essays, notes, and quiet nudges for anyone learning to trust their own choices.
      </p>
      <div class="hero-actions reveal reveal-delay-3">
        <a class="btn btn-primary" href="/journal">Read the journal</a>
        <a class="btn btn-ghost" href="/about">Meet the search</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <p class="eyebrow">From the journal</p>
      <h2 class="section-title">Latest notes</h2>
      <p class="section-lead">
        Fresh pages from a home we own — written for the dreamers still peeking at the wrapped box.
      </p>
      <div class="post-list">
        {
          posts.map((post) => (
            <PostCard
              href={`/journal/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              date={post.data.pubDate}
              label={post.data.heroLabel}
            />
          ))
        }
      </div>
      <p class="more">
        <a href="/journal">Browse every entry →</a>
      </p>
    </div>
  </section>

  <section class="section invite">
    <div class="site-shell invite-inner">
      <div>
        <p class="eyebrow">Stay close</p>
        <h2 class="section-title">This site is ours now.</h2>
        <p class="section-lead">
          No rented dashboard. No missing stats menu. Just a journal we can shape — landing page,
          posts, and everything else under our own roof.
        </p>
      </div>
      <div class="invite-actions">
        <a class="btn btn-primary" href="/contact">Say hello</a>
        <a class="btn btn-ghost" href="/path">Walk the path</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(100vh, 54rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 85% 60% at 72% 18%, rgba(61, 107, 122, 0.38), transparent 62%),
      radial-gradient(ellipse 55% 50% at 12% 28%, rgba(212, 163, 90, 0.14), transparent 58%),
      linear-gradient(180deg, #080c11 0%, #0f1820 45%, #182a36 70%, #2a2218 100%);
  }

  .sky :global(.logo-backdrop) {
    position: absolute;
  }

  .sky-aurora {
    position: absolute;
    inset: -10% -5% 35%;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(61, 107, 122, 0.35), transparent 55%),
      radial-gradient(ellipse at 70% 30%, rgba(240, 194, 122, 0.18), transparent 50%);
    filter: blur(18px);
    animation: aurora 14s ease-in-out infinite;
  }

  .sky-stars {
    position: absolute;
    inset: 0 0 35%;
  }

  .sky-stars span {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #eef3f7;
    animation: twinkle 3.8s ease-in-out infinite;
  }

  .sky-stars span:nth-child(1) { top: 12%; left: 8%; animation-delay: 0.2s; }
  .sky-stars span:nth-child(2) { top: 18%; left: 24%; width: 3px; height: 3px; animation-delay: 0.8s; }
  .sky-stars span:nth-child(3) { top: 9%; left: 46%; animation-delay: 1.4s; }
  .sky-stars span:nth-child(4) { top: 22%; left: 63%; animation-delay: 0.5s; }
  .sky-stars span:nth-child(5) { top: 14%; left: 78%; width: 3px; height: 3px; animation-delay: 1.1s; }
  .sky-stars span:nth-child(6) { top: 32%; left: 15%; animation-delay: 1.7s; }
  .sky-stars span:nth-child(7) { top: 28%; left: 38%; animation-delay: 0.3s; }
  .sky-stars span:nth-child(8) { top: 36%; left: 55%; animation-delay: 2s; }
  .sky-stars span:nth-child(9) { top: 26%; left: 84%; animation-delay: 0.9s; }
  .sky-stars span:nth-child(10) { top: 40%; left: 72%; width: 3px; height: 3px; animation-delay: 1.5s; }

  .sky-horizon {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background:
      linear-gradient(180deg, transparent, rgba(58, 42, 28, 0.55) 40%, rgba(12, 18, 24, 0.92)),
      radial-gradient(ellipse 90% 70% at 50% 100%, rgba(212, 163, 90, 0.28), transparent 70%);
  }

  .hero-copy {
    position: relative;
    padding: 7rem 0 4.5rem;
    max-width: 44rem;
  }

  .hero-logo {
    width: clamp(3.5rem, 10vw, 5.5rem);
    height: auto;
    margin-bottom: 1.25rem;
    opacity: 0.92;
    filter: drop-shadow(0 12px 32px rgba(212, 163, 90, 0.25));
  }

  .brand-hero {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 4.4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--paper);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  }

  h1 {
    margin: 0 0 1rem;
    max-width: 16ch;
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    font-weight: 500;
    color: rgba(238, 243, 247, 0.92);
  }

  .hero-lead {
    margin: 0 0 1.75rem;
    max-width: 34rem;
    color: rgba(215, 224, 232, 0.82);
    font-size: 1.08rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .post-list {
    display: grid;
  }

  .more {
    margin: 1.5rem 0 0;
  }

  .more a {
    color: var(--amber-hot);
    text-decoration: none;
    font-weight: 600;
  }

  .invite {
    padding-top: 0;
  }

  .invite-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2.25rem;
    border: 1px solid rgba(215, 224, 232, 0.1);
    border-radius: 1.35rem;
    background:
      linear-gradient(135deg, rgba(30, 58, 69, 0.35), rgba(12, 18, 24, 0.15)),
      rgba(20, 28, 38, 0.45);
    backdrop-filter: blur(12px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.22);
  }

  .invite-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .invite .section-title,
  .invite .section-lead {
    margin-bottom: 0.75rem;
  }
</style>
