---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoBackdrop from '../components/LogoBackdrop.astro';
import FeedGrid from '../components/FeedGrid.astro';
import InstagramLatest from '../components/InstagramLatest.astro';
import { getCollection } from 'astro:content';
import { collectFeed } from '../lib/feed';
import { site } from '../site.config';

const [shots, stories] = await Promise.all([
  getCollection('shots', ({ data }) => !data.draft),
  getCollection('stories', ({ data }) => !data.draft),
]);

const nowItems = collectFeed(
  shots.map((shot) => ({ id: shot.id, ...shot.data })),
  stories.map((story) => ({ id: story.id, ...story.data })),
);
---

<BaseLayout watermark={false}>
  <section class="hero" aria-label="Welcome">
    <div class="sky" aria-hidden="true">
      <LogoBackdrop variant="hero" />
      <div class="sky-aurora"></div>
      <div class="sky-stars">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="sky-horizon"></div>
    </div>

    <div class="site-shell hero-copy">
      <img class="hero-logo reveal" src={site.logo} alt="The New Soul Searchers" width="88" height="112" decoding="async" />
      <p class="brand-hero reveal reveal-delay-1">{site.name}</p>
      <h1 class="reveal reveal-delay-2">This is a cycling blog.</h1>
      <p class="hero-lead reveal reveal-delay-3">
        Tours, climbs, coast roads, café stops, and a bike in the luggage car. We ride to see this
        planet — not to sit in a car. Photos from the road below. Clip in.
      </p>
      <div class="hero-actions reveal reveal-delay-3">
        <a class="btn btn-primary" href="#now">Now</a>
        <a class="btn btn-ghost" href="/stories">The rides</a>
      </div>
      <p class="scroll-hint reveal reveal-delay-3">
        <a href="#now">See the latest shots ↓</a>
      </p>
    </div>
  </section>

  <section class="section now-home" id="now" aria-label="Now">
    <div class="site-shell">
      <p class="eyebrow">Now</p>
      <h2 class="section-title">From the road</h2>
      <p class="section-lead">
        Newest photos first. Tap one and stay — there is always another shot.
      </p>
      <InstagramLatest />
      <FeedGrid items={nowItems} limit={12} moreHref="/now" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 85% 60% at 72% 18%, rgba(61, 107, 122, 0.38), transparent 62%),
      radial-gradient(ellipse 55% 50% at 12% 28%, rgba(212, 163, 90, 0.14), transparent 58%),
      linear-gradient(180deg, #080c11 0%, #0f1820 45%, #182a36 70%, #2a2218 100%);
  }

  .sky :global(.logo-backdrop) {
    position: absolute;
  }

  .sky-aurora {
    position: absolute;
    inset: -10% -5% 35%;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(61, 107, 122, 0.35), transparent 55%),
      radial-gradient(ellipse at 70% 30%, rgba(240, 194, 122, 0.18), transparent 50%);
    filter: blur(18px);
    animation: aurora 14s ease-in-out infinite;
  }

  .sky-stars {
    position: absolute;
    inset: 0 0 35%;
  }

  .sky-stars span {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #eef3f7;
    animation: twinkle 3.8s ease-in-out infinite;
  }

  .sky-stars span:nth-child(1) { top: 12%; left: 8%; animation-delay: 0.2s; }
  .sky-stars span:nth-child(2) { top: 18%; left: 24%; width: 3px; height: 3px; animation-delay: 0.8s; }
  .sky-stars span:nth-child(3) { top: 9%; left: 46%; animation-delay: 1.4s; }
  .sky-stars span:nth-child(4) { top: 22%; left: 63%; animation-delay: 0.5s; }
  .sky-stars span:nth-child(5) { top: 14%; left: 78%; width: 3px; height: 3px; animation-delay: 1.1s; }
  .sky-stars span:nth-child(6) { top: 32%; left: 15%; animation-delay: 1.7s; }
  .sky-stars span:nth-child(7) { top: 28%; left: 38%; animation-delay: 0.3s; }
  .sky-stars span:nth-child(8) { top: 36%; left: 55%; animation-delay: 2s; }
  .sky-stars span:nth-child(9) { top: 26%; left: 84%; animation-delay: 0.9s; }
  .sky-stars span:nth-child(10) { top: 40%; left: 72%; width: 3px; height: 3px; animation-delay: 1.5s; }

  .sky-horizon {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background:
      linear-gradient(180deg, transparent, rgba(58, 42, 28, 0.55) 40%, rgba(12, 18, 24, 0.92)),
      radial-gradient(ellipse 90% 70% at 50% 100%, rgba(212, 163, 90, 0.28), transparent 70%);
  }

  .hero-copy {
    position: relative;
    padding: 7rem 0 5.5rem;
    max-width: 44rem;
  }

  .hero-logo {
    width: clamp(3.5rem, 10vw, 5.5rem);
    height: auto;
    margin-bottom: 1.25rem;
    opacity: 0.92;
    filter: drop-shadow(0 12px 32px rgba(212, 163, 90, 0.25));
  }

  .brand-hero {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 5rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.03em;
    color: var(--paper);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  }

  h1 {
    margin: 0 0 1rem;
    max-width: 18ch;
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    font-weight: 500;
    color: rgba(238, 243, 247, 0.92);
  }

  .hero-lead {
    margin: 0 0 1.75rem;
    max-width: 34rem;
    color: rgba(215, 224, 232, 0.82);
    font-size: 1.08rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .scroll-hint {
    margin: 2.25rem 0 0;
    font-size: 0.88rem;
  }

  .scroll-hint a {
    color: rgba(215, 224, 232, 0.55);
    text-decoration: none;
  }

  .scroll-hint a:hover {
    color: var(--amber-hot);
  }

  .now-home {
    border-top: 1px solid rgba(215, 224, 232, 0.08);
  }
</style>
