---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import saved from '../content/settings/site.json';
import { publicEmail } from '../lib/site-settings';

const email = publicEmail(saved);
---

<BaseLayout
  title="Contact"
  description={`Write to ${site.name}. Routes, café tips, climbs, or a hello from another rider.`}
>
  <section class="section">
    <div class="site-shell contact">
      <p class="eyebrow">Contact</p>
      <h1 class="section-title">Write from the road</h1>
      <p class="section-lead">
        A climb you loved, a bike-friendly train, a puncture story, a guest ride note. Send it
        here and it lands in Henrik’s inbox. Reply is one click away.
      </p>

      <div id="form-success" class="success" hidden>
        <h2>Sent</h2>
        <p data-success-copy>
          Your note is on its way to Henrik’s inbox
          (<span data-mail-to>henrik@thenewsoulsearchers.de</span>).
          He can reply straight to the address you left.
        </p>
      </div>

      <div id="form-mailto" class="success success--soft" hidden>
        <h2>Almost there</h2>
        <p>
          Your mail app should open with the note filled in. If it does not, write
          <a data-site="email" href={`mailto:${email}`}>{email}</a> direct.
        </p>
      </div>

      <p id="form-error" class="error" hidden></p>

      <form id="contact-form" class="form" method="post" action="/api/contact" data-site="mail-form">
        <label>
          <span>Name</span>
          <input type="text" name="name" required autocomplete="name" maxlength="120" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" maxlength="200" />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="6" required maxlength="5000"></textarea>
        </label>
        <!-- Honeypot: leave empty. Hidden from people, not from bots. -->
        <label class="hp" aria-hidden="true">
          <span>Company</span>
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>

      <p class="alt">
        Prefer a direct line?
        <a data-site="email" href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var success = document.getElementById('form-success');
    var mailtoBox = document.getElementById('form-mailto');
    var errorBox = document.getElementById('form-error');
    if (!form) return;

    var sending = false;

    function showError(text) {
      if (!errorBox) return;
      errorBox.textContent = text || 'Could not send just now.';
      errorBox.hidden = false;
    }

    function hideError() {
      if (!errorBox) return;
      errorBox.hidden = true;
      errorBox.textContent = '';
    }

    function hideForm() {
      form.hidden = true;
      hideError();
    }

    function showSent(to) {
      if (mailtoBox) mailtoBox.hidden = true;
      if (success) {
        var slot = success.querySelector('[data-mail-to]');
        if (slot && to) slot.textContent = to;
        success.hidden = false;
      }
      hideForm();
    }

    function showMailtoFallback() {
      if (success) success.hidden = true;
      if (mailtoBox) mailtoBox.hidden = false;
      hideForm();
    }

    function openMailto(fields) {
      var mail =
        (document.querySelector('[data-site="email"]') || {}).getAttribute('href') ||
        'mailto:hello@thenewsoulsearchers.de';
      var to = String(mail).replace(/^mailto:/i, '').split('?')[0];
      var subject = encodeURIComponent('Soul Searchers note from ' + fields.name);
      var body = encodeURIComponent(
        'From: ' + fields.name + ' <' + fields.email + '>\n\n' + fields.message,
      );
      window.location.href = 'mailto:' + to + '?subject=' + subject + '&body=' + body;
    }

    async function sendNote(fields) {
      if (sending) return;
      sending = true;
      hideError();
      var button = form.querySelector('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }

      try {
        var res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(fields),
        });
        var data = {};
        try {
          data = await res.json();
        } catch (_) {}

        if (res.ok && data.ok) {
          showSent(data.to);
          return;
        }

        if (data && data.mailto) {
          openMailto(fields);
          showMailtoFallback();
          return;
        }

        showError((data && data.error) || 'Could not send just now.');
      } catch (_) {
        openMailto(fields);
        showMailtoFallback();
      } finally {
        sending = false;
        if (button && !form.hidden) {
          button.disabled = false;
          button.textContent = 'Send message';
        }
      }
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var data = new FormData(form);
      sendNote({
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        message: String(data.get('message') || '').trim(),
        company: String(data.get('company') || '').trim(),
      });
    });
  })();
</script>

<style>
  .contact {
    max-width: 36rem;
  }

  .form {
    display: grid;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
  }

  label span {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(215, 224, 232, 0.72);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(215, 224, 232, 0.18);
    border-radius: 0.85rem;
    background: rgba(26, 36, 48, 0.7);
    color: var(--paper);
    font: inherit;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid rgba(212, 163, 90, 0.55);
    outline-offset: 2px;
    border-color: var(--amber);
  }

  .hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .alt {
    margin-top: 1.75rem;
    color: rgba(215, 224, 232, 0.7);
  }

  .alt a,
  .success a {
    color: var(--amber-hot);
  }

  .error {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(220, 90, 90, 0.45);
    border-radius: 0.85rem;
    background: rgba(80, 24, 24, 0.35);
    color: rgba(255, 220, 220, 0.92);
  }

  .success {
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid rgba(212, 163, 90, 0.35);
    border-radius: 1rem;
    background: rgba(30, 58, 69, 0.35);
  }

  .success--soft {
    border-color: rgba(215, 224, 232, 0.2);
    background: rgba(26, 36, 48, 0.55);
  }

  .success h2 {
    margin: 0 0 0.45rem;
    font-size: 1.25rem;
  }

  .success p {
    margin: 0;
    color: rgba(215, 224, 232, 0.82);
  }

  button:disabled {
    opacity: 0.7;
    cursor: wait;
  }
</style>
