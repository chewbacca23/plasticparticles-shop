---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import saved from '../content/settings/site.json';
import { publicEmail } from '../lib/site-settings';

const email = publicEmail(saved);
---

<BaseLayout
  title="Contact"
  description={`Write to ${site.name}. Routes, café tips, climbs, or a hello from another rider.`}
>
  <section class="section">
    <div class="site-shell contact">
      <p class="eyebrow">Contact</p>
      <h1 class="section-title">Write from the road</h1>
      <p class="section-lead">
        A climb you loved, a bike-friendly train, a puncture story, a guest ride note. Send it
        here and the site delivers it for you. No need to open your own mail app. Reply is one
        click for Henrik.
      </p>

      <div id="form-success" class="success" hidden>
        <h2>Sent</h2>
        <p data-success-copy>
          Your note left from the Soul Searchers form and is on its way to Henrik.
          He can reply straight to the address you left.
        </p>
      </div>

      <div id="form-mailto" class="success success--soft" hidden>
        <h2>Not delivered yet</h2>
        <p data-fail-copy>
          The site could not hand the note to the mail service. Your mail app was not opened.
          Write <a data-site="email" href={`mailto:${email}`}>{email}</a> direct.
        </p>
      </div>

      <p id="form-error" class="error" hidden></p>
      <p id="form-mail-hint" class="hint" hidden></p>

      <form id="contact-form" class="form" method="post" action="/api/contact" data-site="mail-form">
        <label>
          <span>Name</span>
          <input type="text" name="name" required autocomplete="name" maxlength="120" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" maxlength="200" />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="6" required maxlength="5000"></textarea>
        </label>
        <!-- Honeypot: leave empty. Hidden from people, not from bots. -->
        <label class="hp" aria-hidden="true">
          <span>Company</span>
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>

      <p class="alt">
        Prefer a direct line?
        <a data-site="email" href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var success = document.getElementById('form-success');
    var mailtoBox = document.getElementById('form-mailto');
    var errorBox = document.getElementById('form-error');
    var mailHint = document.getElementById('form-mail-hint');
    if (!form) return;

    var sending = false;
    var locked = false;
    var attempts = 0;
    var MAX_ATTEMPTS = 2;
    var SEND_TIMEOUT_MS = 20000;

    // Quiet status check so a missing Resend key is visible before the first Send.
    fetch('/api/contact', { method: 'GET', headers: { accept: 'application/json' } })
      .then(function (res) {
        return res.json();
      })
      .then(function (data) {
        if (!mailHint || !data || data.mailWired) return;
        mailHint.hidden = false;
        mailHint.textContent =
          'Mail is not wired on this Worker yet (no Resend key). Notes cannot leave the site until that secret is set.';
      })
      .catch(function () {});

    function showError(text) {
      if (!errorBox) return;
      errorBox.textContent = text || 'Could not send just now.';
      errorBox.hidden = false;
    }

    function hideError() {
      if (!errorBox) return;
      errorBox.hidden = true;
      errorBox.textContent = '';
    }

    function hideForm() {
      form.hidden = true;
      hideError();
    }

    function setBusy(button, busy) {
      var fields = form.querySelectorAll('input, textarea, button');
      for (var i = 0; i < fields.length; i++) fields[i].disabled = busy || locked;
      if (!button) return;
      if (busy) {
        button.textContent = 'Sending…';
        return;
      }
      if (locked) {
        button.textContent = 'Stopped';
        return;
      }
      button.textContent = attempts > 0 ? 'Try once more' : 'Send message';
    }

    function showSent(_to) {
      locked = true;
      if (mailtoBox) mailtoBox.hidden = true;
      if (success) success.hidden = false;
      hideForm();
    }

    function failEmail() {
      var link = document.querySelector('[data-site="email"]');
      var href = link && link.getAttribute('href');
      if (href && /^mailto:/i.test(href)) return String(href).replace(/^mailto:/i, '').split('?')[0];
      return 'hello@thenewsoulsearchers.de';
    }

    function showStopped(message) {
      locked = true;
      if (success) success.hidden = true;
      if (mailtoBox) {
        var copy = mailtoBox.querySelector('[data-fail-copy]');
        if (copy) {
          var addr = failEmail();
          copy.innerHTML =
            (message || 'The site could not hand the note to the mail service.') +
            ' Your mail app was not opened. Write <a data-site="email" href="mailto:' +
            addr +
            '">' +
            addr +
            '</a> direct.';
        }
        mailtoBox.hidden = false;
      }
      hideForm();
    }

    function fetchWithTimeout(url, options, ms) {
      var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var timer = null;
      var opts = options || {};
      if (ctrl) opts.signal = ctrl.signal;
      var pending = fetch(url, opts);
      if (ctrl) {
        timer = setTimeout(function () {
          try {
            ctrl.abort();
          } catch (_) {}
        }, ms);
      }
      return pending.finally(function () {
        if (timer) clearTimeout(timer);
      });
    }

    async function sendNote(fields) {
      if (sending || locked) return;
      if (attempts >= MAX_ATTEMPTS) {
        showStopped('Stopped after two tries so this does not loop.');
        return;
      }

      sending = true;
      attempts += 1;
      hideError();
      var button = form.querySelector('button[type="submit"]');
      setBusy(button, true);

      try {
        var res = await fetchWithTimeout(
          '/api/contact',
          {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(fields),
          },
          SEND_TIMEOUT_MS,
        );
        var data = {};
        try {
          data = await res.json();
        } catch (_) {}

        if (res.ok && data.ok) {
          showSent(data.to);
          return;
        }

        // Hard stop: mail not wired, or we already used both tries.
        // Never open the visitor mail app — that was the old “send forever” loop.
        if ((data && data.mailto) || attempts >= MAX_ATTEMPTS) {
          showStopped((data && data.error) || 'The site could not hand the note to the mail service.');
          return;
        }

        showError(
          ((data && data.error) || 'Could not send just now.') + ' One more try, then we stop.',
        );
      } catch (_) {
        if (attempts >= MAX_ATTEMPTS) {
          showStopped('The send timed out twice. Stopped so it does not keep trying.');
          return;
        }
        showError('That send stalled. One more try, then we stop.');
      } finally {
        sending = false;
        setBusy(button, false);
      }
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      event.stopPropagation();
      if (sending || locked) return;
      var data = new FormData(form);
      sendNote({
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        message: String(data.get('message') || '').trim(),
        company: String(data.get('company') || '').trim(),
      });
    });
  })();
</script>

<style>
  .contact {
    max-width: 36rem;
  }

  .form {
    display: grid;
    gap: 1rem;
  }

  .form[hidden],
  #form-success[hidden],
  #form-mailto[hidden],
  #form-error[hidden],
  #form-mail-hint[hidden] {
    display: none !important;
  }

  label {
    display: grid;
    gap: 0.4rem;
  }

  label span {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(215, 224, 232, 0.72);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(215, 224, 232, 0.18);
    border-radius: 0.85rem;
    background: rgba(26, 36, 48, 0.7);
    color: var(--paper);
    font: inherit;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid rgba(212, 163, 90, 0.55);
    outline-offset: 2px;
    border-color: var(--amber);
  }

  .hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .alt {
    margin-top: 1.75rem;
    color: rgba(215, 224, 232, 0.7);
  }

  .alt a,
  .success a {
    color: var(--amber-hot);
  }

  .error {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(220, 90, 90, 0.45);
    border-radius: 0.85rem;
    background: rgba(80, 24, 24, 0.35);
    color: rgba(255, 220, 220, 0.92);
  }

  .hint {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(212, 163, 90, 0.35);
    border-radius: 0.85rem;
    background: rgba(30, 58, 69, 0.35);
    color: rgba(215, 224, 232, 0.88);
  }

  .success {
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid rgba(212, 163, 90, 0.35);
    border-radius: 1rem;
    background: rgba(30, 58, 69, 0.35);
  }

  .success--soft {
    border-color: rgba(215, 224, 232, 0.2);
    background: rgba(26, 36, 48, 0.55);
  }

  .success h2 {
    margin: 0 0 0.45rem;
    font-size: 1.25rem;
  }

  .success p {
    margin: 0;
    color: rgba(215, 224, 232, 0.82);
  }

  button:disabled {
    opacity: 0.7;
    cursor: wait;
  }
</style>
