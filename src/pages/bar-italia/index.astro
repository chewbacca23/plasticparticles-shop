---
import BarItaliaLayout from '../../layouts/BarItaliaLayout.astro';
import BarItaliaMark from '../../components/BarItaliaMark.astro';
---

<BarItaliaLayout>
  <header class="top">
    <div class="shell top-inner">
      <a class="brand" href="/bar-italia"><BarItaliaMark size="nav" /></a>
      <nav class="nav" aria-label="Bar Italia">
        <a href="#coffee">Coffee</a>
        <a href="#music">Music</a>
        <a href="#find">Find us</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-label="Welcome">
      <div class="hero-stage" aria-hidden="true">
        <div class="hero-wash"></div>
        {/* Top-down cups that still read as vinyls: concentric rings, slow spin. */}
        <div class="disc disc--cappu" title="Cappuccino">
          <span class="disc-steam"><i></i><i></i><i></i></span>
        </div>
        <div class="disc disc--espresso" title="Espresso">
          <span class="disc-steam"><i></i><i></i></span>
        </div>
      </div>
      <div class="shell hero-copy">
        <p class="eyebrow">Kreuzberg · Mehringdamm</p>
        <h1 class="brand-hero"><BarItaliaMark size="hero" /></h1>
        <p class="lead">
          A small Italian espresso bar.<br />
          Care in the cup, and records on the stereo.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#find">Find us</a>
        </div>
      </div>
    </section>

    <section class="block coffee" id="coffee">
      <div class="shell split">
        <div>
          <p class="eyebrow">In the cup</p>
          <h2>Coffee with care</h2>
          <p>
            Alex searched until he found the right beans: Pasucci, roasted by a family in the
            Italian mountains. Elegant and strong, made for a morning that can take its time.
          </p>
          <p>
            Come early if you like. Light through the small windows, the room filling with aroma.
          </p>
        </div>
        <aside class="panel" aria-label="What we love in the cup">
          <p class="panel-kicker">The blend</p>
          <p class="panel-title">Pasucci</p>
          <p class="panel-note">
            Brought back from Italy for Bar Italia. A cup that tastes like someone meant it.
          </p>
        </aside>
      </div>
    </section>

    <section class="block music" id="music">
      <div class="shell">
        <p class="eyebrow">On the stereo</p>
        <h2>Records in the room</h2>
        <p class="music-lead">
          Alex puts on music that shapes the morning. Grooves sit beside the espresso machine
          while the milk steams, and Kreuzberg keeps easy company.
        </p>
      </div>
    </section>

    <section class="block find" id="find">
      <div class="shell find-grid">
        <div>
          <p class="eyebrow">The corner</p>
          <h2>Find us</h2>
          <p>
            Mehringdamm 72<br />
            Entrance on Kreuzbergstraße<br />
            10961 Berlin-Kreuzberg
          </p>
          <p>
            <a href="tel:+493078714417">030 78 71 44 17</a><br />
            <a href="mailto:bar@bar-italia-berlin.de">bar@bar-italia-berlin.de</a>
          </p>
          <p class="hours">
            Mon-Fri 8:00-18:00<br />
            Sat-Sun 10:00-18:00
          </p>
        </div>
        <div class="map-card">
          <p class="panel-kicker">Open the map</p>
          <a
            class="map-link"
            href="https://maps.google.com/?q=Bar+Italia+Mehringdamm+72+Berlin"
            target="_blank"
            rel="noopener noreferrer"
          >
            Mehringdamm 72<br />
            <span>Google Maps →</span>
          </a>
          <p class="map-note">A tiny Italy on the corner. Look for the entrance on Kreuzbergstraße.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="shell foot-inner">
      <p class="foot-brand"><BarItaliaMark size="foot" /></p>
      <p class="foot-gift">
        A small surprise site for Alex, from a friend on two wheels.
      </p>
    </div>
  </footer>
</BarItaliaLayout>

<style>
  .shell {
    width: min(44rem, calc(100% - 2.4rem));
    margin: 0 auto;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: rgba(20, 14, 12, 0.78);
    border-bottom: 1px solid rgba(232, 220, 200, 0.08);
  }

  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
  }

  .brand {
    color: var(--bi-foam);
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .nav a {
    color: rgba(232, 220, 200, 0.72);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--bi-brass-hot);
  }

  .hero {
    position: relative;
    min-height: calc(100vh - 3.5rem);
    min-height: calc(100dvh - 3.5rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 55% at 18% 20%, rgba(196, 163, 90, 0.16), transparent 55%),
      radial-gradient(ellipse 60% 50% at 88% 70%, rgba(90, 40, 28, 0.45), transparent 60%),
      linear-gradient(165deg, #1c1210 0%, #140e0c 45%, #0c0908 100%);
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    opacity: 0.09;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /*
   * Top-down cups that still read as vinyls:
   * concentric rings = grooves / crema / foam.
   */
  .disc {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    animation: spin 48s linear infinite;
  }

  .disc--cappu {
    width: min(58vw, 26rem);
    right: -8%;
    bottom: 8%;
    background:
      radial-gradient(circle at 48% 46%, rgba(90, 48, 22, 0.35) 0 4%, transparent 9%),
      radial-gradient(circle at 52% 52%, rgba(90, 48, 22, 0.22) 0 3%, transparent 8%),
      radial-gradient(
        circle at center,
        #f7efe2 0 11%,
        #efe4d2 11% 13%,
        #f4ebdc 13% 22%,
        #e8dcc6 22% 24%,
        #f2e8d8 24% 34%,
        #d9c4a0 34% 36%,
        #efe3d0 36% 46%,
        transparent 46.5%
      ),
      radial-gradient(circle at center, transparent 0 45%, #4a2814 45.5% 52%, transparent 52.5%),
      radial-gradient(
        circle at center,
        transparent 0 52%,
        #f6efe4 52.5% 58%,
        #e4d6c0 58% 61%,
        transparent 61.5%
      ),
      repeating-radial-gradient(
        circle at center,
        #1a120e 0 0.11rem,
        #0e0a08 0.11rem 0.22rem
      );
    box-shadow:
      0 0 0 0.35rem rgba(196, 163, 90, 0.12),
      0 30px 80px rgba(0, 0, 0, 0.45),
      inset 0 0 2.5rem rgba(246, 240, 230, 0.08);
  }

  .disc--espresso {
    width: min(28vw, 12.5rem);
    /* Parked on the top-left of the big cappuccino, a little crooked */
    right: calc(-8% + min(58vw, 26rem) * 0.42);
    bottom: calc(8% + min(58vw, 26rem) * 0.52);
    opacity: 0.95;
    animation: spin-tilted 64s linear infinite;
    background:
      radial-gradient(circle at center, #1a0e08 0 10%, transparent 10.5%),
      radial-gradient(
        circle at center,
        transparent 0 10%,
        #c4924a 10.5% 16%,
        #8a5a22 16% 18%,
        transparent 18.5%
      ),
      repeating-radial-gradient(
        circle at center,
        #6b3a18 0 0.1rem,
        #4a2810 0.1rem 0.2rem
      ),
      radial-gradient(
        circle at center,
        transparent 0 48%,
        #f3e9da 48.5% 56%,
        #dccdb4 56% 59%,
        transparent 59.5%
      ),
      repeating-radial-gradient(
        circle at center,
        #120c0a 0 0.1rem,
        #080605 0.1rem 0.2rem
      );
    box-shadow:
      0 0 0 0.28rem rgba(196, 163, 90, 0.1),
      0 22px 55px rgba(0, 0, 0, 0.4),
      inset 0 0 1.5rem rgba(196, 140, 70, 0.12);
  }

  .disc-steam {
    position: absolute;
    left: 50%;
    top: 18%;
    width: 2.5rem;
    height: 4.5rem;
    margin-left: -1.25rem;
    pointer-events: none;
    animation: steam-counter 48s linear infinite;
  }

  .disc--espresso .disc-steam {
    animation: steam-counter-tilted 64s linear infinite;
    width: 1.8rem;
    height: 3.4rem;
    margin-left: -0.9rem;
  }

  .disc-steam i {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0.4rem;
    height: 2rem;
    margin-left: -0.2rem;
    border-radius: 999px;
    background: linear-gradient(180deg, transparent, rgba(246, 240, 230, 0.38));
    filter: blur(2px);
    animation: rise 3.8s ease-in-out infinite;
  }

  .disc-steam i:nth-child(2) {
    left: 28%;
    animation-delay: 0.7s;
    height: 1.6rem;
  }

  .disc-steam i:nth-child(3) {
    left: 72%;
    animation-delay: 1.4s;
    height: 1.8rem;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes spin-tilted {
    from {
      transform: rotate(-12deg);
    }
    to {
      transform: rotate(348deg);
    }
  }

  @keyframes steam-counter {
    to {
      transform: rotate(-360deg);
    }
  }

  @keyframes steam-counter-tilted {
    from {
      transform: rotate(12deg);
    }
    to {
      transform: rotate(-348deg);
    }
  }

  @keyframes rise {
    0%,
    100% {
      transform: translateY(0) scaleX(1);
      opacity: 0.12;
    }
    50% {
      transform: translateY(-1.35rem) scaleX(1.4);
      opacity: 0.55;
    }
  }

  @media (max-width: 640px) {
    .disc--cappu {
      right: -14%;
      bottom: 4%;
    }

    .disc--espresso {
      width: min(34vw, 9rem);
      right: calc(-14% + min(58vw, 26rem) * 0.38);
      bottom: calc(4% + min(58vw, 26rem) * 0.48);
      opacity: 0.88;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disc,
    .disc-steam,
    .disc-steam i {
      animation: none;
    }
  }

  .hero-copy {
    padding: 3.5rem 0 3.25rem;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: var(--bi-brass);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .brand-hero {
    margin: 0 0 0.9rem;
    color: var(--bi-foam);
    line-height: 1.05;
  }

  .lead {
    margin: 0 0 1.4rem;
    max-width: 28rem;
    color: rgba(232, 220, 200, 0.82);
    font-size: 1.12rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.2rem;
    border: 1px solid rgba(196, 163, 90, 0.55);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(196, 163, 90, 0.22), rgba(196, 163, 90, 0.08));
    color: var(--bi-foam);
    font-weight: 700;
    text-decoration: none;
  }

  .btn:hover {
    border-color: var(--bi-brass-hot);
    color: var(--bi-brass-hot);
  }

  .block {
    padding: 4.5rem 0;
    border-top: 1px solid rgba(232, 220, 200, 0.08);
  }

  .block h2 {
    margin: 0 0 1rem;
    color: var(--bi-foam);
    font-family: var(--bi-font-display);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 500;
  }

  .block p {
    margin: 0 0 1rem;
    color: rgba(232, 220, 200, 0.8);
    max-width: 36rem;
  }

  .split {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 800px) {
    .split {
      grid-template-columns: 1.3fr 0.9fr;
      align-items: start;
      gap: 2.5rem;
    }
  }

  .panel,
  .map-card {
    padding: 1.35rem 1.4rem;
    border: 1px solid rgba(196, 163, 90, 0.22);
    border-radius: 1.1rem;
    background:
      radial-gradient(ellipse 80% 70% at 20% 0%, rgba(196, 163, 90, 0.12), transparent 55%),
      rgba(36, 24, 20, 0.85);
  }

  .panel-kicker {
    margin: 0 0 0.35rem;
    color: var(--bi-brass);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .panel-title {
    margin: 0 0 0.55rem;
    color: var(--bi-foam);
    font-family: var(--bi-font-display);
    font-size: 1.8rem;
  }

  .panel-note {
    margin: 0;
    color: rgba(232, 220, 200, 0.75);
  }

  .music {
    background:
      radial-gradient(ellipse 50% 60% at 100% 0%, rgba(196, 163, 90, 0.08), transparent 50%),
      var(--bi-espresso);
  }

  .music-lead {
    font-size: 1.12rem;
  }

  .groove-list {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .groove-list li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid rgba(232, 220, 200, 0.1);
    border-radius: 0.9rem;
    background: rgba(36, 24, 20, 0.55);
    color: var(--bi-foam);
  }

  .groove-mark {
    flex: 0 0 auto;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--bi-brass);
    box-shadow: 0 0 0 3px rgba(20, 14, 12, 0.9), 0 0 14px rgba(196, 163, 90, 0.35);
  }

  .find-grid {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 800px) {
    .find-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2.25rem;
    }
  }

  .hours {
    color: var(--bi-brass-hot) !important;
    font-weight: 600;
  }

  .map-link {
    display: block;
    margin: 0.35rem 0 0.85rem;
    color: var(--bi-foam);
    font-family: var(--bi-font-display);
    font-size: 1.45rem;
    text-decoration: none;
    line-height: 1.25;
  }

  .map-link span {
    display: inline-block;
    margin-top: 0.35rem;
    color: var(--bi-brass-hot);
    font-family: var(--bi-font-body);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .map-note {
    margin: 0;
    color: rgba(232, 220, 200, 0.7);
    font-size: 0.92rem;
  }

  .foot {
    border-top: 1px solid rgba(232, 220, 200, 0.08);
    padding: 2.5rem 0 3rem;
  }

  .foot-brand {
    margin: 0 0 0.45rem;
    color: var(--bi-foam);
  }

  .foot-gift {
    margin: 0;
    color: rgba(232, 220, 200, 0.55);
    font-size: 0.92rem;
  }
</style>
