---
import BarItaliaLayout from '../../layouts/BarItaliaLayout.astro';
import BarItaliaMark from '../../components/BarItaliaMark.astro';
---

<BarItaliaLayout>
  <header class="top">
    <div class="shell top-inner">
      <a class="brand" href="/bar-italia"><BarItaliaMark size="nav" /></a>
      <nav class="nav" aria-label="Bar Italia">
        <a href="#coffee">Coffee</a>
        <a href="#music">Music</a>
        <a href="#find">Find us</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-label="Welcome">
      <div class="hero-stage" aria-hidden="true">
        <div class="hero-wash"></div>
        <div class="vinyl vinyl--soft"></div>

        <div class="cup cup--espresso">
          <div class="cup-steam">
            <span></span><span></span>
          </div>
          <div class="cup-handle"></div>
          <div class="cup-bowl">
            <div class="cup-rim"></div>
            <div class="cup-drink cup-drink--espresso"></div>
          </div>
          <div class="cup-saucer"></div>
        </div>

        <div class="cup cup--cappu">
          <div class="cup-steam">
            <span></span><span></span><span></span>
          </div>
          <div class="cup-handle cup-handle--wide"></div>
          <div class="cup-bowl cup-bowl--wide">
            <div class="cup-rim"></div>
            <div class="cup-drink cup-drink--cappu"></div>
            <div class="cup-foam"></div>
          </div>
          <div class="cup-saucer cup-saucer--wide"></div>
        </div>
      </div>
      <div class="shell hero-copy">
        <p class="eyebrow">Kreuzberg · Mehringdamm</p>
        <h1 class="brand-hero"><BarItaliaMark size="hero" /></h1>
        <p class="lead">
          A small Italian espresso bar.<br />
          Care in the cup, and records on the stereo.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#find">Find us</a>
        </div>
      </div>
    </section>

    <section class="block coffee" id="coffee">
      <div class="shell split">
        <div>
          <p class="eyebrow">In the cup</p>
          <h2>Coffee with care</h2>
          <p>
            Alex searched until he found the right beans: Pasucci, roasted by a family in the
            Italian mountains. Elegant and strong, made for a morning that can take its time.
          </p>
          <p>
            Come early if you like. Light through the small windows, the room filling with aroma.
          </p>
        </div>
        <aside class="panel" aria-label="What we love in the cup">
          <p class="panel-kicker">The blend</p>
          <p class="panel-title">Pasucci</p>
          <p class="panel-note">
            Brought back from Italy for Bar Italia. A cup that tastes like someone meant it.
          </p>
        </aside>
      </div>
    </section>

    <section class="block music" id="music">
      <div class="shell">
        <p class="eyebrow">On the stereo</p>
        <h2>Records in the room</h2>
        <p class="music-lead">
          Alex puts on music that shapes the morning. Grooves sit beside the espresso machine
          while the milk steams, and Kreuzberg keeps easy company.
        </p>
      </div>
    </section>

    <section class="block find" id="find">
      <div class="shell find-grid">
        <div>
          <p class="eyebrow">The corner</p>
          <h2>Find us</h2>
          <p>
            Mehringdamm 72<br />
            Entrance on Kreuzbergstraße<br />
            10961 Berlin-Kreuzberg
          </p>
          <p>
            <a href="tel:+493078714417">030 78 71 44 17</a><br />
            <a href="mailto:bar@bar-italia-berlin.de">bar@bar-italia-berlin.de</a>
          </p>
          <p class="hours">
            Mon-Fri 8:00-18:00<br />
            Sat-Sun 10:00-18:00
          </p>
        </div>
        <div class="map-card">
          <p class="panel-kicker">Open the map</p>
          <a
            class="map-link"
            href="https://maps.google.com/?q=Bar+Italia+Mehringdamm+72+Berlin"
            target="_blank"
            rel="noopener noreferrer"
          >
            Mehringdamm 72<br />
            <span>Google Maps →</span>
          </a>
          <p class="map-note">A tiny Italy on the corner. Look for the entrance on Kreuzbergstraße.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="shell foot-inner">
      <p class="foot-brand"><BarItaliaMark size="foot" /></p>
      <p class="foot-gift">
        A small surprise site for Alex, from a friend on two wheels.
      </p>
    </div>
  </footer>
</BarItaliaLayout>

<style>
  .shell {
    width: min(44rem, calc(100% - 2.4rem));
    margin: 0 auto;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: rgba(20, 14, 12, 0.78);
    border-bottom: 1px solid rgba(232, 220, 200, 0.08);
  }

  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
  }

  .brand {
    color: var(--bi-foam);
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .nav a {
    color: rgba(232, 220, 200, 0.72);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--bi-brass-hot);
  }

  .hero {
    position: relative;
    min-height: calc(100vh - 3.5rem);
    min-height: calc(100dvh - 3.5rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 55% at 18% 20%, rgba(196, 163, 90, 0.16), transparent 55%),
      radial-gradient(ellipse 60% 50% at 88% 70%, rgba(90, 40, 28, 0.45), transparent 60%),
      linear-gradient(165deg, #1c1210 0%, #140e0c 45%, #0c0908 100%);
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    opacity: 0.09;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* Soft vinyl still spinning far back */
  .vinyl--soft {
    position: absolute;
    width: min(48vw, 22rem);
    aspect-ratio: 1;
    right: -12%;
    top: 8%;
    border-radius: 50%;
    opacity: 0.35;
    background:
      radial-gradient(circle at center, #2a1c14 0 12%, transparent 12.5%),
      repeating-radial-gradient(
        circle at center,
        #0a0706 0 0.12rem,
        #15100e 0.12rem 0.24rem
      );
    box-shadow: 0 0 0 0.3rem rgba(196, 163, 90, 0.08);
    animation: spin 64s linear infinite;
  }

  .cup {
    position: absolute;
    pointer-events: none;
    filter: drop-shadow(0 28px 40px rgba(0, 0, 0, 0.45));
  }

  .cup--espresso {
    left: 6%;
    bottom: 14%;
    width: min(22vw, 9.5rem);
    transform: rotate(-8deg);
    animation: cup-bob 7s ease-in-out infinite;
  }

  .cup--cappu {
    right: 4%;
    bottom: 10%;
    width: min(34vw, 15rem);
    transform: rotate(6deg);
    animation: cup-bob 8.5s ease-in-out infinite reverse;
  }

  .cup-bowl {
    position: relative;
    z-index: 2;
    width: 78%;
    margin: 0 auto;
    aspect-ratio: 1.15 / 1;
    border-radius: 12% 12% 42% 42% / 8% 8% 72% 72%;
    background:
      linear-gradient(160deg, #f7f0e4 0%, #e8dcc8 45%, #cfc0a8 100%);
    box-shadow:
      inset 0 0.15em 0.35em rgba(255, 255, 255, 0.55),
      inset 0 -0.35em 0.55em rgba(80, 50, 30, 0.18);
    overflow: hidden;
  }

  .cup-bowl--wide {
    width: 82%;
    aspect-ratio: 1.25 / 1;
    border-radius: 14% 14% 40% 40% / 10% 10% 68% 68%;
  }

  .cup-rim {
    position: absolute;
    top: 0;
    left: 4%;
    right: 4%;
    height: 14%;
    border-radius: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(232, 220, 200, 0.15));
    box-shadow: 0 0.08em 0.2em rgba(0, 0, 0, 0.12);
  }

  .cup-drink {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 18%;
    bottom: 12%;
    border-radius: 40% 40% 46% 46% / 20% 20% 70% 70%;
  }

  .cup-drink--espresso {
    background:
      radial-gradient(ellipse 70% 45% at 50% 18%, rgba(196, 140, 70, 0.85), transparent 55%),
      linear-gradient(180deg, #5c3418 0%, #2a160c 55%, #1a0e08 100%);
    box-shadow: inset 0 0.2em 0.35em rgba(0, 0, 0, 0.35);
  }

  .cup-drink--cappu {
    background: linear-gradient(180deg, #6b3a1a 0%, #3a1e10 60%, #24140c 100%);
  }

  .cup-foam {
    position: absolute;
    left: 9%;
    right: 9%;
    top: 16%;
    height: 38%;
    border-radius: 50% 50% 42% 42%;
    background:
      radial-gradient(circle at 42% 48%, rgba(120, 70, 35, 0.28) 0 10%, transparent 18%),
      radial-gradient(circle at 58% 42%, rgba(120, 70, 35, 0.18) 0 7%, transparent 14%),
      radial-gradient(ellipse 80% 70% at 50% 40%, #fff8ee 0%, #f0e4d0 55%, #e2d2b8 100%);
    box-shadow: inset 0 -0.15em 0.25em rgba(140, 90, 40, 0.15);
  }

  .cup-handle {
    position: absolute;
    z-index: 1;
    right: 2%;
    top: 28%;
    width: 28%;
    height: 38%;
    border: 0.28em solid #e4d6c0;
    border-left: 0;
    border-radius: 0 70% 70% 0 / 0 55% 55% 0;
    box-shadow: inset -0.08em 0 0.1em rgba(255, 255, 255, 0.35);
  }

  .cup-handle--wide {
    right: 0;
    top: 26%;
    width: 30%;
    height: 42%;
    border-width: 0.32em;
  }

  .cup-saucer {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 0.55em;
    margin-top: -0.15em;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at center, #f4ebe0 0%, #d9cbb4 55%, #b8a48a 100%);
    box-shadow:
      0 0.35em 0.7em rgba(0, 0, 0, 0.35),
      inset 0 0.08em 0.15em rgba(255, 255, 255, 0.4);
  }

  .cup-saucer--wide {
    height: 0.7em;
  }

  .cup-steam {
    position: absolute;
    left: 50%;
    bottom: 72%;
    width: 2.4em;
    height: 4.5em;
    margin-left: -1.2em;
    pointer-events: none;
  }

  .cup--cappu .cup-steam {
    width: 3.2em;
    height: 5.5em;
    margin-left: -1.6em;
  }

  .cup-steam span {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0.45em;
    height: 2.4em;
    margin-left: -0.22em;
    border-radius: 999px;
    background: linear-gradient(180deg, transparent, rgba(246, 240, 230, 0.42));
    filter: blur(2px);
    animation: rise 3.8s ease-in-out infinite;
  }

  .cup-steam span:nth-child(2) {
    left: 28%;
    animation-delay: 0.8s;
    height: 2em;
  }

  .cup-steam span:nth-child(3) {
    left: 72%;
    animation-delay: 1.5s;
    height: 2.2em;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes rise {
    0%,
    100% {
      transform: translateY(0) scaleX(1);
      opacity: 0.12;
    }
    50% {
      transform: translateY(-1.5rem) scaleX(1.45);
      opacity: 0.55;
    }
  }

  @keyframes cup-bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -0.45rem;
    }
  }

  @media (max-width: 640px) {
    .cup--espresso {
      left: -2%;
      bottom: 18%;
      width: min(34vw, 7.5rem);
      opacity: 0.85;
    }

    .cup--cappu {
      right: -4%;
      bottom: 8%;
      width: min(48vw, 11rem);
    }

    .vinyl--soft {
      opacity: 0.22;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl--soft,
    .cup-steam span,
    .cup--espresso,
    .cup--cappu {
      animation: none;
    }
  }

  .hero-copy {
    padding: 3.5rem 0 3.25rem;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: var(--bi-brass);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .brand-hero {
    margin: 0 0 0.9rem;
    color: var(--bi-foam);
    line-height: 1.05;
  }

  .lead {
    margin: 0 0 1.4rem;
    max-width: 28rem;
    color: rgba(232, 220, 200, 0.82);
    font-size: 1.12rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.2rem;
    border: 1px solid rgba(196, 163, 90, 0.55);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(196, 163, 90, 0.22), rgba(196, 163, 90, 0.08));
    color: var(--bi-foam);
    font-weight: 700;
    text-decoration: none;
  }

  .btn:hover {
    border-color: var(--bi-brass-hot);
    color: var(--bi-brass-hot);
  }

  .block {
    padding: 4.5rem 0;
    border-top: 1px solid rgba(232, 220, 200, 0.08);
  }

  .block h2 {
    margin: 0 0 1rem;
    color: var(--bi-foam);
    font-family: var(--bi-font-display);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 500;
  }

  .block p {
    margin: 0 0 1rem;
    color: rgba(232, 220, 200, 0.8);
    max-width: 36rem;
  }

  .split {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 800px) {
    .split {
      grid-template-columns: 1.3fr 0.9fr;
      align-items: start;
      gap: 2.5rem;
    }
  }

  .panel,
  .map-card {
    padding: 1.35rem 1.4rem;
    border: 1px solid rgba(196, 163, 90, 0.22);
    border-radius: 1.1rem;
    background:
      radial-gradient(ellipse 80% 70% at 20% 0%, rgba(196, 163, 90, 0.12), transparent 55%),
      rgba(36, 24, 20, 0.85);
  }

  .panel-kicker {
    margin: 0 0 0.35rem;
    color: var(--bi-brass);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .panel-title {
    margin: 0 0 0.55rem;
    color: var(--bi-foam);
    font-family: var(--bi-font-display);
    font-size: 1.8rem;
  }

  .panel-note {
    margin: 0;
    color: rgba(232, 220, 200, 0.75);
  }

  .music {
    background:
      radial-gradient(ellipse 50% 60% at 100% 0%, rgba(196, 163, 90, 0.08), transparent 50%),
      var(--bi-espresso);
  }

  .music-lead {
    font-size: 1.12rem;
  }

  .groove-list {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .groove-list li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid rgba(232, 220, 200, 0.1);
    border-radius: 0.9rem;
    background: rgba(36, 24, 20, 0.55);
    color: var(--bi-foam);
  }

  .groove-mark {
    flex: 0 0 auto;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--bi-brass);
    box-shadow: 0 0 0 3px rgba(20, 14, 12, 0.9), 0 0 14px rgba(196, 163, 90, 0.35);
  }

  .find-grid {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 800px) {
    .find-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2.25rem;
    }
  }

  .hours {
    color: var(--bi-brass-hot) !important;
    font-weight: 600;
  }

  .map-link {
    display: block;
    margin: 0.35rem 0 0.85rem;
    color: var(--bi-foam);
    font-family: var(--bi-font-display);
    font-size: 1.45rem;
    text-decoration: none;
    line-height: 1.25;
  }

  .map-link span {
    display: inline-block;
    margin-top: 0.35rem;
    color: var(--bi-brass-hot);
    font-family: var(--bi-font-body);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .map-note {
    margin: 0;
    color: rgba(232, 220, 200, 0.7);
    font-size: 0.92rem;
  }

  .foot {
    border-top: 1px solid rgba(232, 220, 200, 0.08);
    padding: 2.5rem 0 3rem;
  }

  .foot-brand {
    margin: 0 0 0.45rem;
    color: var(--bi-foam);
  }

  .foot-gift {
    margin: 0;
    color: rgba(232, 220, 200, 0.55);
    font-size: 0.92rem;
  }
</style>
