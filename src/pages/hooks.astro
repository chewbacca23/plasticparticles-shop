---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hooks"
  description="The Soul Searchers marketplace. Every stall on one floor — A, B, C, the lot."
>
  <section class="section">
    <div class="site-shell hooks">
      <p class="eyebrow">Hooks</p>
      <h1 class="section-title">The marketplace</h1>
      <p class="section-lead">
        The whole floor. A’s stall, B’s offer, C’s spare sofa. Browse the lot, then leave your own.
        Pick any name. Email is optional and never sits on the page.
      </p>

      <p id="board-error" class="error" hidden></p>
      <p id="board-hint" class="hint" hidden></p>

      <ol id="hook-list" class="market">
        <li class="empty">The market is empty. Open the first stall.</li>
      </ol>

      <div id="pin-success" class="success" hidden>
        <h2>It’s on the floor</h2>
        <p>If you left a mail, offers can also land in your inbox. Either way, they show here.</p>
      </div>

      <form id="pin-form" class="form" method="post" action="/api/hooks">
        <h2 class="form-title">Open a stall</h2>
        <label>
          <span>A name — any name</span>
          <input type="text" name="name" required maxlength="80" placeholder="The dog, Alex, nobody" />
        </label>
        <label>
          <span>Where</span>
          <input
            type="text"
            name="place"
            required
            maxlength="80"
            placeholder="Berlin, Nice, a train, a climb"
          />
        </label>
        <label>
          <span>The offer</span>
          <textarea
            name="note"
            rows="3"
            required
            maxlength="400"
            placeholder="Spare room in Kreuzberg. Looking for the Madeleine. Old 28mm tires, take them."
          ></textarea>
        </label>
        <label>
          <span>Email — optional, stays off the page</span>
          <input type="email" name="email" autocomplete="email" maxlength="200" />
        </label>
        <label class="hp" aria-hidden="true">
          <span>Company</span>
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
        <button class="btn btn-primary" type="submit">Put it on the floor</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var list = document.getElementById('hook-list');
    var pinForm = document.getElementById('pin-form');
    var pinSuccess = document.getElementById('pin-success');
    var errorBox = document.getElementById('board-error');
    var hintBox = document.getElementById('board-hint');
    var canModerate = false;

    function showError(text) {
      if (!errorBox) return;
      errorBox.textContent = text || 'Could not do that just now.';
      errorBox.hidden = false;
    }

    function hideError() {
      if (!errorBox) return;
      errorBox.hidden = true;
      errorBox.textContent = '';
    }

    function esc(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function flatten(hooks) {
      var cards = [];
      (hooks || []).forEach(function (hook) {
        cards.push({
          kind: 'stall',
          id: hook.id,
          hookId: hook.id,
          name: hook.name,
          place: hook.place,
          note: hook.note,
          at: hook.at,
          offerCount: (hook.offers || []).length,
        });
        (hook.offers || []).forEach(function (offer) {
          cards.push({
            kind: 'offer',
            id: offer.id,
            hookId: hook.id,
            name: offer.name,
            place: hook.place,
            forName: hook.name,
            note: offer.note,
            at: offer.at,
          });
        });
      });
      cards.sort(function (a, b) {
        return String(b.at || '').localeCompare(String(a.at || ''));
      });
      return cards;
    }

    function cardsFrom(payload) {
      if (payload && payload.market) return payload.market;
      return flatten(payload && payload.hooks);
    }

    function writeForm(hookId) {
      return (
        '<form class="write-form" hidden data-for="' +
        esc(hookId) +
        '">' +
        '<label><span>A name — any name</span><input type="text" name="name" required maxlength="80" /></label>' +
        '<label><span>Your offer</span><textarea name="message" rows="3" required maxlength="2000"></textarea></label>' +
        '<label><span>Email — optional</span><input type="email" name="email" maxlength="200" /></label>' +
        '<label class="hp" aria-hidden="true"><span>Company</span><input type="text" name="company" tabindex="-1" autocomplete="off" /></label>' +
        '<button class="btn btn-primary" type="submit">Leave offer</button>' +
        '</form>'
      );
    }

    function renderCard(card) {
      var isStall = card.kind !== 'offer';
      var hookId = card.hookId || card.id;
      var remove =
        canModerate && isStall
          ? '<button type="button" class="hook-remove" data-remove="' +
            esc(hookId) +
            '">Take down</button>'
          : '';
      var kind = isStall ? 'Stall' : 'Offer';
      var forLine = !isStall && card.forName
        ? '<p class="card-for">for ' + esc(card.forName) + '</p>'
        : isStall && card.offerCount
          ? '<p class="card-for">' +
            card.offerCount +
            (card.offerCount === 1 ? ' offer on the floor' : ' offers on the floor') +
            '</p>'
          : '';
      return (
        '<li class="card card-' +
        (isStall ? 'stall' : 'offer') +
        '" data-id="' +
        esc(card.id) +
        '">' +
        '<p class="card-kind">' +
        kind +
        '</p>' +
        '<p class="hook-place">' +
        esc(card.place) +
        '</p>' +
        '<h2 class="hook-name">' +
        esc(card.name) +
        '</h2>' +
        forLine +
        '<p class="hook-note">' +
        esc(card.note) +
        '</p>' +
        '<button type="button" class="btn btn-ghost hook-write" data-write="' +
        esc(hookId) +
        '">' +
        (isStall ? 'Make an offer' : 'Offer on that stall') +
        '</button>' +
        remove +
        writeForm(hookId) +
        '</li>'
      );
    }

    function render(payload) {
      if (!list) return;
      var cards = cardsFrom(payload);
      if (!cards.length) {
        list.innerHTML = '<li class="empty">The market is empty. Open the first stall.</li>';
        return;
      }
      list.innerHTML = cards.map(renderCard).join('');
    }

    function load() {
      fetch('/api/hooks', { headers: { accept: 'application/json' } })
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          canModerate = !!(data && data.canModerate);
          if (hintBox && data && data.mailWired === false) {
            hintBox.hidden = false;
            hintBox.textContent =
              'Mail is not wired yet. Offers still show on the floor.';
          }
          render(data);
        })
        .catch(function () {
          showError('The board could not load just now.');
        });
    }

    if (pinForm) {
      pinForm.addEventListener('submit', function (event) {
        event.preventDefault();
        hideError();
        var data = new FormData(pinForm);
        var button = pinForm.querySelector('button[type="submit"]');
        if (button) button.disabled = true;
        fetch('/api/hooks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: String(data.get('name') || '').trim(),
            place: String(data.get('place') || '').trim(),
            note: String(data.get('note') || '').trim(),
            email: String(data.get('email') || '').trim(),
            company: String(data.get('company') || '').trim(),
          }),
        })
          .then(function (res) {
            return res.json().then(function (body) {
              return { res: res, body: body };
            });
          })
          .then(function (out) {
            if (out.res.ok && out.body.ok) {
              pinForm.hidden = true;
              if (pinSuccess) pinSuccess.hidden = false;
              render(out.body);
              return;
            }
            showError((out.body && out.body.error) || 'Could not pin that just now.');
          })
          .catch(function () {
            showError('Could not pin that just now.');
          })
          .finally(function () {
            if (button) button.disabled = false;
          });
      });
    }

    if (list) {
      list.addEventListener('click', function (event) {
        var write = event.target.closest('[data-write]');
        if (write) {
          var card = write.closest('.card');
          var form = card && card.querySelector('[data-for="' + write.getAttribute('data-write') + '"]');
          if (form) form.hidden = !form.hidden;
          return;
        }
        var remove = event.target.closest('[data-remove]');
        if (!remove) return;
        hideError();
        fetch('/api/hooks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'remove', id: remove.getAttribute('data-remove') }),
        })
          .then(function (res) {
            return res.json();
          })
          .then(function (body) {
            if (body && body.ok) {
              render(body);
              return;
            }
            showError((body && body.error) || 'Could not take that down.');
          })
          .catch(function () {
            showError('Could not take that down.');
          });
      });

      list.addEventListener('submit', function (event) {
        var form = event.target.closest('.write-form');
        if (!form) return;
        event.preventDefault();
        hideError();
        var data = new FormData(form);
        var button = form.querySelector('button[type="submit"]');
        if (button) button.disabled = true;
        fetch('/api/hooks/write', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            hookId: form.getAttribute('data-for'),
            name: String(data.get('name') || '').trim(),
            email: String(data.get('email') || '').trim(),
            message: String(data.get('message') || '').trim(),
            company: String(data.get('company') || '').trim(),
          }),
        })
          .then(function (res) {
            return res.json().then(function (body) {
              return { res: res, body: body };
            });
          })
          .then(function (out) {
            if (out.res.ok && out.body.ok) {
              form.hidden = true;
              form.reset();
              render(out.body);
              return;
            }
            showError((out.body && out.body.error) || 'Could not leave that offer.');
          })
          .catch(function () {
            showError('Could not leave that offer.');
          })
          .finally(function () {
            if (button) button.disabled = false;
          });
      });
    }

    load();
  })();
</script>

<style>
  .hooks {
    max-width: 64rem;
  }

  .form,
  .write-form {
    display: grid;
    gap: 1rem;
  }

  .form {
    max-width: 36rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(215, 224, 232, 0.12);
  }

  .form-title {
    margin: 0;
    font-size: 1.45rem;
  }

  .form[hidden],
  .write-form[hidden],
  .success[hidden],
  .error[hidden],
  .hint[hidden] {
    display: none !important;
  }

  label {
    display: grid;
    gap: 0.4rem;
  }

  label span {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(215, 224, 232, 0.72);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(215, 224, 232, 0.18);
    border-radius: 0.85rem;
    background: rgba(26, 36, 48, 0.7);
    color: var(--paper);
    font: inherit;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid rgba(212, 163, 90, 0.55);
    outline-offset: 2px;
    border-color: var(--amber);
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .market {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.15rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .market {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .market {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid rgba(215, 224, 232, 0.1);
    border-radius: 1rem;
    background: rgba(18, 26, 34, 0.55);
    min-height: 100%;
  }

  .card-offer {
    border-color: rgba(212, 163, 90, 0.22);
    background: rgba(28, 24, 16, 0.55);
  }

  .card-kind {
    margin: 0 0 0.55rem;
    color: rgba(215, 224, 232, 0.55);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .card-for {
    margin: 0.25rem 0 0;
    color: var(--amber);
    font-size: 0.88rem;
  }

  .hook-place {
    margin: 0;
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hook-name {
    margin: 0.35rem 0 0;
    font-size: 1.35rem;
  }

  .hook-note {
    margin: 0.45rem 0 0.9rem;
    color: rgba(215, 224, 232, 0.78);
  }

  .hook-sent {
    margin: 0.85rem 0 0;
    color: var(--amber-hot);
  }

  .offer-list {
    margin: 0 0 0.9rem;
    padding: 0.75rem 0 0;
    list-style: none;
    border-top: 1px solid rgba(215, 224, 232, 0.08);
    display: grid;
    gap: 0.75rem;
  }

  .offer-name {
    margin: 0;
    color: var(--paper);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .offer-note {
    margin: 0.2rem 0 0;
    color: rgba(215, 224, 232, 0.72);
  }

  .offer-empty {
    margin: 0 0 0.85rem;
    color: rgba(215, 224, 232, 0.5);
    font-size: 0.92rem;
  }

  .write-form {
    margin-top: 1rem;
  }

  .hook-remove {
    margin-left: 0.6rem;
    border: 0;
    background: none;
    color: rgba(215, 224, 232, 0.55);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .empty {
    grid-column: 1 / -1;
    color: rgba(215, 224, 232, 0.72);
  }

  .success {
    margin: 1.5rem 0 0;
    padding: 1.1rem 1.15rem;
    border: 1px solid rgba(212, 163, 90, 0.35);
    border-radius: 1rem;
  }

  .success h2 {
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
  }

  .success p {
    margin: 0;
    color: rgba(215, 224, 232, 0.78);
  }

  .error {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(220, 90, 90, 0.45);
    border-radius: 0.85rem;
    background: rgba(80, 24, 24, 0.35);
    color: rgba(255, 220, 220, 0.92);
  }

  .hint {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(215, 224, 232, 0.14);
    border-radius: 0.85rem;
    color: rgba(215, 224, 232, 0.78);
  }
</style>
