---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MiloFirstDive from '../../components/MiloFirstDive.astro';
import { MILO_REALMS, miloRealmById } from '../../lib/milo-realms';

export function getStaticPaths() {
  return MILO_REALMS.map((realm) => ({ params: { realm: realm.id } }));
}

const { realm: realmId } = Astro.params;
const realm = miloRealmById(String(realmId || ''));
if (!realm) {
  return Astro.redirect('/milo');
}

const figureSrc = `/milo/${realm.figure}.png`;
const isFirstDive = realm.id === 'underwater';
---

<BaseLayout
  title={`${realm.title} · Milo`}
  description={realm.lead}
  robots="noindex, nofollow"
  watermark={false}
>
  {isFirstDive ? (
    <MiloFirstDive />
  ) : (
  <section
    class:list={['realm', `realm--${realm.theme}`, Astro.url.searchParams.get('from') === 'cube' && 'realm--from-cube']}
    style={`--realm-hue:${realm.hue};--realm-accent:${realm.accent}`}
    data-realm={realm.id}
  >
    <div class="realm-fx" aria-hidden="true">
      {
        realm.theme === 'underwater' && (
          <>
            <span class="bubble" />
            <span class="bubble" />
            <span class="bubble" />
            <span class="kelp" />
            <span class="kelp kelp--2" />
            <span class="caustic" />
          </>
        )
      }
      {
        realm.theme === 'island' && (
          <>
            <span class="sun" />
            <span class="wave" />
            <span class="wave wave--2" />
            <span class="palm" />
          </>
        )
      }
      {
        realm.theme === 'moon' && (
          <>
            <span class="earth" />
            <span class="crater" />
            <span class="crater crater--2" />
            <span class="dust" />
          </>
        )
      }
      {
        realm.theme === 'sand' && (
          <>
            <span class="dune" />
            <span class="dune dune--2" />
            <span class="heat" />
          </>
        )
      }
      {
        realm.theme === 'cloud' && (
          <>
            <span class="cloud-bank" />
            <span class="cloud-bank cloud-bank--2" />
            <span class="rail" />
          </>
        )
      }
      {
        realm.theme === 'ember' && (
          <>
            <span class="lava" />
            <span class="spark" />
            <span class="spark spark--2" />
            <span class="spark spark--3" />
          </>
        )
      }
    </div>

    <div class="realm-stage">
      <img
        class="realm-milo"
        src={figureSrc}
        alt="Milo the explorer"
        width="280"
        height="280"
        decoding="async"
      />
    </div>

    <div class="realm-copy">
      <p class="realm-kicker">{realm.kicker}</p>
      <h1 class="realm-title">{realm.title}</h1>
      <p class="realm-lead">{realm.lead}</p>
      <p class="realm-detail">{realm.detail}</p>
      <p class="realm-actions">
        <a class="realm-back" href="/milo">← Back to the cube</a>
      </p>
    </div>
  </section>
  )}
</BaseLayout>

<style>
  :global(body:has(.realm)) {
    background: #05080c;
  }

  :global(body:has(.realm) .header),
  :global(body:has(.realm) .footer),
  :global(body:has(.realm) .logo-backdrop) {
    display: none;
  }

  .realm {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    align-content: end;
    overflow: hidden;
    color: var(--paper, #eef3f7);
    background: var(--realm-hue);
  }

  .realm--from-cube {
    animation: realm-in 0.55s ease both;
  }

  @keyframes realm-in {
    from {
      opacity: 0.35;
      filter: saturate(0.7);
    }
    to {
      opacity: 1;
      filter: none;
    }
  }

  .realm-fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .realm-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding-bottom: 18vh;
  }

  .realm-milo {
    width: min(42vw, 16rem);
    height: auto;
    filter: drop-shadow(0 1.2rem 1.6rem rgba(0, 0, 0, 0.45));
    animation: milo-bob 4.2s ease-in-out infinite;
    image-rendering: auto;
  }

  @keyframes milo-bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -0.65rem;
    }
  }

  .realm-copy {
    position: relative;
    z-index: 2;
    width: min(36rem, calc(100% - 2rem));
    margin: 0 auto 1.5rem;
    padding: 1.25rem 1.2rem 1.35rem;
    border: 1px solid color-mix(in srgb, var(--realm-accent) 40%, transparent);
    background: rgba(8, 12, 17, 0.55);
    backdrop-filter: blur(10px);
  }

  .realm-kicker {
    margin: 0;
    color: color-mix(in srgb, var(--realm-accent) 85%, white 15%);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .realm-title {
    margin: 0.35rem 0 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 0.95;
  }

  .realm-lead,
  .realm-detail {
    margin: 0 0 0.75rem;
    max-width: 34em;
    color: rgba(238, 243, 247, 0.9);
  }

  .realm-detail {
    color: rgba(215, 224, 232, 0.72);
  }

  .realm-actions {
    margin: 1rem 0 0;
  }

  .realm-back {
    color: var(--realm-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .realm-back:hover {
    text-decoration: underline;
  }

  /* —— Underwater —— */
  .realm--underwater {
    background:
      radial-gradient(ellipse 90% 60% at 50% 0%, rgba(70, 180, 210, 0.35), transparent 55%),
      linear-gradient(180deg, #123a4a 0%, #0a2430 42%, #061820 100%);
  }

  .realm--underwater .bubble {
    position: absolute;
    bottom: 8%;
    left: 18%;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 1px solid rgba(180, 230, 245, 0.55);
    animation: rise 7s linear infinite;
  }

  .realm--underwater .bubble:nth-child(2) {
    left: 48%;
    width: 0.35rem;
    height: 0.35rem;
    animation-duration: 9s;
    animation-delay: -2s;
  }

  .realm--underwater .bubble:nth-child(3) {
    left: 72%;
    width: 0.7rem;
    height: 0.7rem;
    animation-duration: 8s;
    animation-delay: -4s;
  }

  @keyframes rise {
    from {
      translate: 0 0;
      opacity: 0.7;
    }
    to {
      translate: 2rem -85vh;
      opacity: 0;
    }
  }

  .realm--underwater .kelp {
    position: absolute;
    bottom: -4%;
    left: 8%;
    width: 1.4rem;
    height: 42vh;
    border-radius: 2rem;
    background: linear-gradient(180deg, transparent, rgba(40, 120, 90, 0.55));
    transform-origin: bottom center;
    animation: sway 5s ease-in-out infinite;
  }

  .realm--underwater .kelp--2 {
    left: auto;
    right: 12%;
    height: 36vh;
    animation-delay: -1.5s;
  }

  @keyframes sway {
    0%,
    100% {
      rotate: -4deg;
    }
    50% {
      rotate: 5deg;
    }
  }

  .realm--underwater .caustic {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 30% 18% at 30% 25%, rgba(150, 230, 255, 0.12), transparent 60%),
      radial-gradient(ellipse 24% 14% at 70% 35%, rgba(150, 230, 255, 0.1), transparent 60%);
    animation: caustic 6s ease-in-out infinite alternate;
  }

  @keyframes caustic {
    from {
      opacity: 0.55;
      scale: 1;
    }
    to {
      opacity: 1;
      scale: 1.05;
    }
  }

  .realm--underwater .realm-milo {
    animation: milo-swim 5s ease-in-out infinite;
  }

  @keyframes milo-swim {
    0%,
    100% {
      translate: 0 0 rotate(-2deg);
    }
    50% {
      translate: 0.4rem -1rem rotate(2deg);
    }
  }

  /* —— Island —— */
  .realm--island {
    background:
      radial-gradient(ellipse 50% 35% at 75% 18%, rgba(240, 194, 122, 0.45), transparent 60%),
      linear-gradient(180deg, #4aa3c4 0%, #6eb8c9 38%, #c9b07a 38.2%, #c2a06a 58%, #2f6b5a 58.2%, #1e4a40 100%);
  }

  .realm--island .sun {
    position: absolute;
    top: 10%;
    right: 14%;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff3c4, #e8a83a 70%);
    box-shadow: 0 0 4rem rgba(240, 194, 122, 0.45);
  }

  .realm--island .wave {
    position: absolute;
    left: -10%;
    top: 36%;
    width: 120%;
    height: 2.5rem;
    background: repeating-linear-gradient(
      -8deg,
      transparent 0 1.2rem,
      rgba(238, 243, 247, 0.22) 1.2rem 1.45rem
    );
    opacity: 0.55;
    animation: drift 10s linear infinite;
  }

  .realm--island .wave--2 {
    top: 39%;
    opacity: 0.35;
    animation-duration: 14s;
    animation-direction: reverse;
  }

  @keyframes drift {
    from {
      translate: 0 0;
    }
    to {
      translate: -3rem 0;
    }
  }

  .realm--island .palm {
    position: absolute;
    bottom: 28%;
    left: 10%;
    width: 0.55rem;
    height: 18vh;
    background: #5a3a22;
    border-radius: 0.3rem;
  }

  .realm--island .palm::before {
    content: '';
    position: absolute;
    top: -0.4rem;
    left: -2.2rem;
    width: 5rem;
    height: 2.4rem;
    background: radial-gradient(ellipse at center, #2f7a4a 0 40%, transparent 42%);
    opacity: 0.9;
  }

  /* —— Moon —— */
  .realm--moon {
    background:
      radial-gradient(circle at 18% 22%, rgba(215, 224, 232, 0.2), transparent 28%),
      radial-gradient(ellipse 80% 50% at 50% 100%, #3a3f48, transparent 55%),
      #070a10;
  }

  .realm--moon .earth {
    position: absolute;
    top: 14%;
    right: 16%;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 35%, #7ec8e8, #2a6b8a 55%, #1a3040 78%);
    box-shadow: 0 0 2rem rgba(126, 200, 232, 0.35);
  }

  .realm--moon .crater {
    position: absolute;
    bottom: 26%;
    left: 22%;
    width: 4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.28);
    box-shadow: inset 0 0.2rem 0.4rem rgba(255, 255, 255, 0.06);
  }

  .realm--moon .crater--2 {
    left: 58%;
    bottom: 22%;
    width: 6rem;
    height: 1.8rem;
  }

  .realm--moon .dust {
    position: absolute;
    inset: auto 0 0;
    height: 32%;
    background: linear-gradient(180deg, transparent, rgba(180, 185, 195, 0.18));
  }

  /* —— Sand Sea —— */
  .realm--sand {
    background:
      radial-gradient(ellipse 60% 40% at 70% 20%, rgba(240, 194, 122, 0.35), transparent 60%),
      linear-gradient(180deg, #c48a4a 0%, #a07038 45%, #6a4828 100%);
  }

  .realm--sand .dune {
    position: absolute;
    bottom: 18%;
    left: -10%;
    width: 70%;
    height: 28%;
    border-radius: 50% 50% 0 0;
    background: linear-gradient(180deg, #d4a35a, #8a5a30);
    opacity: 0.85;
  }

  .realm--sand .dune--2 {
    left: 35%;
    width: 80%;
    height: 34%;
    bottom: 12%;
    opacity: 0.95;
    background: linear-gradient(180deg, #e0b06a, #7a4e28);
  }

  .realm--sand .heat {
    position: absolute;
    inset: 20% 10% 40%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
    filter: blur(12px);
    animation: heat 4s ease-in-out infinite alternate;
  }

  @keyframes heat {
    from {
      opacity: 0.3;
      translate: -1rem 0;
    }
    to {
      opacity: 0.7;
      translate: 1rem 0;
    }
  }

  /* —— Cloud Rail —— */
  .realm--cloud {
    background:
      radial-gradient(ellipse 50% 40% at 50% 0%, rgba(240, 194, 122, 0.25), transparent 55%),
      linear-gradient(180deg, #5a7a9a 0%, #8aa8c0 55%, #c8d4e0 100%);
  }

  .realm--cloud .cloud-bank {
    position: absolute;
    top: 28%;
    left: -5%;
    width: 55%;
    height: 18%;
    border-radius: 4rem;
    background: rgba(238, 243, 247, 0.72);
    filter: blur(2px);
    animation: cloud-drift 18s linear infinite;
  }

  .realm--cloud .cloud-bank--2 {
    top: 42%;
    left: 40%;
    width: 65%;
    height: 22%;
    animation-duration: 24s;
    animation-delay: -6s;
  }

  @keyframes cloud-drift {
    from {
      translate: 0 0;
    }
    to {
      translate: -8rem 0;
    }
  }

  .realm--cloud .rail {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 58%;
    height: 0.2rem;
    background: linear-gradient(90deg, transparent, rgba(40, 40, 45, 0.55) 15%, rgba(40, 40, 45, 0.55) 85%, transparent);
    box-shadow: 0 0.55rem 0 rgba(40, 40, 45, 0.35);
  }

  /* —— Ember Hollow —— */
  .realm--ember {
    background:
      radial-gradient(ellipse 50% 40% at 50% 85%, rgba(232, 90, 58, 0.45), transparent 60%),
      linear-gradient(180deg, #1a1010 0%, #2a1410 55%, #120808 100%);
  }

  .realm--ember .lava {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 0;
    height: 22%;
    background: radial-gradient(ellipse at 50% 0%, #e85a3a, #8a2010 70%, transparent);
    filter: blur(4px);
    animation: lava 3.5s ease-in-out infinite alternate;
  }

  @keyframes lava {
    from {
      opacity: 0.75;
      scale: 1 1;
    }
    to {
      opacity: 1;
      scale: 1.04 1.08;
    }
  }

  .realm--ember .spark {
    position: absolute;
    bottom: 20%;
    left: 30%;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: #f0c27a;
    animation: spark 4s ease-out infinite;
  }

  .realm--ember .spark--2 {
    left: 55%;
    animation-delay: -1.2s;
  }

  .realm--ember .spark--3 {
    left: 70%;
    animation-delay: -2.4s;
  }

  @keyframes spark {
    from {
      translate: 0 0;
      opacity: 1;
    }
    to {
      translate: -1rem -40vh;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .realm-milo,
    .bubble,
    .kelp,
    .caustic,
    .wave,
    .heat,
    .cloud-bank,
    .lava,
    .spark {
      animation: none !important;
    }
  }
</style>
