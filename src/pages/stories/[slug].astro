---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { galleryMedia } from '../../lib/media';
import { renderMarkdown } from '../../../cloudflare/fresh-ride.js';
import { planRidePhotos } from '../../../cloudflare/story-photos.js';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const photos = galleryMedia(story.data.cover, story.data.gallery);
const plan = planRidePhotos(photos, story.body, story.data.cover);
const storyHtml = renderMarkdown(plan.wovenBody);
---

<BaseLayout title={story.data.title} description={story.data.description} ogType="article">
  <article class="section">
    <div class="site-shell article">
      <p class="eyebrow">Ride</p>
      <h1>{story.data.headline}</h1>
      <p class="dek">{story.data.description}</p>

      {
        plan.hero && (
          <figure class="hero">
            <img src={plan.hero} alt="" width="1200" height="900" loading="eager" />
          </figure>
        )
      }

      <div class="prose" set:html={storyHtml} />

      <p class="back">
        <a href={`/postcard/${story.id}`}>Send this ride</a>
        <a href="/stories">← All rides</a>
      </p>
    </div>

    <dialog class="ride-dialog" data-ride-dialog aria-label="Ride photo">
      <div class="ride-stage">
        <img data-ride-image alt="" />
        <button type="button" class="ride-nav ride-prev" data-ride-prev aria-label="Previous photo">‹</button>
        <button type="button" class="ride-nav ride-next" data-ride-next aria-label="Next photo">›</button>
        <button type="button" class="ride-close" data-ride-close aria-label="Close">×</button>
      </div>
    </dialog>
  </article>
</BaseLayout>

<script>
  const article = document.querySelector('article');
  const dialog = document.querySelector('[data-ride-dialog]');
  const image = document.querySelector('[data-ride-image]');
  const figures = article ? [...article.querySelectorAll('.prose figure')] : [];
  if (article && dialog && image && figures.length) {
    const shots = figures
      .map((figure) => figure.querySelector('img'))
      .filter((img) => img && img.getAttribute('src'));

    function show(index) {
      const shot = shots[(index + shots.length) % shots.length];
      if (!shot) return;
      image.src = shot.getAttribute('src') || '';
      image.alt = shot.getAttribute('alt') || '';
      const hideNav = shots.length < 2;
      const prevBtn = dialog.querySelector('[data-ride-prev]');
      const nextBtn = dialog.querySelector('[data-ride-next]');
      if (prevBtn) prevBtn.hidden = hideNav;
      if (nextBtn) nextBtn.hidden = hideNav;
      if (typeof dialog.showModal === 'function' && !dialog.open) dialog.showModal();
    }

    function step(delta) {
      const src = image.getAttribute('src');
      const index = Math.max(0, shots.findIndex((shot) => shot.getAttribute('src') === src));
      show(index + delta);
    }

    figures.forEach((figure, index) => {
      figure.setAttribute('role', 'button');
      figure.tabIndex = 0;
      figure.setAttribute('aria-label', `Open photo ${index + 1} of ${figures.length}`);
      figure.addEventListener('click', () => show(index));
      figure.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        show(index);
      });
    });

    const prev = dialog.querySelector('[data-ride-prev]');
    const next = dialog.querySelector('[data-ride-next]');
    if (prev) {
      prev.addEventListener('click', (event) => {
        event.stopPropagation();
        step(-1);
      });
    }
    if (next) {
      next.addEventListener('click', (event) => {
        event.stopPropagation();
        step(1);
      });
    }
    const close = dialog.querySelector('[data-ride-close]');
    if (close) close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });
  }
</script>

<style>
  .article {
    max-width: 52rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4.5vw, 3.1rem);
  }

  .dek {
    margin: 0 0 1.75rem;
    color: rgba(215, 224, 232, 0.75);
    font-size: 1.1rem;
  }

  .hero {
    margin: 0 0 2rem;
    overflow: hidden;
    border-radius: 0.9rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }

  .hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  .prose {
    max-width: 42rem;
  }

  .prose :global(figure) {
    float: right;
    clear: right;
    width: min(38%, 12rem);
    margin: 0.15rem 0 1rem 1.15rem;
    overflow: hidden;
    border-radius: 0.7rem;
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.28);
    cursor: pointer;
  }

  .prose :global(figure img) {
    margin: 0;
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    box-shadow: none;
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose::after {
    content: '';
    display: table;
    clear: both;
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.4rem;
    margin-top: 2.75rem;
  }

  .back a {
    color: var(--amber-hot);
    text-decoration: none;
    font-weight: 600;
  }

  .ride-dialog {
    width: min(100% - 1.25rem, 68rem);
    max-width: 68rem;
    padding: 0;
    border: 1px solid rgba(215, 224, 232, 0.12);
    border-radius: 1rem;
    background: #0c1218;
    color: var(--paper);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
  }

  .ride-dialog::backdrop {
    background: rgba(6, 10, 14, 0.82);
  }

  .ride-stage {
    position: relative;
    background: #080c11;
  }

  .ride-stage img {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(84vh, 52rem);
    object-fit: contain;
    background: #080c11;
  }

  .ride-nav,
  .ride-close {
    position: absolute;
    z-index: 2;
    border: 0;
    background: rgba(12, 18, 24, 0.72);
    color: var(--paper);
    cursor: pointer;
  }

  .ride-nav {
    top: 50%;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    transform: translateY(-50%);
    font-size: 1.6rem;
    line-height: 1;
  }

  .ride-prev {
    left: 0.7rem;
  }

  .ride-next {
    right: 0.7rem;
  }

  .ride-close {
    top: 0.7rem;
    right: 0.7rem;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    font-size: 1.4rem;
    line-height: 1;
  }

  .ride-nav:hover,
  .ride-close:hover {
    background: rgba(212, 163, 90, 0.28);
  }

  @media (max-width: 640px) {
    .prose :global(figure) {
      float: none;
      width: min(100%, 16rem);
      margin: 0.85rem auto 1.15rem;
    }

    .prose :global(figure img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
