---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Milo’s cube — six faces, six realms.
 * Swap the REALMS array anytime; the cube stays the door.
 */
const REALMS = [
  {
    id: 'night',
    face: 'front',
    title: 'Night Ride',
    kicker: 'Berlin after dark',
    lead: 'Street lamps in a soft line. Milo clips in and the city thins out until it’s only tyres and breath.',
    detail:
      'A realm of quiet kilometres — canal paths, empty junctions, the soft amber that means you’re still moving.',
    hue: '#1e3a45',
    accent: '#f0c27a',
  },
  {
    id: 'cafe',
    face: 'back',
    title: 'Café Dawn',
    kicker: 'First light, first cup',
    lead: 'The shutters are half up. Milo leans the bike and waits for the machine to wake.',
    detail:
      'Espresso steam, a window seat, and the map still folded. The ride hasn’t started — it has already begun.',
    hue: '#3d2a1c',
    accent: '#e8b86d',
  },
  {
    id: 'col',
    face: 'right',
    title: 'The Col',
    kicker: 'Up where the air thins',
    lead: 'Hairpins stack like a ladder. Milo counts them out loud so the climb feels smaller than it is.',
    detail:
      'Stone, wind, and a summit marker that looks tiny until you’re next to it. Then the world opens.',
    hue: '#2a3540',
    accent: '#9eb6c4',
  },
  {
    id: 'salt',
    face: 'left',
    title: 'Salt Road',
    kicker: 'Sea on the left shoulder',
    lead: 'The Riviera throws light back at the tarmac. Milo rides the line between spray and shade.',
    detail:
      'Warm air, salt on the lips, a café that still has sand under the tables. The ocean keeps pace.',
    hue: '#1a4050',
    accent: '#6eb0c4',
  },
  {
    id: 'patch',
    face: 'top',
    title: 'Patch Box',
    kicker: 'Small cloth, big story',
    lead: 'Inside the cube: threads, needles, and the patches that mark where Milo has been.',
    detail:
      'Each square is a place kept close — stitched on a bag, a jersey, a quiet jacket for the next tour.',
    hue: '#3a2428',
    accent: '#e31b23',
  },
  {
    id: 'rail',
    face: 'bottom',
    title: 'Rail Quiet',
    kicker: 'Bike in the carriage',
    lead: 'The train takes the long middle. Milo watches fields blur and plans the next clip-in.',
    detail:
      'A soft seat, a hung bike, and the strange peace of moving without pedalling — until the doors open again.',
    hue: '#1c2430',
    accent: '#d4a35a',
  },
] as const;

const faceMeta = [
  { face: 'front', label: 'Night Ride' },
  { face: 'back', label: 'Café Dawn' },
  { face: 'right', label: 'The Col' },
  { face: 'left', label: 'Salt Road' },
  { face: 'top', label: 'Patch Box' },
  { face: 'bottom', label: 'Rail Quiet' },
] as const;
---

<BaseLayout
  title="Milo"
  description="Milo’s cube — turn it in space, open a face, step into one of six realms."
>
  <section class="milo" data-milo>
    <div class="milo-sky" aria-hidden="true">
      <span class="milo-star"></span>
      <span class="milo-star"></span>
      <span class="milo-star"></span>
      <span class="milo-glow"></span>
    </div>

    <div class="site-shell milo-intro">
      <p class="eyebrow">A toy in space</p>
      <h1 class="section-title">Milo</h1>
      <p class="section-lead">
        One little figure. One cube. Six realms. Drag to turn it — tap a face and that side opens so
        you can see the world inside.
      </p>
    </div>

    <div class="milo-stage" data-milo-stage>
      <p class="milo-hint" data-milo-hint>Drag to turn · tap a face to open</p>
      <div class="milo-scene" data-milo-scene>
        <div class="milo-cube" data-milo-cube role="group" aria-label="Milo’s six-realm cube">
          {
            REALMS.map((realm) => (
              <button
                type="button"
                class:list={['milo-face', `milo-face--${realm.face}`]}
                data-milo-face={realm.face}
                data-realm={realm.id}
                style={`--face-hue:${realm.hue};--face-accent:${realm.accent}`}
                aria-label={`${realm.title}. Open this realm.`}
              >
                <span class="milo-face-lid" aria-hidden="true">
                  <span class="milo-face-mark">{realm.title}</span>
                  <span class="milo-face-kicker">{realm.kicker}</span>
                </span>
                <span class="milo-face-well" aria-hidden="true"></span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="milo-realm"
      data-milo-realm
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby="milo-realm-title"
    >
      <div class="milo-realm-panel">
        <p class="milo-realm-kicker" data-milo-realm-kicker></p>
        <h2 class="milo-realm-title" id="milo-realm-title" data-milo-realm-title></h2>
        <p class="milo-realm-lead" data-milo-realm-lead></p>
        <p class="milo-realm-detail" data-milo-realm-detail></p>
        <button type="button" class="milo-realm-close" data-milo-close>Close the hatch</button>
      </div>
    </div>

    <div class="site-shell milo-key">
      <h2 class="milo-key-title">The six faces</h2>
      <ol class="milo-key-list">
        {
          faceMeta.map((item) => {
            const realm = REALMS.find((r) => r.face === item.face)!;
            return (
              <li>
                <button type="button" data-milo-jump={realm.face}>
                  <span class="milo-key-swatch" style={`background:${realm.hue};box-shadow:inset 0 0 0 1px ${realm.accent}55`} />
                  <span>
                    <strong>{realm.title}</strong>
                    <em>{realm.kicker}</em>
                  </span>
                </button>
              </li>
            );
          })
        }
      </ol>
      <p class="milo-note">
        Change the six stories whenever you like — same cube, new adventures. This page is Milo’s
        door.
      </p>
    </div>
  </section>

  <script define:vars={{ REALMS }}>
    (function () {
      var root = document.querySelector('[data-milo]');
      if (!root) return;

      var cube = root.querySelector('[data-milo-cube]');
      var scene = root.querySelector('[data-milo-scene]');
      var stage = root.querySelector('[data-milo-stage]');
      var hint = root.querySelector('[data-milo-hint]');
      var realmEl = root.querySelector('[data-milo-realm]');
      var closeBtn = root.querySelector('[data-milo-close]');
      if (!cube || !scene || !stage || !realmEl) return;

      var rx = -18;
      var ry = 32;
      var auto = true;
      var dragging = false;
      var moved = false;
      var lastX = 0;
      var lastY = 0;
      var openFace = null;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var FACE_POSE = {
        front: { rx: 0, ry: 0 },
        back: { rx: 0, ry: 180 },
        right: { rx: 0, ry: -90 },
        left: { rx: 0, ry: 90 },
        top: { rx: -90, ry: 0 },
        bottom: { rx: 90, ry: 0 },
      };

      function applyPose() {
        cube.style.setProperty('--rx', rx + 'deg');
        cube.style.setProperty('--ry', ry + 'deg');
      }

      function nearestAngle(current, target) {
        var delta = ((((target - current) % 360) + 540) % 360) - 180;
        return current + delta;
      }

      function tweenTo(face, done) {
        var pose = FACE_POSE[face];
        if (!pose) return;
        auto = false;
        var startRx = rx;
        var startRy = ry;
        var endRx = pose.rx;
        var endRy = nearestAngle(ry, pose.ry);
        var t0 = performance.now();
        var dur = reduceMotion ? 1 : 520;

        function frame(now) {
          var t = Math.min(1, (now - t0) / dur);
          var e = 1 - Math.pow(1 - t, 3);
          rx = startRx + (endRx - startRx) * e;
          ry = startRy + (endRy - startRy) * e;
          applyPose();
          if (t < 1) requestAnimationFrame(frame);
          else if (done) done();
        }
        requestAnimationFrame(frame);
      }

      function realmByFace(face) {
        for (var i = 0; i < REALMS.length; i++) {
          if (REALMS[i].face === face) return REALMS[i];
        }
        return null;
      }

      function openRealm(face) {
        var realm = realmByFace(face);
        if (!realm) return;
        openFace = face;
        root.classList.add('milo--open');
        cube.querySelectorAll('[data-milo-face]').forEach(function (btn) {
          btn.classList.toggle('is-open', btn.getAttribute('data-milo-face') === face);
        });
        realmEl.hidden = false;
        realmEl.style.setProperty('--realm-hue', realm.hue);
        realmEl.style.setProperty('--realm-accent', realm.accent);
        root.querySelector('[data-milo-realm-kicker]').textContent = realm.kicker;
        root.querySelector('[data-milo-realm-title]').textContent = realm.title;
        root.querySelector('[data-milo-realm-lead]').textContent = realm.lead;
        root.querySelector('[data-milo-realm-detail]').textContent = realm.detail;
        requestAnimationFrame(function () {
          realmEl.classList.add('is-visible');
        });
        if (hint) hint.hidden = true;
      }

      function closeRealm() {
        openFace = null;
        root.classList.remove('milo--open');
        cube.querySelectorAll('[data-milo-face].is-open').forEach(function (btn) {
          btn.classList.remove('is-open');
        });
        realmEl.classList.remove('is-visible');
        window.setTimeout(function () {
          if (!openFace) realmEl.hidden = true;
        }, 320);
        if (hint) hint.hidden = false;
        if (!reduceMotion) auto = true;
      }

      function chooseFace(face) {
        if (openFace === face) {
          closeRealm();
          return;
        }
        tweenTo(face, function () {
          openRealm(face);
        });
      }

      cube.querySelectorAll('[data-milo-face]').forEach(function (btn) {
        btn.addEventListener('click', function (event) {
          if (moved) {
            event.preventDefault();
            return;
          }
          chooseFace(btn.getAttribute('data-milo-face'));
        });
      });

      root.querySelectorAll('[data-milo-jump]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          chooseFace(btn.getAttribute('data-milo-jump'));
          stage.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeRealm);

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && openFace) closeRealm();
      });

      function onPointerDown(event) {
        if (openFace) return;
        dragging = true;
        moved = false;
        auto = false;
        lastX = event.clientX;
        lastY = event.clientY;
        scene.setPointerCapture(event.pointerId);
      }

      function onPointerMove(event) {
        if (!dragging) return;
        var dx = event.clientX - lastX;
        var dy = event.clientY - lastY;
        if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
        ry += dx * 0.45;
        rx -= dy * 0.45;
        rx = Math.max(-68, Math.min(68, rx));
        lastX = event.clientX;
        lastY = event.clientY;
        applyPose();
      }

      function onPointerUp(event) {
        if (!dragging) return;
        dragging = false;
        try {
          scene.releasePointerCapture(event.pointerId);
        } catch (err) {}
        window.setTimeout(function () {
          moved = false;
          if (!openFace && !reduceMotion) auto = true;
        }, 180);
      }

      scene.addEventListener('pointerdown', onPointerDown);
      scene.addEventListener('pointermove', onPointerMove);
      scene.addEventListener('pointerup', onPointerUp);
      scene.addEventListener('pointercancel', onPointerUp);

      applyPose();

      if (!reduceMotion) {
        var last = performance.now();
        function spin(now) {
          var dt = Math.min(32, now - last);
          last = now;
          if (auto && !dragging && !openFace) {
            ry += dt * 0.012;
            rx = -18 + Math.sin(now / 2800) * 6;
            applyPose();
          }
          requestAnimationFrame(spin);
        }
        requestAnimationFrame(spin);
      }
    })();
  </script>
</BaseLayout>

<style>
  .milo {
    position: relative;
    isolation: isolate;
    padding: 0 0 4.5rem;
    overflow: clip;
  }

  .milo-sky {
    position: absolute;
    inset: 0 0 auto;
    height: min(78vh, 42rem);
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 35%, rgba(61, 107, 122, 0.28), transparent 62%),
      radial-gradient(ellipse 40% 30% at 18% 20%, rgba(212, 163, 90, 0.12), transparent 55%),
      radial-gradient(ellipse 35% 28% at 85% 18%, rgba(227, 27, 35, 0.08), transparent 50%);
  }

  .milo-star,
  .milo-star::before,
  .milo-star::after {
    content: '';
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: rgba(238, 243, 247, 0.75);
    box-shadow:
      8vw 12vh 0 rgba(238, 243, 247, 0.45),
      22vw 28vh 0 rgba(238, 243, 247, 0.35),
      70vw 16vh 0 rgba(238, 243, 247, 0.5),
      82vw 40vh 0 rgba(238, 243, 247, 0.3),
      45vw 8vh 0 rgba(240, 194, 122, 0.55),
      60vw 32vh 0 rgba(238, 243, 247, 0.4),
      12vw 42vh 0 rgba(238, 243, 247, 0.28);
  }

  .milo-star {
    top: 8%;
    left: 10%;
  }

  .milo-star:nth-child(2) {
    top: 18%;
    left: 55%;
    opacity: 0.7;
  }

  .milo-star:nth-child(3) {
    top: 30%;
    left: 78%;
    opacity: 0.55;
  }

  .milo-glow {
    position: absolute;
    left: 50%;
    top: 42%;
    width: min(28rem, 70vw);
    height: min(28rem, 70vw);
    translate: -50% -45%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 163, 90, 0.16), transparent 68%);
    filter: blur(8px);
  }

  .milo-intro {
    position: relative;
    z-index: 1;
    padding-top: 2.25rem;
    max-width: 36rem;
  }

  .milo-stage {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin: 0.5rem 0 2.5rem;
    min-height: min(68vh, 28rem);
    padding: 1rem 0 2rem;
  }

  .milo-hint {
    margin: 0;
    color: rgba(215, 224, 232, 0.62);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .milo-scene {
    position: relative;
    width: min(20rem, 78vw);
    height: min(20rem, 78vw);
    perspective: 56rem;
    touch-action: none;
    cursor: grab;
  }

  .milo-scene:active {
    cursor: grabbing;
  }

  .milo-cube {
    --rx: -18deg;
    --ry: 32deg;
    --size: min(12.5rem, 52vw);
    position: absolute;
    inset: 50% auto auto 50%;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    animation: milo-float 5.5s ease-in-out infinite;
  }

  @keyframes milo-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .milo-cube {
      animation: none;
    }
  }

  .milo-face {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(240, 194, 122, 0.28);
    border-radius: 0;
    background: transparent;
    color: var(--paper);
    font: inherit;
    cursor: pointer;
    transform-style: preserve-3d;
    -webkit-tap-highlight-color: transparent;
  }

  .milo-face:focus-visible {
    outline: 2px solid var(--amber-hot);
    outline-offset: 3px;
  }

  .milo-face-lid {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    gap: 0.2rem;
    padding: 0.85rem 0.9rem 1rem;
    text-align: left;
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--face-hue) 88%, white 12%), var(--face-hue)),
      radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--face-accent) 35%, transparent), transparent 55%);
    border: 1px solid color-mix(in srgb, var(--face-accent) 35%, transparent);
    box-shadow:
      inset 0 0 0 1px rgba(8, 12, 17, 0.35),
      inset 0 -2.5rem 2rem rgba(8, 12, 17, 0.35);
    transform-origin: top center;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
    backface-visibility: hidden;
  }

  .milo-face-well {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--face-accent) 22%, transparent), transparent 55%),
      linear-gradient(180deg, rgba(8, 12, 17, 0.15), rgba(8, 12, 17, 0.85));
    box-shadow: inset 0 0 2rem rgba(0, 0, 0, 0.45);
    transform: translateZ(-0.02rem);
  }

  .milo-face-mark {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 3.5vw, 1.45rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1.05;
    color: var(--paper);
    text-shadow: 0 1px 0 rgba(8, 12, 17, 0.45);
  }

  .milo-face-kicker {
    color: color-mix(in srgb, var(--face-accent) 80%, white 20%);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .milo-face--front {
    transform: translateZ(calc(var(--size) / 2));
  }
  .milo-face--back {
    transform: rotateY(180deg) translateZ(calc(var(--size) / 2));
  }
  .milo-face--right {
    transform: rotateY(90deg) translateZ(calc(var(--size) / 2));
  }
  .milo-face--left {
    transform: rotateY(-90deg) translateZ(calc(var(--size) / 2));
  }
  .milo-face--top {
    transform: rotateX(90deg) translateZ(calc(var(--size) / 2));
  }
  .milo-face--bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--size) / 2));
  }

  .milo-face.is-open .milo-face-lid {
    transform: rotateX(-118deg);
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.35);
  }

  .milo--open .milo-cube {
    animation: none;
  }

  .milo-realm {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background:
      radial-gradient(ellipse 80% 60% at 50% 40%, color-mix(in srgb, var(--realm-hue, #1e3a45) 55%, transparent), transparent 70%),
      rgba(8, 12, 17, 0.72);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .milo-realm.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .milo-realm-panel {
    width: min(28rem, 100%);
    padding: 1.5rem 1.4rem 1.35rem;
    border: 1px solid color-mix(in srgb, var(--realm-accent, var(--amber)) 40%, transparent);
    background:
      linear-gradient(165deg, color-mix(in srgb, var(--realm-hue, #1e3a45) 92%, white 8%), var(--realm-hue, #1e3a45));
    box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.45);
    transform: translateY(0.75rem) scale(0.98);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .milo-realm.is-visible .milo-realm-panel {
    transform: none;
  }

  .milo-realm-kicker {
    margin: 0;
    color: color-mix(in srgb, var(--realm-accent, var(--amber-hot)) 85%, white 15%);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .milo-realm-title {
    margin: 0.4rem 0 0.75rem;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .milo-realm-lead,
  .milo-realm-detail {
    margin: 0 0 0.85rem;
    color: rgba(238, 243, 247, 0.88);
    max-width: 34em;
  }

  .milo-realm-detail {
    color: rgba(215, 224, 232, 0.72);
  }

  .milo-realm-close {
    appearance: none;
    margin-top: 0.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--realm-accent, var(--amber)) 45%, transparent);
    border-radius: 0;
    background: rgba(8, 12, 17, 0.35);
    color: var(--amber-hot);
    font: inherit;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .milo-realm-close:hover,
  .milo-realm-close:focus-visible {
    background: rgba(8, 12, 17, 0.55);
    outline: none;
  }

  .milo-key {
    position: relative;
    z-index: 1;
    max-width: 36rem;
  }

  .milo-key-title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .milo-key-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid rgba(215, 224, 232, 0.14);
    background: rgba(8, 12, 17, 0.4);
  }

  .milo-key-list li {
    border-top: 1px solid rgba(215, 224, 232, 0.09);
  }

  .milo-key-list li:first-child {
    border-top: 0;
  }

  .milo-key-list button {
    display: grid;
    grid-template-columns: 1.55rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    width: 100%;
    margin: 0;
    padding: 0.8rem 0.95rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .milo-key-list button:hover,
  .milo-key-list button:focus-visible {
    background: rgba(240, 194, 122, 0.06);
    outline: none;
  }

  .milo-key-swatch {
    width: 1.55rem;
