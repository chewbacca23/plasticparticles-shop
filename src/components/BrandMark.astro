---
import { site } from '../site.config';

interface Props {
  /** Extra class on the outer span (brand-text, brand-hero, …). */
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['brand-mark', className]} aria-label={site.name}>
  <span class="brand-mark__the">
    <span class="brand-mark__splash" aria-hidden="true"></span>
    the
  </span><span class="brand-mark__caps"
    ><span class="brand-mark__soul">SOUL</span><span class="brand-mark__searchers">SEARCHERS</span></span
  >
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    line-height: 0.85;
    letter-spacing: 0;
  }

  .brand-mark__the {
    position: relative;
    z-index: 1;
    isolation: isolate;
    font-size: 0.55em;
    font-weight: 300;
    letter-spacing: 0;
    margin-right: 0.02em;
    color: var(--crest-red, #e31b23);
  }

  /* Light grey paint dash so the crest-red the jumps. */
  .brand-mark__splash {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    width: 2.15em;
    height: 1.55em;
    transform: translate(-48%, -52%) rotate(-12deg);
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 38% at 28% 42%, rgba(238, 243, 247, 0.72) 0%, transparent 72%),
      radial-gradient(ellipse 48% 44% at 62% 48%, rgba(215, 224, 232, 0.58) 0%, transparent 70%),
      radial-gradient(ellipse 28% 32% at 78% 28%, rgba(238, 243, 247, 0.5) 0%, transparent 68%),
      radial-gradient(ellipse 22% 26% at 18% 68%, rgba(215, 224, 232, 0.45) 0%, transparent 65%),
      radial-gradient(ellipse 18% 20% at 88% 72%, rgba(238, 243, 247, 0.4) 0%, transparent 70%);
    filter: blur(0.35px) contrast(1.05);
    opacity: 0.92;
  }

  .brand-mark__caps {
    display: inline-flex;
    letter-spacing: -0.045em;
  }

  .brand-mark__soul,
  .brand-mark__searchers {
    letter-spacing: inherit;
  }
</style>
