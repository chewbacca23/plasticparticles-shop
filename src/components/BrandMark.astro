---
import { site } from '../site.config';

interface Props {
  /** Extra class on the outer span (brand-text, brand-hero, …). */
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['brand-mark', className]} aria-label={site.name}>
  <span class="brand-mark__the">
    <img
      class="brand-mark__splash"
      src="/brand/ink-splat.png"
      alt=""
      width="258"
      height="230"
      decoding="async"
      aria-hidden="true"
    />
    the
  </span><span class="brand-mark__caps"
    ><span class="brand-mark__soul">SOUL</span><span class="brand-mark__searchers">SEARCHERS</span></span
  >
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    line-height: 0.85;
    letter-spacing: 0;
  }

  .brand-mark__the {
    position: relative;
    z-index: 1;
    isolation: isolate;
    font-size: 0.55em;
    font-weight: 300;
    letter-spacing: 0;
    margin-right: 0.06em;
    color: var(--crest-red, #e31b23);
  }

  /* Exact inkdot — only behind the red “the”, on the photo. */
  .brand-mark__splash {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    width: 3.4em;
    height: 3.05em;
    max-width: none;
    transform: translate(-50%, -52%) rotate(-6deg);
    pointer-events: none;
    user-select: none;
    object-fit: contain;
  }

  .brand-mark__caps {
    display: inline-flex;
    letter-spacing: -0.045em;
  }

  .brand-mark__soul,
  .brand-mark__searchers {
    letter-spacing: inherit;
  }
</style>
