---
import { site } from '../site.config';

interface Props {
  /** Extra class on the outer span (brand-text, brand-hero, …). */
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['brand-mark', className]} aria-label={site.name}>
  <span class="brand-mark__the">the</span><span class="brand-mark__caps"
    ><span class="brand-mark__soul">SOUL</span><span class="brand-mark__searchers">SEARCHERS</span></span
  >
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    line-height: 0.85;
    letter-spacing: 0;
  }

  .brand-mark__the {
    font-size: 0.55em;
    font-weight: 300;
    letter-spacing: 0;
    margin-right: 0.02em;
    color: var(--crest-red, #e31b23);
  }

  .brand-mark__caps {
    display: inline-flex;
    letter-spacing: -0.045em;
  }

  .brand-mark__soul,
  .brand-mark__searchers {
    letter-spacing: inherit;
  }
</style>
