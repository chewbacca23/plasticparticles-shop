<style>
  .brand-mark {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: baseline;
    isolation: isolate;
    white-space: nowrap;
    line-height: 0.85;
    letter-spacing: 0;
  }

  .brand-mark__splash {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    width: 112%;
    height: 1.55em;
    transform: translate(-50%, -52%) rotate(-4deg);
    pointer-events: none;
    overflow: visible;
  }

  .brand-mark__the {
    position: relative;
    z-index: 1;
    font-size: 0.55em;
    font-weight: 300;
    letter-spacing: 0;
    margin-right: 0.06em;
    color: var(--crest-red, #e31b23);
  }

  .brand-mark__caps {
    position: relative;
    z-index: 1;
    display: inline-flex;
    letter-spacing: -0.045em;
  }

  .brand-mark__soul,
  .brand-mark__searchers {
    letter-spacing: inherit;
  }
</style>
