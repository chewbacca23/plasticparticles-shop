---
import { site } from '../site.config';

interface Props {
  /** Extra class on the outer span (brand-text, brand-hero, …). */
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['brand-mark', className]} aria-label={site.name}>
  <span class="brand-mark__the">
    <svg
      class="brand-mark__splash"
      viewBox="0 0 120 90"
      aria-hidden="true"
      focusable="false"
    >
      <!-- Solid Photoshop-style grey paint splat -->
      <path
        fill="var(--paint-splash, #c8d0d8)"
        d="M58 8c8-6 18-5 24 2 4 4 5 9 3 14 7 1 14 6 15 14 1 7-3 13-9 16 4 5 4 12 0 17-3 5-9 7-14 6 0 7-5 14-13 15-7 1-13-3-16-9-4 4-11 5-16 1-5-3-7-9-5-14-6-1-11-6-11-13 0-6 4-11 10-13-2-5 0-12 5-15 5-4 12-3 16 1 2-5 7-9 11-12z"
      />
      <circle fill="var(--paint-splash, #c8d0d8)" cx="22" cy="28" r="5.5" />
      <circle fill="var(--paint-splash, #c8d0d8)" cx="18" cy="48" r="3.2" />
      <circle fill="var(--paint-splash, #c8d0d8)" cx="98" cy="24" r="4.5" />
      <circle fill="var(--paint-splash, #c8d0d8)" cx="104" cy="42" r="2.8" />
      <circle fill="var(--paint-splash, #c8d0d8)" cx="92" cy="68" r="3.6" />
      <circle fill="var(--paint-splash, #c8d0d8)" cx="34" cy="74" r="2.6" />
      <circle fill="var(--paint-splash, #c8d0d8)" cx="72" cy="12" r="2.4" />
      <circle fill="var(--paint-splash, #b8c2cc)" cx="48" cy="78" r="2" />
      <circle fill="var(--paint-splash, #b8c2cc)" cx="12" cy="58" r="1.8" />
    </svg>
    the
  </span><span class="brand-mark__caps"
    ><span class="brand-mark__soul">SOUL</span><span class="brand-mark__searchers">SEARCHERS</span></span
  >
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    line-height: 0.85;
    letter-spacing: 0;
  }

  .brand-mark__the {
    position: relative;
    z-index: 1;
    isolation: isolate;
    font-size: 0.55em;
    font-weight: 300;
    letter-spacing: 0;
    margin-right: 0.06em;
    color: var(--crest-red, #e31b23);
  }

  .brand-mark__splash {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    width: 2.85em;
    height: 2.15em;
    transform: translate(-50%, -54%) rotate(-9deg);
    pointer-events: none;
    overflow: visible;
  }

  .brand-mark__caps {
    display: inline-flex;
    letter-spacing: -0.045em;
  }

  .brand-mark__soul,
  .brand-mark__searchers {
    letter-spacing: inherit;
  }
</style>
