---
import { site } from '../site.config';

interface Props {
  /** Hero uses a slightly stronger watermark */
  variant?: 'hero' | 'default';
}

const { variant = 'default' } = Astro.props;
const opacity =
  variant === 'hero' ? Math.min(site.logoWatermarkOpacity + 0.03, 0.16) : site.logoWatermarkOpacity;
const watermarkSrc = site.logoWatermark ?? site.logo;
---

<div
  class="logo-backdrop"
  style={`--wm-opacity: ${opacity}; --wm-blur: ${site.logoWatermarkBlur}`}
  aria-hidden="true"
>
  <img
    class="logo-backdrop__mark"
    src={watermarkSrc}
    alt=""
    width="1003"
    height="1600"
    decoding="async"
  />
  <div class="logo-backdrop__veil"></div>
</div>

<style>
  .logo-backdrop {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .logo-backdrop__mark {
    position: absolute;
    right: clamp(-4rem, -2vw, 1rem);
    top: 50%;
    /* Big again — soft asset keeps pixels from shouting */
    width: min(58vw, 32rem);
    height: auto;
    transform: translateY(-48%);
    opacity: var(--wm-opacity, 0.11);
    filter: blur(var(--wm-blur, 2px)) saturate(0.92) brightness(1.15);
    mix-blend-mode: screen;
    image-rendering: auto;
    animation: logo-float 22s ease-in-out infinite;
  }

  .logo-backdrop__veil {
    position: absolute;
    inset: 0;
    /* Lighter veil so the crest still shows on the right */
    background: radial-gradient(ellipse 75% 65% at 74% 42%, transparent 38%, var(--ink) 82%);
  }

  @keyframes logo-float {
    0%,
    100% {
      transform: translateY(-48%) translateX(0) scale(1);
    }
    50% {
      transform: translateY(-50%) translateX(-1.5%) scale(1.02);
    }
  }

  @media (max-width: 720px) {
    .logo-backdrop__mark {
      right: -16%;
      width: min(88vw, 22rem);
      opacity: calc(var(--wm-opacity, 0.11) * 0.9);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-backdrop__mark {
      animation: none;
    }
  }
</style>
