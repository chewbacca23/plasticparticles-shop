---
import { site } from '../site.config';
import { instagramBind } from '../lib/instagram';
import settings from '../content/settings/instagram.json';

const year = new Date().getFullYear();
const instagram = instagramBind(settings);
---

<footer class="footer">
  <div class="site-shell footer-inner">
    <div>
      <p class="footer-brand">{site.name}</p>
      <p class="footer-tag">{site.tagline}</p>
    </div>
    <div class="footer-links">
      <a href="/now">Now</a>
      {
        instagram && (
          <a href={instagram.profileUrl} target="_blank" rel="noopener noreferrer">
            Instagram
          </a>
        )
      }
      <a href="/stories">Rides</a>
      <a href="/journal">Ride notes</a>
      <a href="/path">How we ride</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/impressum">Imprint</a>
      <a href="/rss.xml">RSS</a>
      <a class="admin-link" href="/admin/index.html">Edit content</a>
    </div>
    <p class="footer-copy">© {year} {site.name}. A cycling blog. Packed light. Owned, not rented.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid rgba(215, 224, 232, 0.08);
    background: linear-gradient(180deg, transparent, rgba(30, 58, 69, 0.28));
  }

  .footer-inner {
    display: grid;
    gap: 1.25rem;
    padding: 2.75rem 0 2.25rem;
  }

  .footer-brand {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--paper);
  }

  .footer-tag,
  .footer-copy {
    margin: 0.35rem 0 0;
    color: rgba(215, 224, 232, 0.62);
    font-size: 0.92rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
  }

  .footer-links a {
    text-decoration: none;
    color: rgba(215, 224, 232, 0.82);
  }

  .footer-links a:hover {
    color: var(--amber-hot);
  }

  .footer-links .admin-link {
    opacity: 0.75;
  }

  @media (min-width: 800px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }

    .footer-copy {
      grid-column: 1 / -1;
    }
  }
</style>
