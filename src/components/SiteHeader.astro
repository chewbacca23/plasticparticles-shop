---
import { site } from '../site.config';
import { instagramBind } from '../lib/instagram';
import settings from '../content/settings/instagram.json';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const instagram = instagramBind(settings);
const links = [
  { href: '/', label: 'Home' },
  { href: '/now', label: 'Now' },
  { href: '/stories', label: 'Rides' },
  { href: '/journal', label: 'Ride notes' },
  { href: '/friends', label: 'Friends' },
  { href: '/shop', label: 'Shop' },
  { href: '/path', label: 'How we ride' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class:list={['header', { 'header--home': isHome }]}>
  <div class="site-shell header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src={site.logo} alt="" width="40" height="51" decoding="async" />
      <span class="brand-text">{site.name}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: pathname === link.href }]}
            aria-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        instagram && (
          <a
            class="nav-link"
            href={instagram.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )
      }
    </nav>
  </div>
</header>

{
  isHome && (
    <script is:inline>
      (function () {
        function bindCrestHand() {
          var header = document.querySelector('.header--home');
          var heroCrest = document.querySelector('.hero-logo');
          if (!header) return;
          if (!heroCrest || !('IntersectionObserver' in window)) {
            header.classList.add('crest-in');
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                header.classList.toggle('crest-in', !entry.isIntersecting);
              });
            },
            { root: null, threshold: 0, rootMargin: '0px 0px 0px 0px' },
          );
          io.observe(heroCrest);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindCrestHand);
        } else {
          bindCrestHand();
        }
      })();
    </script>
  )
}

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(215, 224, 232, 0.06);
    background: rgba(10, 14, 20, 0.65);
    backdrop-filter: blur(16px) saturate(1.1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--paper);
  }

  .brand-logo {
    width: 2.4rem;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(212, 163, 90, 0.35));
  }

  /* Home: big hero crest owns the mark until it scrolls away. */
  .header--home .brand {
    gap: 0;
    transition: gap 280ms ease;
  }

  .header--home .brand-logo {
    width: 0;
    max-width: 0;
    opacity: 0;
    transform: scale(0.82);
    overflow: hidden;
    pointer-events: none;
    transition:
      width 280ms ease,
      max-width 280ms ease,
      opacity 220ms ease,
      transform 280ms ease;
  }

  .header--home.crest-in .brand {
    gap: 0.75rem;
  }

  .header--home.crest-in .brand-logo {
    width: 2.4rem;
    max-width: 2.4rem;
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1rem;
  }

  .nav-link {
    color: rgba(215, 224, 232, 0.72);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--amber-hot);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 0.85rem;
    }

    .nav {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header--home .brand,
    .header--home .brand-logo {
      transition: none;
    }
  }
</style>
