---
import { site } from '../site.config';
import { instagramBind } from '../lib/instagram';
import settings from '../content/settings/instagram.json';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const instagram = instagramBind(settings);
const links = [
  { href: '/', label: 'Home' },
  { href: '/now', label: 'Now' },
  { href: '/stories', label: 'Rides' },
  { href: '/journal', label: 'Ride notes' },
  { href: '/friends', label: 'Friends' },
  { href: '/shop', label: 'Shop' },
  { href: '/path', label: 'How we ride' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class:list={['header', { 'header--home': isHome }]} style={isHome ? '--crest: 0;' : undefined}>
  <div class="site-shell header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src={site.logo} alt="" width="40" height="51" decoding="async" />
      <span class="brand-text">{site.name}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: pathname === link.href }]}
            aria-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        instagram && (
          <a
            class="nav-link"
            href={instagram.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )
      }
    </nav>
  </div>
</header>

{
  isHome && (
    <script is:inline>
      (function () {
        function bindCrestFlight() {
          var header = document.querySelector('.header--home');
          var heroCrest = document.querySelector('.hero-logo');
          var headerCrest = header && header.querySelector('.brand-logo');
          var brandText = header && header.querySelector('.brand-text');
          if (!header || !headerCrest) return;
          if (!heroCrest) {
            header.style.setProperty('--crest', '1');
            return;
          }

          var reduce =
            window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var ticking = false;
          var runway = null;
          var flyer = document.createElement('img');
          flyer.className = 'crest-flyer';
          flyer.src = heroCrest.currentSrc || heroCrest.src;
          flyer.alt = '';
          flyer.setAttribute('aria-hidden', 'true');
          document.body.appendChild(flyer);

          function easeInOut(t) {
            return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          }

          function easeOut(t) {
            return 1 - Math.pow(1 - t, 3);
          }

          function lerp(a, b, t) {
            return a + (b - a) * t;
          }

          function targetBox() {
            var text = brandText.getBoundingClientRect();
            var width = 38.4;
            var height = width * (51 / 40);
            var gap = 12;
            return {
              left: text.left - gap - width,
              top: text.top + (text.height - height) / 2,
              width: width,
              height: height,
            };
          }

          function hideFlyer() {
            flyer.style.opacity = '0';
            flyer.style.visibility = 'hidden';
          }

          function showHero() {
            heroCrest.style.removeProperty('opacity');
            heroCrest.style.removeProperty('visibility');
            heroCrest.style.removeProperty('transform');
          }

          function hideHero() {
            // Keep layout for FLIP math; only the flyer should be seen mid-flight.
            heroCrest.style.setProperty('opacity', '0', 'important');
            heroCrest.style.setProperty('visibility', 'hidden', 'important');
            heroCrest.style.setProperty('transform', 'none', 'important');
          }

          function updateCrest() {
            ticking = false;
            var headerBox = header.getBoundingClientRect();
            var heroBox = heroCrest.getBoundingClientRect();
            var gap = heroBox.top - headerBox.bottom;

            if (!runway) {
              var restGap = Math.max(gap, heroBox.height);
              runway = {
                startGap: Math.max(restGap - 10, 96),
                endGap: -Math.max(heroBox.height * 0.55, 48),
              };
            }

            var span = runway.startGap - runway.endGap;
            if (span < 1) span = 1;
            var raw = (runway.startGap - gap) / span;
            if (raw < 0) raw = 0;
            if (raw > 1) raw = 1;

            if (reduce) {
              hideFlyer();
              var hard = raw >= 0.5 ? 1 : 0;
              header.style.setProperty('--crest', String(hard));
              header.classList.toggle('crest-in', hard === 1);
              if (hard) hideHero();
              else showHero();
              return;
            }

            var tMove = easeInOut(raw);
            var tSize = easeOut(raw);
            // Open space in the bar a little ahead of the crest landing.
            var tSlot = easeOut(Math.min(1, raw * 1.15));

            header.style.setProperty('--crest', tSlot.toFixed(4));
            header.classList.toggle('crest-in', raw > 0.96);

            if (raw <= 0.001) {
              hideFlyer();
              showHero();
              return;
            }

            if (raw >= 0.98) {
              hideFlyer();
              hideHero();
              return;
            }

            // One crest only: the flyer eases from the big hero mark into the small header mark.
            hideHero();
            var to = targetBox();
            var left = lerp(heroBox.left, to.left, tMove);
            var top = lerp(heroBox.top, to.top, tMove);
            var width = lerp(heroBox.width, to.width, tSize);

            flyer.style.visibility = 'visible';
            flyer.style.opacity = '1';
            flyer.style.width = width.toFixed(2) + 'px';
            flyer.style.transform =
              'translate3d(' + left.toFixed(2) + 'px, ' + top.toFixed(2) + 'px, 0)';
          }

          function onScroll() {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(updateCrest);
          }

          updateCrest();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindCrestFlight);
        } else {
          bindCrestFlight();
        }
      })();
    </script>
  )
}

<style is:global>
  .crest-flyer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 4rem;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translate3d(-9999px, -9999px, 0);
    filter: drop-shadow(0 12px 30px rgba(212, 163, 90, 0.4));
    will-change: transform, width, opacity;
    transform-origin: center center;
  }

  @media (prefers-reduced-motion: reduce) {
    .crest-flyer {
      display: none !important;
    }
  }
</style>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(215, 224, 232, 0.06);
    background: rgba(10, 14, 20, 0.65);
    backdrop-filter: blur(16px) saturate(1.1);
    overflow: visible;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    overflow: visible;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--paper);
  }

  .brand-logo {
    width: 2.4rem;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(212, 163, 90, 0.35));
  }

  /* Home: crest flies into the bar; settled mark only appears at the end. */
  .header--home {
    --crest: 0;
  }

  .header--home .brand {
    gap: calc(0.75rem * var(--crest));
  }

  .header--home .brand-logo {
    width: 2.4rem;
    max-width: calc(2.4rem * var(--crest));
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .header--home.crest-in .brand-logo {
    opacity: 1;
    pointer-events: auto;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1rem;
  }

  .nav-link {
    color: rgba(215, 224, 232, 0.72);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--amber-hot);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 0.85rem;
    }

    .nav {
      justify-content: flex-start;
    }
  }
</style>
