---
import { site } from '../site.config';
import { instagramBind } from '../lib/instagram';
import settings from '../content/settings/instagram.json';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const instagram = instagramBind(settings);
const links = [
  { href: '/', label: 'Home' },
  { href: '/now', label: 'Now' },
  { href: '/stories', label: 'Rides' },
  { href: '/journal', label: 'Ride notes' },
  { href: '/friends', label: 'Friends' },
  { href: '/shop', label: 'Shop' },
  { href: '/path', label: 'How we ride' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class:list={['header', { 'header--home': isHome }]} style={isHome ? '--crest: 0;' : undefined}>
  <div class="site-shell header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src={site.logo} alt="" width="40" height="51" decoding="async" />
      <span class="brand-text">{site.name}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: pathname === link.href }]}
            aria-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        instagram && (
          <a
            class="nav-link"
            href={instagram.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )
      }
    </nav>
  </div>
</header>

{
  isHome && (
    <script is:inline>
      (function () {
        function bindCrestFlight() {
          var header = document.querySelector('.header--home');
          var heroCrest = document.querySelector('.hero-logo');
          var headerCrest = header && header.querySelector('.brand-logo');
          if (!header || !headerCrest || !heroCrest) {
            if (header) header.style.setProperty('--crest', '1');
            return;
          }

          var reduce =
            window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          // Fixed-duration flight so laptop trackpads still show a real glide.
          var DURATION = 1100;
          var state = 'hero'; // hero | flying | header
          var direction = 1; // 1 = up into header, -1 = back to hero
          var fromBox = null;
          var toBox = null;
          var startedAt = 0;
          var flying = false;

          var flyer = document.createElement('img');
          flyer.className = 'crest-flyer';
          flyer.src = heroCrest.currentSrc || heroCrest.src;
          flyer.alt = '';
          flyer.setAttribute('aria-hidden', 'true');
          document.body.appendChild(flyer);

          function easeInOut(t) {
            return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          }

          function lerp(a, b, t) {
            return a + (b - a) * t;
          }

          function copyBox(box) {
            return {
              left: box.left,
              top: box.top,
              width: Math.max(box.width, 1),
              height: Math.max(box.height, 1),
            };
          }

          function headerSlot() {
            var logo = headerCrest.getBoundingClientRect();
            var bar = header.querySelector('.header-inner').getBoundingClientRect();
            var width = 38.4;
            var height = width * (51 / 40);
            return {
              left: logo.left,
              top: bar.top + (bar.height - height) / 2,
              width: width,
              height: height,
            };
          }

          function hideFlyer() {
            flyer.style.opacity = '0';
            flyer.style.visibility = 'hidden';
          }

          function showHero() {
            heroCrest.style.removeProperty('opacity');
            heroCrest.style.removeProperty('visibility');
            heroCrest.style.removeProperty('transform');
          }

          function hideHero() {
            heroCrest.style.setProperty('opacity', '0', 'important');
            heroCrest.style.setProperty('visibility', 'hidden', 'important');
            heroCrest.style.setProperty('transform', 'none', 'important');
          }

          function setHeaderCrest(on) {
            header.style.setProperty('--crest', on ? '1' : '0');
            header.classList.toggle('crest-in', !!on);
          }

          function paintFlyer(from, to, t) {
            var e = easeInOut(t);
            var left = lerp(from.left, to.left, e);
            var top = lerp(from.top, to.top, e);
            var width = lerp(from.width, to.width, e);
            flyer.style.visibility = 'visible';
            flyer.style.opacity = '1';
            flyer.style.width = width.toFixed(2) + 'px';
            flyer.style.transform =
              'translate3d(' + left.toFixed(2) + 'px, ' + top.toFixed(2) + 'px, 0)';
            // Open the logo slot as the crest arrives.
            var slot = direction > 0 ? e : 1 - e;
            header.style.setProperty('--crest', slot.toFixed(4));
          }

          function finish(up) {
            flying = false;
            hideFlyer();
            if (up) {
              state = 'header';
              hideHero();
              setHeaderCrest(true);
            } else {
              state = 'hero';
              showHero();
              setHeaderCrest(false);
            }
          }

          function startFlight(up) {
            if (reduce) {
              finish(up);
              return;
            }

            direction = up ? 1 : -1;
            toBox = headerSlot();

            if (up) {
              fromBox = copyBox(heroCrest.getBoundingClientRect());
              toBox = headerSlot();
              // Trackpad jumps often leave the crest already at the bar.
              // Guarantee a long, on-screen glide into the small header mark.
              var barBottom = header.getBoundingClientRect().bottom;
              var minTravel = 220;
              if (fromBox.top < toBox.top + minTravel) {
                fromBox.top = Math.min(window.innerHeight * 0.52, toBox.top + 320);
                fromBox.left = Math.max(toBox.left, Math.min(fromBox.left || toBox.left + 80, window.innerWidth * 0.4));
                fromBox.width = Math.max(fromBox.width, 110);
                fromBox.height = fromBox.width * (51 / 40);
              }
              hideHero();
              setHeaderCrest(false);
            } else {
              fromBox = headerSlot();
              showHero();
              toBox = copyBox(heroCrest.getBoundingClientRect());
              hideHero();
              setHeaderCrest(true);
            }

            startedAt = performance.now();
            state = 'flying';
            flying = true;
            paintFlyer(fromBox, toBox, 0);
            window.requestAnimationFrame(step);
          }

          function step(now) {
            if (!flying) return;
            var t = (now - startedAt) / DURATION;
            if (t >= 1) {
              paintFlyer(fromBox, toBox, 1);
              finish(direction > 0);
              return;
            }
            if (t < 0) t = 0;
            paintFlyer(fromBox, toBox, t);
            window.requestAnimationFrame(step);
          }

          function shouldFlyUp() {
            // Never on the initial hero view — only after a real scroll.
            if (window.scrollY < 48) return false;
            var hero = heroCrest.getBoundingClientRect();
            var barBottom = header.getBoundingClientRect().bottom;
            // Start while the big crest is still on screen, heading into the bar.
            return hero.top < barBottom + 220 || hero.top < window.innerHeight * 0.42;
          }

          function shouldFlyDown() {
            if (window.scrollY < 24) return true;
            var hero = heroCrest.getBoundingClientRect();
            return hero.top > window.innerHeight * 0.55;
          }

          function onScroll() {
            if (flying) return;

            if (state === 'hero' && shouldFlyUp()) {
              startFlight(true);
              return;
            }

            if (state === 'header' && shouldFlyDown()) {
              startFlight(false);
            }
          }

          hideFlyer();
          setHeaderCrest(false);
          showHero();
          // Do not run onScroll() here — on laptop the crest already sits in the
          // upper half, which would fire the flight before any scroll.
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', function () {
            if (state === 'header') setHeaderCrest(true);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindCrestFlight);
        } else {
          bindCrestFlight();
        }
      })();
    </script>
  )
}

<style is:global>
  .crest-flyer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 80;
    width: 4rem;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translate3d(-9999px, -9999px, 0);
    filter: drop-shadow(0 14px 34px rgba(212, 163, 90, 0.45));
    will-change: transform, width, opacity;
    transform-origin: center center;
  }

  @media (prefers-reduced-motion: reduce) {
    .crest-flyer {
      display: none !important;
    }
  }
</style>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(215, 224, 232, 0.06);
    background: rgba(10, 14, 20, 0.65);
    backdrop-filter: blur(16px) saturate(1.1);
    overflow: visible;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    overflow: visible;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--paper);
  }

  .brand-logo {
    width: 2.4rem;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(212, 163, 90, 0.35));
  }

  .header--home {
    --crest: 0;
  }

  .header--home .brand {
    gap: calc(0.75rem * var(--crest));
  }

  .header--home .brand-logo {
    width: 2.4rem;
    max-width: calc(2.4rem * var(--crest));
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .header--home.crest-in .brand-logo {
    opacity: 1;
    pointer-events: auto;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1rem;
  }

  .nav-link {
    color: rgba(215, 224, 232, 0.72);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--amber-hot);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 0.85rem;
    }

    .nav {
      justify-content: flex-start;
    }
  }
</style>
