---
import { site } from '../site.config';
import { instagramBind } from '../lib/instagram';
import settings from '../content/settings/instagram.json';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const instagram = instagramBind(settings);
const links = [
  { href: '/', label: 'Home' },
  { href: '/now', label: 'Now' },
  { href: '/stories', label: 'Rides' },
  { href: '/journal', label: 'Ride notes' },
  { href: '/friends', label: 'Friends' },
  { href: '/shop', label: 'Shop' },
  { href: '/path', label: 'How we ride' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class:list={['header', { 'header--home': isHome }]} style={isHome ? '--crest: 0;' : undefined}>
  <div class="site-shell header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src={site.logo} alt="" width="40" height="51" decoding="async" />
      <span class="brand-text">{site.name}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: pathname === link.href }]}
            aria-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        instagram && (
          <a
            class="nav-link"
            href={instagram.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )
      }
    </nav>
  </div>
</header>

{
  isHome && (
    <script is:inline>
      (function () {
        function bindCrestGlide() {
          var header = document.querySelector('.header--home');
          var heroCrest = document.querySelector('.hero-logo');
          if (!header) return;
          if (!heroCrest) {
            header.style.setProperty('--crest', '1');
            return;
          }

          var reduce =
            window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var ticking = false;
          var runway = null;

          function easeInOut(t) {
            return 0.5 - 0.5 * Math.cos(Math.PI * t);
          }

          function updateCrest() {
            ticking = false;
            var headerBox = header.getBoundingClientRect();
            var heroBox = heroCrest.getBoundingClientRect();
            var gap = heroBox.top - headerBox.bottom;

            // Lock the runway from the crest's resting place so it only starts after a real scroll.
            if (!runway) {
              var restGap = Math.max(gap, heroBox.height);
              runway = {
                startGap: Math.max(restGap - 10, 96),
                endGap: -Math.max(heroBox.height * 0.65, 56),
              };
            }

            var span = runway.startGap - runway.endGap;
            if (span < 1) span = 1;
            var raw = (runway.startGap - gap) / span;
            if (raw < 0) raw = 0;
            if (raw > 1) raw = 1;
            var t = reduce ? (raw >= 0.5 ? 1 : 0) : easeInOut(raw);

            header.style.setProperty('--crest', t.toFixed(4));
            header.classList.toggle('crest-in', t > 0.02);

            if (t <= 0.001) {
              heroCrest.style.removeProperty('opacity');
              heroCrest.style.removeProperty('transform');
              return;
            }

            if (reduce) {
              heroCrest.style.setProperty('opacity', t >= 1 ? '0' : '', 'important');
              heroCrest.style.removeProperty('transform');
              return;
            }

            var out = 1 - t;
            heroCrest.style.setProperty('opacity', (out * 0.92).toFixed(4), 'important');
            heroCrest.style.setProperty(
              'transform',
              'translate3d(0, ' + (-36 * t).toFixed(2) + 'px, 0) scale(' + (1 - 0.14 * t).toFixed(4) + ')',
              'important',
            );
          }

          function onScroll() {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(updateCrest);
          }

          updateCrest();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindCrestGlide);
        } else {
          bindCrestGlide();
        }
      })();
    </script>
  )
}

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(215, 224, 232, 0.06);
    background: rgba(10, 14, 20, 0.65);
    backdrop-filter: blur(16px) saturate(1.1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--paper);
  }

  .brand-logo {
    width: 2.4rem;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(212, 163, 90, 0.35));
  }

  /* Home: crest glides from hero into the header as you scroll. */
  .header--home {
    --crest: 0;
  }

  .header--home .brand {
    gap: calc(0.75rem * var(--crest));
  }

  .header--home .brand-logo {
    width: 2.4rem;
    max-width: calc(2.4rem * var(--crest));
    opacity: var(--crest);
    transform: translate3d(
        calc((1 - var(--crest)) * -8px),
        calc((1 - var(--crest)) * 28px),
        0
      )
      scale(calc(0.88 + 0.12 * var(--crest)));
    overflow: hidden;
    pointer-events: none;
    will-change: opacity, transform, max-width;
  }

  .header--home.crest-in .brand-logo {
    pointer-events: auto;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1rem;
  }

  .nav-link {
    color: rgba(215, 224, 232, 0.72);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--amber-hot);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 0.85rem;
    }

    .nav {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header--home .brand-logo {
      will-change: auto;
    }
  }
</style>
