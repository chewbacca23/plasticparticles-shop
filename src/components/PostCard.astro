---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  label?: string;
  image?: string;
}

const { href, title, description, date, label, image } = Astro.props;
const formatted = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="card">
  <a class="card-link" href={href}>
    {
      image && (
        <img class="card-photo" src={image} alt="" width="720" height="480" loading="lazy" />
      )
    }
    {label && <p class="eyebrow">{label}</p>}
    <h3>{title}</h3>
    <p class="card-desc">{description}</p>
    <time datetime={date.toISOString()}>{formatted}</time>
  </a>
</article>

<style>
  .card {
    border-top: 1px solid rgba(215, 224, 232, 0.1);
  }

  .card-link {
    display: block;
    padding: 1.35rem 1rem 1.45rem;
    margin-inline: -1rem;
    border-radius: 0.85rem;
    text-decoration: none;
    transition:
      padding-left 180ms ease,
      background 180ms ease;
  }

  .card-link:hover {
    padding-left: 1.35rem;
    background: rgba(22, 32, 42, 0.45);
  }

  .card-photo {
    width: 100%;
    height: auto;
    display: block;
    margin: 0 0 0.9rem;
    border-radius: 0.75rem;
  }

  h3 {
    margin: 0 0 0.55rem;
    font-size: 1.35rem;
  }

  .card-desc {
    margin: 0 0 0.85rem;
    color: rgba(215, 224, 232, 0.72);
  }

  time {
    color: rgba(212, 163, 90, 0.9);
    font-size: 0.84rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
