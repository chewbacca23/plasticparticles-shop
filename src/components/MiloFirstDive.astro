---
/**
 * First Milo adventure — swim into the cube → island shore → underwater world
 * with numbered cubes Milo can hit to open (like the old Plastic Particles sea).
 */
const figure = '/milo/explorer-a.png';

const FINDS = [
  {
    n: 1,
    x: 420,
    y: 220,
    title: 'Nice',
    blurb: 'Where the Alps meet the sea — Promenade light and a long ride waiting.',
    href: '/stories/nice',
  },
  {
    n: 2,
    x: 720,
    y: 380,
    title: 'The mighty mountain',
    blurb: 'Hairpins like a ladder. The summit looks tiny until you’re next to it.',
    href: '/stories/the-mighty-mountain',
  },
  {
    n: 3,
    x: 980,
    y: 160,
    title: 'My personal ride',
    blurb: 'A ride that belongs to one pair of legs and one quiet map.',
    href: '/stories/my-personal-ride',
  },
  {
    n: 4,
    x: 1180,
    y: 420,
    title: 'The patch is here',
    blurb: 'Small cloth, big story — stitched close for the next tour.',
    href: '/stories/the-patch-is-here',
  },
  {
    n: 5,
    x: 1480,
    y: 240,
    title: 'Wonderful patches',
    blurb: 'Threads and colours that mark where the road has already been.',
    href: '/stories/the-most-wonderful-patches',
  },
  {
    n: 6,
    x: 1720,
    y: 460,
    title: 'Last shots of Nice',
    blurb: 'Gold on the bay, one more look before the train.',
    href: '/stories/the-last-shots-of-nice',
  },
  {
    n: 7,
    x: 1980,
    y: 180,
    title: 'Night before a tour',
    blurb: 'Bags packed, mind already on the first kilometre.',
    href: '/stories/the-night-before-a-tour',
  },
  {
    n: 8,
    x: 2220,
    y: 360,
    title: 'Write it down',
    blurb: 'Notes from the saddle — so the ride doesn’t vanish.',
    href: '/stories/write-it-down',
  },
  {
    n: 9,
    x: 2480,
    y: 200,
    title: 'Christoph from Cologne',
    blurb: 'A mate on the road, kilometres shared without much talk.',
    href: '/stories/christoph-my-mate-from-cologne',
  },
  {
    n: 10,
    x: 640,
    y: 520,
    title: 'Café dawn',
    blurb: 'Steam, a window seat, the map still folded.',
    href: '/milo/island',
  },
  {
    n: 11,
    x: 1320,
    y: 560,
    title: 'Salt road',
    blurb: 'Sea on the left shoulder, warm air on the lips.',
    href: '/milo/island',
  },
  {
    n: 12,
    x: 1880,
    y: 560,
    title: 'Moon dust',
    blurb: 'Quiet boots and Earth like a postcard on the horizon.',
    href: '/milo/moon',
  },
  {
    n: 13,
    x: 2680,
    y: 320,
    title: 'Sand sea',
    blurb: 'Wind writes lines across the dunes.',
    href: '/milo/sand',
  },
  {
    n: 14,
    x: 2900,
    y: 480,
    title: 'Cloud rail',
    blurb: 'A thin track through the weather.',
    href: '/milo/cloud',
  },
  {
    n: 15,
    x: 3100,
    y: 240,
    title: 'Ember hollow',
    blurb: 'Warmth without the burn — sparks like tiny street lamps.',
    href: '/milo/ember',
  },
];

const WORLD_W = 3400;
---

<section class="dive" data-dive data-act="intro">
  <p class="dive-skip">
    <button type="button" data-dive-skip>Skip to dive</button>
    <a href="/milo">Cube</a>
  </p>

  <div class="dive-act dive-act--intro" data-act-panel="intro">
    <div class="dive-space" aria-hidden="true"></div>
    <div class="dive-cube-wrap" data-dive-cube>
      <div class="dive-cube">
        <span class="dive-cube-face dive-cube-face--f"></span>
        <span class="dive-cube-face dive-cube-face--b"></span>
        <span class="dive-cube-face dive-cube-face--r"></span>
        <span class="dive-cube-face dive-cube-face--l"></span>
        <span class="dive-cube-face dive-cube-face--t"></span>
        <span class="dive-cube-face dive-cube-face--bo"></span>
      </div>
    </div>
    <img class="dive-milo dive-milo--intro" data-milo-intro src={figure} alt="" width="160" height="160" />
    <p class="dive-caption" data-caption>Milo swims into the cube…</p>
  </div>

  <div class="dive-act dive-act--shore" data-act-panel="shore" hidden>
    <div class="shore-sky" aria-hidden="true">
      <span class="shore-sun"></span>
      <span class="shore-palm"></span>
    </div>
    <div class="shore-sea" aria-hidden="true"><span class="shore-wave"></span></div>
    <div class="shore-sand" aria-hidden="true"></div>
    <img class="dive-milo dive-milo--shore" data-milo-shore src={figure} alt="Milo on the shore" width="200" height="200" />
    <p class="dive-caption dive-caption--shore" data-caption-shore>The cube opens into an island.</p>
    <button type="button" class="dive-jump" data-dive-jump hidden>Jump in</button>
  </div>

  <div class="dive-act dive-act--sea" data-act-panel="sea" hidden>
    <div class="sea-viewport" data-sea-view>
      <div class="sea-world" data-sea-world style={`width:${WORLD_W}px`}>
        <div class="sea-fx" aria-hidden="true">
          <span class="sea-caustic"></span>
          <span class="sea-kelp" style="left:8%"></span>
          <span class="sea-kelp" style="left:28%;height:34vh;animation-delay:-1s"></span>
          <span class="sea-kelp" style="left:52%;height:44vh;animation-delay:-2.1s"></span>
          <span class="sea-kelp" style="left:74%;height:30vh;animation-delay:-0.6s"></span>
          <span class="sea-kelp" style="left:90%;height:38vh;animation-delay:-1.7s"></span>
          <span class="sea-bubbles" data-bubbles></span>
        </div>

        {
          FINDS.map((find) => (
            <button
              type="button"
              class="sea-num"
              data-sea-num={find.n}
              data-title={find.title}
              data-blurb={find.blurb}
              data-href={find.href}
              style={`left:${find.x}px;top:${find.y}px`}
              aria-label={`Number ${find.n}. Swim into it to open.`}
            >
              <span class="sea-num-face">{find.n}</span>
            </button>
          ))
        }

        <img
          class="dive-milo dive-milo--swim"
          data-milo-swim
          src={figure}
          alt="Milo diving"
          width="140"
          height="140"
          draggable="false"
        />
      </div>
    </div>

    <p class="dive-hud">
      Swim into the numbers to open them · arrows / WASD or drag ·
      <span data-find-count>0</span>/{FINDS.length} ·
      <a href="/milo">Cube</a>
    </p>
  </div>

  <div class="sea-popup" data-sea-popup hidden role="dialog" aria-modal="true">
    <div class="sea-popup-panel">
      <p class="sea-popup-num" data-popup-num></p>
      <h2 class="sea-popup-title" data-popup-title></h2>
      <p class="sea-popup-blurb" data-popup-blurb></p>
      <p class="sea-popup-actions">
        <a class="sea-popup-link" data-popup-link href="#">Open</a>
        <button type="button" class="sea-popup-close" data-popup-close>Keep diving</button>
      </p>
    </div>
  </div>
</section>

<script define:vars={{ WORLD_W, FINDS_LEN: FINDS.length }}>
  (function () {
    var root = document.querySelector('[data-dive]');
    if (!root) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var miloShore = root.querySelector('[data-milo-shore]');
    var miloSwim = root.querySelector('[data-milo-swim]');
    var jumpBtn = root.querySelector('[data-dive-jump]');
    var caption = root.querySelector('[data-caption]');
    var captionShore = root.querySelector('[data-caption-shore]');
    var popup = root.querySelector('[data-sea-popup]');
    var findCountEl = root.querySelector('[data-find-count]');
    var opened = 0;
    var panels = {
      intro: root.querySelector('[data-act-panel="intro"]'),
      shore: root.querySelector('[data-act-panel="shore"]'),
      sea: root.querySelector('[data-act-panel="sea"]'),
    };

    function showAct(name) {
      root.setAttribute('data-act', name);
      Object.keys(panels).forEach(function (key) {
        var el = panels[key];
        if (!el) return;
        el.hidden = key !== name;
      });
    }

    function wait(ms) {
      return new Promise(function (resolve) {
        window.setTimeout(resolve, reduce ? Math.min(ms, 80) : ms);
      });
    }

    async function runIntro() {
      showAct('intro');
      root.classList.add('is-swimming');
      if (caption) caption.textContent = 'Milo swims into the cube…';
      await wait(2200);
      root.classList.add('is-inside');
      if (caption) caption.textContent = 'Inside the cube…';
      await wait(900);
      root.classList.add('is-opening');
      if (caption) caption.textContent = 'The cube opens…';
      await wait(1100);
      await goShore();
    }

    async function goShore() {
      showAct('shore');
      root.classList.add('is-shore');
      if (captionShore) captionShore.textContent = 'He stands on the island shore.';
      await wait(1400);
      if (jumpBtn) {
        jumpBtn.hidden = false;
        jumpBtn.focus();
      }
      if (captionShore) captionShore.textContent = 'Ready when you are.';
    }

    async function goDive() {
      if (jumpBtn) jumpBtn.hidden = true;
      root.classList.add('is-jumping');
      if (captionShore) captionShore.textContent = 'Milo jumps…';
      if (miloShore) miloShore.classList.add('is-jump');
      await wait(900);
      showAct('sea');
      root.classList.add('is-diving');
      startSwim();
    }

    if (jumpBtn) jumpBtn.addEventListener('click', goDive);

    var skip = root.querySelector('[data-dive-skip]');
    if (skip) {
      skip.addEventListener('click', function () {
        showAct('sea');
        root.classList.add('is-diving');
        startSwim();
      });
    }

    function openFind(btn) {
      if (!popup || btn.classList.contains('is-open')) return;
      btn.classList.add('is-open', 'is-bump');
      opened += 1;
      if (findCountEl) findCountEl.textContent = String(opened);
      popup.hidden = false;
      root.querySelector('[data-popup-num]').textContent = '#' + btn.getAttribute('data-sea-num');
      root.querySelector('[data-popup-title]').textContent = btn.getAttribute('data-title') || '';
      root.querySelector('[data-popup-blurb]').textContent = btn.getAttribute('data-blurb') || '';
      var link = root.querySelector('[data-popup-link]');
      var href = btn.getAttribute('data-href') || '/milo';
      link.setAttribute('href', href);
      requestAnimationFrame(function () {
        popup.classList.add('is-visible');
        btn.classList.remove('is-bump');
      });
    }

    function closePopup() {
      if (!popup) return;
      popup.classList.remove('is-visible');
      window.setTimeout(function () {
        popup.hidden = true;
      }, 220);
    }

    var closeBtn = root.querySelector('[data-popup-close]');
    if (closeBtn) closeBtn.addEventListener('click', closePopup);
    if (popup) {
      popup.addEventListener('click', function (event) {
        if (event.target === popup) closePopup();
      });
    }
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closePopup();
    });

    root.querySelectorAll('[data-sea-num]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openFind(btn);
      });
    });

    var swimStarted = false;
    function startSwim() {
      if (swimStarted || !miloSwim) return;
      swimStarted = true;
      var view = root.querySelector('[data-sea-view]');
      var world = root.querySelector('[data-sea-world]');
      if (!view || !world) return;

      var worldW = WORLD_W;
      var x = 180;
      var y = Math.min(320, view.clientHeight * 0.45);
      var vx = 0;
      var vy = 0;
      var keys = Object.create(null);
      var pointing = false;
      var tx = x;
      var ty = y;
      var miloW = 96;
      var miloH = 96;

      function cam() {
        var vw = view.clientWidth;
        var camX = Math.max(0, Math.min(x - vw * 0.35, worldW - vw));
        world.style.transform = 'translate3d(' + -camX + 'px,0,0)';
        return camX;
      }

      function clamp() {
        var pad = 40;
        var maxY = Math.max(pad, view.clientHeight - pad);
        x = Math.max(pad, Math.min(worldW - pad, x));
        y = Math.max(pad, Math.min(maxY, y));
      }

      function place() {
        miloSwim.style.transform =
          'translate(' +
          (x - miloW / 2) +
          'px,' +
          (y - miloH / 2) +
          'px) scaleX(' +
          (vx < -0.2 ? -1 : 1) +
          ') rotate(' +
          Math.max(-14, Math.min(14, vy * 2.2)) +
          'deg)';
        cam();
      }

      function hits() {
        var miloBox = { x: x - miloW * 0.28, y: y - miloH * 0.28, w: miloW * 0.56, h: miloH * 0.56 };
        root.querySelectorAll('[data-sea-num]:not(.is-open)').forEach(function (btn) {
          var nx = parseFloat(btn.style.left) || 0;
          var ny = parseFloat(btn.style.top) || 0;
          var size = 52;
          if (
            miloBox.x < nx + size &&
            miloBox.x + miloBox.w > nx &&
            miloBox.y < ny + size &&
            miloBox.y + miloBox.h > ny
          ) {
            openFind(btn);
          }
        });
      }

      function onKey(down, event) {
        var k = event.key.toLowerCase();
        if (
          k === 'arrowup' ||
          k === 'arrowdown' ||
          k === 'arrowleft' ||
          k === 'arrowright' ||
          k === 'w' ||
          k === 'a' ||
          k === 's' ||
          k === 'd'
        ) {
          event.preventDefault();
          keys[k] = down;
        }
      }

      window.addEventListener('keydown', function (e) {
        onKey(true, e);
      });
      window.addEventListener('keyup', function (e) {
        onKey(false, e);
      });

      view.addEventListener('pointerdown', function (event) {
        if (event.target.closest('[data-sea-num]') || event.target.closest('[data-sea-popup]')) return;
        pointing = true;
        view.setPointerCapture(event.pointerId);
        var camX = cam();
        var rect = view.getBoundingClientRect();
        tx = event.clientX - rect.left + camX;
        ty = event.clientY - rect.top;
      });
      view.addEventListener('pointermove', function (event) {
        if (!pointing) return;
        var camX = cam();
        var rect = view.getBoundingClientRect();
        tx = event.clientX - rect.left + camX;
        ty = event.clientY - rect.top;
      });
      view.addEventListener('pointerup', function () {
        pointing = false;
      });
      view.addEventListener('pointercancel', function () {
        pointing = false;
      });

      var last = performance.now();
      function tick(now) {
        var dt = Math.min(32, now - last) / 16.67;
        last = now;
        var ax = 0;
        var ay = 0;
        if (keys.arrowleft || keys.a) ax -= 1;
        if (keys.arrowright || keys.d) ax += 1;
        if (keys.arrowup || keys.w) ay -= 1;
        if (keys.arrowdown || keys.s) ay += 1;
        if (pointing) {
          ax += (tx - x) * 0.035;
          ay += (ty - y) * 0.035;
        }
        vx = vx * 0.86 + ax * 1.55 * dt;
        vy = vy * 0.86 + ay * 1.55 * dt;
        x += vx * dt * 3.4;
        y += vy * dt * 3.4;
        clamp();
        place();
        if (!popup || popup.hidden) hits();
        requestAnimationFrame(tick);
      }

      place();
      requestAnimationFrame(tick);

      var bubbleHost = root.querySelector('[data-bubbles]');
      if (bubbleHost && !reduce) {
        window.setInterval(function () {
          var b = document.createElement('span');
          b.className = 'sea-pop';
          b.style.left = x + 'px';
          b.style.top = y + 'px';
          bubbleHost.appendChild(b);
          window.setTimeout(function () {
            b.remove();
          }, 2800);
        }, 480);
      }
    }

    if (reduce) {
      showAct('sea');
      root.classList.add('is-diving');
      startSwim();
    } else {
      runIntro();
    }
  })();
</script>

<style>
  .dive {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: #070b10;
    color: #eef3f7;
  }

  :global(body:has(.dive) .header),
  :global(body:has(.dive) .footer),
  :global(body:has(.dive) .logo-backdrop) {
    display: none;
  }

  .dive-skip {
    position: fixed;
    top: 0.75rem;
    right: 0.85rem;
    z-index: 30;
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.8rem;
  }

  .dive-skip a,
  .dive-skip button {
    color: rgba(215, 224, 232, 0.7);
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .dive-skip button:hover,
  .dive-skip a:hover {
    color: #f0c27a;
  }

  .dive-act {
    position: absolute;
    inset: 0;
  }

  .dive-caption {
    position: absolute;
    left: 50%;
    bottom: 12%;
    translate: -50% 0;
    z-index: 6;
    margin: 0;
    padding: 0.45rem 0.85rem;
    border: 1px solid rgba(240, 194, 122, 0.28);
    background: rgba(8, 12, 17, 0.55);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .dive-milo {
    position: absolute;
    z-index: 5;
    width: min(28vw, 9rem);
    height: auto;
    filter: drop-shadow(0 0.8rem 1rem rgba(0, 0, 0, 0.4));
    pointer-events: none;
    user-select: none;
  }

  .dive-space {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 50% 40%, rgba(61, 107, 122, 0.35), transparent 65%),
      #070b10;
  }

  .dive-cube-wrap {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(11rem, 42vw);
    height: min(11rem, 42vw);
    translate: -50% -50%;
    perspective: 40rem;
    transition:
      scale 1s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.8s ease;
  }

  .dive-cube {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    animation: cube-spin 10s linear infinite;
  }

  @keyframes cube-spin {
    to {
      transform: rotateX(-18deg) rotateY(360deg);
    }
  }

  .dive.is-opening .dive-cube {
    animation: cube-open 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes cube-open {
    to {
      transform: rotateX(12deg) rotateY(28deg) scale(1.8);
      opacity: 0;
    }
  }

  .dive.is-opening .dive-cube-wrap {
    scale: 2.4;
    opacity: 0;
  }

  .dive-cube-face {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(94, 196, 216, 0.45);
    background: linear-gradient(160deg, rgba(30, 80, 100, 0.85), rgba(10, 40, 55, 0.92));
  }

  .dive-cube-face--f {
    transform: translateZ(5.5rem);
  }
  .dive-cube-face--b {
    transform: rotateY(180deg) translateZ(5.5rem);
  }
  .dive-cube-face--r {
    transform: rotateY(90deg) translateZ(5.5rem);
  }
  .dive-cube-face--l {
    transform: rotateY(-90deg) translateZ(5.5rem);
  }
  .dive-cube-face--t {
    transform: rotateX(90deg) translateZ(5.5rem);
  }
  .dive-cube-face--bo {
    transform: rotateX(-90deg) translateZ(5.5rem);
  }

  .dive-milo--intro {
    left: -15%;
    top: 55%;
    opacity: 0;
  }

  .dive.is-swimming .dive-milo--intro {
    animation: swim-in 2.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes swim-in {
    0% {
      left: -15%;
      top: 58%;
      opacity: 0;
      rotate: -8deg;
    }
    20% {
      opacity: 1;
    }
    100% {
      left: 50%;
      top: 46%;
      translate: -50% -40%;
      opacity: 1;
      rotate: 4deg;
      scale: 0.55;
    }
  }

  .dive.is-inside .dive-milo--intro {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .dive-act--shore {
    background: linear-gradient(180deg, #4aa3c4 0%, #6eb8c9 40%, #c9b07a 40.2%, #c2a06a 62%, #2f6b5a 62.2%, #1e4a40 100%);
  }

  .shore-sun {
    position: absolute;
    top: 12%;
    right: 14%;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff3c4, #e8a83a 70%);
    box-shadow: 0 0 3rem rgba(240, 194, 122, 0.4);
  }

  .shore-palm {
    position: absolute;
    bottom: 38%;
    left: 12%;
    width: 0.5rem;
    height: 16vh;
    background: #5a3a22;
  }

  .shore-palm::before {
    content: '';
    position: absolute;
    top: -0.3rem;
    left: -2rem;
    width: 4.5rem;
    height: 2rem;
    background: radial-gradient(ellipse at center, #2f7a4a 0 40%, transparent 42%);
  }

  .shore-sea {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    height: 22%;
    background: linear-gradient(180deg, rgba(74, 163, 196, 0.5), rgba(40, 100, 120, 0.35));
  }

  .shore-wave {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -6deg,
      transparent 0 1.1rem,
      rgba(238, 243, 247, 0.2) 1.1rem 1.35rem
    );
    animation: wave-drift 9s linear infinite;
  }

  @keyframes wave-drift {
    to {
      translate: -2.5rem 0;
    }
  }

  .shore-sand {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    background: linear-gradient(180deg, #c9b07a, #a88858);
  }

  .dive-milo--shore {
    left: 50%;
    bottom: 34%;
    translate: -50% 0;
    width: min(32vw, 10.5rem);
  }

