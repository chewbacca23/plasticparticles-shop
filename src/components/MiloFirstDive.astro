---
/** First Milo adventure: swim into the cube → island shore → free dive. */
const figure = '/milo/explorer-a.png';
---

<section class="dive" data-dive data-act="intro">
  <p class="dive-skip">
    <button type="button" data-dive-skip>Skip to dive</button>
    <a href="/milo">Cube</a>
  </p>

  <!-- Act 1: cube in space, Milo swims in -->
  <div class="dive-act dive-act--intro" data-act-panel="intro">
    <div class="dive-space" aria-hidden="true"></div>
    <div class="dive-cube-wrap" data-dive-cube>
      <div class="dive-cube">
        <span class="dive-cube-face dive-cube-face--f"></span>
        <span class="dive-cube-face dive-cube-face--b"></span>
        <span class="dive-cube-face dive-cube-face--r"></span>
        <span class="dive-cube-face dive-cube-face--l"></span>
        <span class="dive-cube-face dive-cube-face--t"></span>
        <span class="dive-cube-face dive-cube-face--bo"></span>
      </div>
    </div>
    <img class="dive-milo dive-milo--intro" data-milo-intro src={figure} alt="" width="160" height="160" />
    <p class="dive-caption" data-caption>Milo swims into the cube…</p>
  </div>

  <!-- Act 2–3: island shore -->
  <div class="dive-act dive-act--shore" data-act-panel="shore" hidden>
    <div class="shore-sky" aria-hidden="true">
      <span class="shore-sun"></span>
      <span class="shore-palm"></span>
    </div>
    <div class="shore-sea" aria-hidden="true">
      <span class="shore-wave"></span>
    </div>
    <div class="shore-sand" aria-hidden="true"></div>
    <img class="dive-milo dive-milo--shore" data-milo-shore src={figure} alt="Milo on the shore" width="200" height="200" />
    <p class="dive-caption dive-caption--shore" data-caption-shore>The cube opens into an island.</p>
    <button type="button" class="dive-jump" data-dive-jump hidden>Jump in</button>
  </div>

  <!-- Act 4: free dive -->
  <div class="dive-act dive-act--sea" data-act-panel="sea" hidden>
    <div class="sea-fx" aria-hidden="true">
      <span class="sea-caustic"></span>
      <span class="sea-kelp"></span>
      <span class="sea-kelp sea-kelp--2"></span>
      <span class="sea-bubble" data-bubbles></span>
    </div>
    <div class="sea-play" data-sea-play>
      <img
        class="dive-milo dive-milo--swim"
        data-milo-swim
        src={figure}
        alt="Milo diving"
        width="140"
        height="140"
        draggable="false"
      />
    </div>
    <p class="dive-hud">
      Drag or use arrows / WASD to swim · <a href="/milo">Back to cube</a>
    </p>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-dive]');
    if (!root) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var miloIntro = root.querySelector('[data-milo-intro]');
    var miloShore = root.querySelector('[data-milo-shore]');
    var miloSwim = root.querySelector('[data-milo-swim]');
    var cubeWrap = root.querySelector('[data-dive-cube]');
    var jumpBtn = root.querySelector('[data-dive-jump]');
    var caption = root.querySelector('[data-caption]');
    var captionShore = root.querySelector('[data-caption-shore]');
    var panels = {
      intro: root.querySelector('[data-act-panel="intro"]'),
      shore: root.querySelector('[data-act-panel="shore"]'),
      sea: root.querySelector('[data-act-panel="sea"]'),
    };

    function showAct(name) {
      root.setAttribute('data-act', name);
      Object.keys(panels).forEach(function (key) {
        var el = panels[key];
        if (!el) return;
        el.hidden = key !== name;
      });
    }

    function wait(ms) {
      return new Promise(function (resolve) {
        window.setTimeout(resolve, reduce ? Math.min(ms, 80) : ms);
      });
    }

    async function runIntro() {
      showAct('intro');
      root.classList.add('is-swimming');
      if (caption) caption.textContent = 'Milo swims into the cube…';
      await wait(2200);
      root.classList.add('is-inside');
      if (caption) caption.textContent = 'Inside the cube…';
      await wait(900);
      root.classList.add('is-opening');
      if (caption) caption.textContent = 'The cube opens…';
      await wait(1100);
      await goShore();
    }

    async function goShore() {
      showAct('shore');
      root.classList.add('is-shore');
      if (captionShore) captionShore.textContent = 'He stands on the island shore.';
      await wait(1400);
      if (jumpBtn) {
        jumpBtn.hidden = false;
        jumpBtn.focus();
      }
      if (captionShore) captionShore.textContent = 'Ready when you are.';
    }

    async function goDive() {
      if (jumpBtn) jumpBtn.hidden = true;
      root.classList.add('is-jumping');
      if (captionShore) captionShore.textContent = 'Milo jumps…';
      if (miloShore) miloShore.classList.add('is-jump');
      await wait(900);
      showAct('sea');
      root.classList.add('is-diving');
      startSwim();
    }

    if (jumpBtn) jumpBtn.addEventListener('click', goDive);

    var skip = root.querySelector('[data-dive-skip]');
    if (skip) {
      skip.addEventListener('click', function () {
        showAct('sea');
        root.classList.add('is-diving');
        startSwim();
      });
    }

    // —— Free swim ——
    var swimStarted = false;
    function startSwim() {
      if (swimStarted || !miloSwim) return;
      swimStarted = true;
      var play = root.querySelector('[data-sea-play]');
      if (!play) return;

      var x = play.clientWidth * 0.5;
      var y = play.clientHeight * 0.45;
      var vx = 0;
      var vy = 0;
      var keys = Object.create(null);
      var pointing = false;
      var tx = x;
      var ty = y;

      function clamp() {
        var pad = 48;
        var maxX = play.clientWidth - pad;
        var maxY = play.clientHeight - pad;
        x = Math.max(pad, Math.min(maxX, x));
        y = Math.max(pad, Math.min(maxY, y));
      }

      function place() {
        miloSwim.style.transform =
          'translate(' +
          (x - miloSwim.offsetWidth / 2) +
          'px,' +
          (y - miloSwim.offsetHeight / 2) +
          'px) scaleX(' +
          (vx < -0.15 ? -1 : 1) +
          ') rotate(' +
          Math.max(-12, Math.min(12, vy * 2.5)) +
          'deg)';
      }

      function onKey(down, event) {
        var k = event.key.toLowerCase();
        if (
          k === 'arrowup' ||
          k === 'arrowdown' ||
          k === 'arrowleft' ||
          k === 'arrowright' ||
          k === 'w' ||
          k === 'a' ||
          k === 's' ||
          k === 'd'
        ) {
          event.preventDefault();
          keys[k] = down;
        }
      }

      window.addEventListener('keydown', function (e) {
        onKey(true, e);
      });
      window.addEventListener('keyup', function (e) {
        onKey(false, e);
      });

      play.addEventListener('pointerdown', function (event) {
        pointing = true;
        play.setPointerCapture(event.pointerId);
        var rect = play.getBoundingClientRect();
        tx = event.clientX - rect.left;
        ty = event.clientY - rect.top;
      });
      play.addEventListener('pointermove', function (event) {
        if (!pointing) return;
        var rect = play.getBoundingClientRect();
        tx = event.clientX - rect.left;
        ty = event.clientY - rect.top;
      });
      play.addEventListener('pointerup', function () {
        pointing = false;
      });
      play.addEventListener('pointercancel', function () {
        pointing = false;
      });

      var last = performance.now();
      function tick(now) {
        var dt = Math.min(32, now - last) / 16.67;
        last = now;

        var ax = 0;
        var ay = 0;
        if (keys.arrowleft || keys.a) ax -= 1;
        if (keys.arrowright || keys.d) ax += 1;
        if (keys.arrowup || keys.w) ay -= 1;
        if (keys.arrowdown || keys.s) ay += 1;

        if (pointing) {
          ax += (tx - x) * 0.04;
          ay += (ty - y) * 0.04;
        }

        vx = vx * 0.86 + ax * 1.5 * dt;
        vy = vy * 0.86 + ay * 1.5 * dt;
        x += vx * dt * 3.2;
        y += vy * dt * 3.2;
        clamp();
        place();
        requestAnimationFrame(tick);
      }

      place();
      requestAnimationFrame(tick);

      // Ambient bubbles near Milo
      var bubbleHost = root.querySelector('[data-bubbles]');
      if (bubbleHost && !reduce) {
        window.setInterval(function () {
          var b = document.createElement('span');
          b.className = 'sea-pop';
          b.style.left = x + 'px';
          b.style.top = y + 'px';
          bubbleHost.appendChild(b);
          window.setTimeout(function () {
            b.remove();
          }, 2800);
        }, 420);
      }
    }

    if (reduce) {
      showAct('sea');
      root.classList.add('is-diving');
      startSwim();
    } else {
      runIntro();
    }
  })();
</script>

<style>
  .dive {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: #070b10;
    color: #eef3f7;
  }

  :global(body:has(.dive) .header),
  :global(body:has(.dive) .footer),
  :global(body:has(.dive) .logo-backdrop) {
    display: none;
  }

  .dive-skip {
    position: fixed;
    top: 0.75rem;
    right: 0.85rem;
    z-index: 20;
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.8rem;
  }

  .dive-skip a,
  .dive-skip button {
    color: rgba(215, 224, 232, 0.7);
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .dive-skip button:hover,
  .dive-skip a:hover {
    color: #f0c27a;
  }

  .dive-act {
    position: absolute;
    inset: 0;
  }

  .dive-caption {
    position: absolute;
    left: 50%;
    bottom: 12%;
    translate: -50% 0;
    margin: 0;
    padding: 0.45rem 0.85rem;
    border: 1px solid rgba(240, 194, 122, 0.28);
    background: rgba(8, 12, 17, 0.55);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .dive-milo {
    position: absolute;
    z-index: 5;
    width: min(28vw, 9rem);
    height: auto;
    filter: drop-shadow(0 0.8rem 1rem rgba(0, 0, 0, 0.4));
    pointer-events: none;
    user-select: none;
  }

  /* —— Intro / cube —— */
  .dive-space {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 50% 40%, rgba(61, 107, 122, 0.35), transparent 65%),
      #070b10;
  }

  .dive-cube-wrap {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(11rem, 42vw);
    height: min(11rem, 42vw);
    translate: -50% -50%;
    perspective: 40rem;
    transition:
      scale 1s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.8s ease;
  }

  .dive-cube {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    animation: cube-spin 10s linear infinite;
  }

  @keyframes cube-spin {
    to {
      transform: rotateX(-18deg) rotateY(360deg);
    }
  }

  .dive.is-opening .dive-cube {
    animation: cube-open 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes cube-open {
    to {
      transform: rotateX(12deg) rotateY(28deg) scale(1.8);
      opacity: 0;
    }
  }

  .dive.is-opening .dive-cube-wrap {
    scale: 2.4;
    opacity: 0;
  }

  .dive-cube-face {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(94, 196, 216, 0.45);
    background: linear-gradient(160deg, rgba(30, 80, 100, 0.85), rgba(10, 40, 55, 0.92));
    box-shadow: inset 0 0 1.5rem rgba(94, 196, 216, 0.15);
  }

  .dive-cube-face--f {
    transform: translateZ(5.5rem);
  }
  .dive-cube-face--b {
    transform: rotateY(180deg) translateZ(5.5rem);
  }
  .dive-cube-face--r {
    transform: rotateY(90deg) translateZ(5.5rem);
  }
  .dive-cube-face--l {
    transform: rotateY(-90deg) translateZ(5.5rem);
  }
  .dive-cube-face--t {
    transform: rotateX(90deg) translateZ(5.5rem);
  }
  .dive-cube-face--bo {
    transform: rotateX(-90deg) translateZ(5.5rem);
  }

  @media (max-width: 520px) {
    .dive-cube-face--f {
      transform: translateZ(4.2rem);
    }
    .dive-cube-face--b {
      transform: rotateY(180deg) translateZ(4.2rem);
    }
    .dive-cube-face--r {
      transform: rotateY(90deg) translateZ(4.2rem);
    }
    .dive-cube-face--l {
      transform: rotateY(-90deg) translateZ(4.2rem);
    }
    .dive-cube-face--t {
      transform: rotateX(90deg) translateZ(4.2rem);
    }
    .dive-cube-face--bo {
      transform: rotateX(-90deg) translateZ(4.2rem);
    }
  }

  .dive-milo--intro {
    left: -15%;
    top: 55%;
    opacity: 0;
  }

  .dive.is-swimming .dive-milo--intro {
    animation: swim-in 2.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes swim-in {
    0% {
      left: -15%;
      top: 58%;
      opacity: 0;
      rotate: -8deg;
    }
    20% {
      opacity: 1;
    }
    100% {
      left: 50%;
      top: 46%;
      translate: -50% -40%;
      opacity: 1;
      rotate: 4deg;
      scale: 0.55;
    }
  }

  .dive.is-inside .dive-milo--intro {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* —— Shore —— */
  .dive-act--shore {
    background: linear-gradient(180deg, #4aa3c4 0%, #6eb8c9 40%, #c9b07a 40.2%, #c2a06a 62%, #2f6b5a 62.2%, #1e4a40 100%);
  }

  .shore-sun {
    position: absolute;
    top: 12%;
    right: 14%;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff3c4, #e8a83a 70%);
    box-shadow: 0 0 3rem rgba(240, 194, 122, 0.4);
  }

  .shore-palm {
    position: absolute;
    bottom: 38%;
    left: 12%;
    width: 0.5rem;
    height: 16vh;
    background: #5a3a22;
  }

  .shore-palm::before {
    content: '';
    position: absolute;
    top: -0.3rem;
    left: -2rem;
    width: 4.5rem;
    height: 2rem;
    background: radial-gradient(ellipse at center, #2f7a4a 0 40%, transparent 42%);
  }

  .shore-sea {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    height: 22%;
    background: linear-gradient(180deg, rgba(74, 163, 196, 0.5), rgba(40, 100, 120, 0.35));
  }

  .shore-wave {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -6deg,
      transparent 0 1.1rem,
      rgba(238, 243, 247, 0.2) 1.1rem 1.35rem
    );
    animation: wave-drift 9s linear infinite;
  }

  @keyframes wave-drift {
    to {
      translate: -2.5rem 0;
    }
  }

  .shore-sand {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    background: linear-gradient(180deg, #c9b07a, #a88858);
  }

  .dive-milo--shore {
    left: 50%;
    bottom: 34%;
    translate: -50% 0;
    width: min(32vw, 10.5rem);
  }

  .dive-milo--shore.is-jump {
    animation: shore-jump 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes shore-jump {
    0% {
      translate: -50% 0;
    }
    35% {
      translate: -50% -4rem;
      rotate: -12deg;
    }
    100% {
      translate: -30% 8rem;
      rotate: 18deg;
      opacity: 0;
      scale: 0.7;
    }
  }

  .dive-caption--shore {
    bottom: 8%;
  }

  .dive-jump {
    position: absolute;
    left: 50%;
    bottom: 14%;
    translate: -50% 0;
    z-index: 6;
    appearance: none;
    padding: 0.65rem 1.2rem;
    border: 1px solid rgba(240, 194, 122, 0.5);
    border-radius: 0;
    background: rgba(8, 12, 17, 0.45);
    color: #f0c27a;
    font: inherit;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .dive-jump:hover,
  .dive-jump:focus-visible {
    background: rgba(8, 12, 17, 0.7);
    outline: none;
  }

  /* —— Sea / free dive —— */
  .dive-act--sea {
    background:
      radial-gradient(ellipse 90% 55% at 50% 0%, rgba(70, 180, 210, 0.32), transparent 55%),
      linear-gradient(180deg, #123a4a 0%, #0a2430 45%, #061820 100%);
  }

  .sea-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sea-caustic {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 28% 16% at 32% 22%, rgba(150, 230, 255, 0.14), transparent 60%),
      radial-gradient(ellipse 22% 12% at 68% 30%, rgba(150, 230, 255, 0.1), transparent 60%);
    animation: caustic 5s ease-in-out infinite alternate;
  }

  @keyframes caustic {
    from {
      opacity: 0.5;
    }
    to {
      opacity: 1;
    }
  }

  .sea-kelp {
    position: absolute;
    bottom: -2%;
    left: 10%;
    width: 1.2rem;
    height: 40vh;
    border-radius: 2rem;
    background: linear-gradient(180deg, transparent, rgba(40, 120, 90, 0.55));
    transform-origin: bottom;
    animation: sway 5s ease-in-out infinite;
  }

  .sea-kelp--2 {
    left: auto;
    right: 14%;
    height: 32vh;
    animation-delay: -1.4s;
  }

  @keyframes sway {
    0%,
    100% {
      rotate: -5deg;
    }
    50% {
      rotate: 6deg;
    }
  }

  .sea-play {
    position: absolute;
    inset: 0;
    touch-action: none;
    cursor: crosshair;
  }

  .dive-milo--swim {
    left: 0;
    top: 0;
    width: min(26vw, 8.5rem);
    will-change: transform;
    transition: none;
  }

  .sea-pop {
    position: absolute;
    width: 0.4rem;
    height: 0.4rem;
    margin: -0.2rem 0 0 -0.2rem;
    border-radius: 50%;
    border: 1px solid rgba(180, 230, 245, 0.55);
    animation: pop-up 2.6s linear forwards;
    pointer-events: none;
  }

  @keyframes pop-up {
    to {
      translate: 0.5rem -8rem;
      opacity: 0;
    }
  }

  .dive-hud {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    translate: -50% 0;
    z-index: 8;
    margin: 0;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(94, 196, 216, 0.3);
    background: rgba(8, 12, 17, 0.5);
    font-size: 0.8rem;
    color: rgba(215, 224, 232, 0.78);
    white-space: nowrap;
  }

  .dive-hud a {
    color: #f0c27a;
  }

  @media (prefers-reduced-motion: reduce) {
    .dive-cube,
    .dive-milo--intro,
    .shore-wave,
    .sea-caustic,
    .sea-kelp {
      animation: none !important;
    }
  }
</style>
