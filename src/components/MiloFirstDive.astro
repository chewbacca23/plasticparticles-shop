---
/**
 * First Milo realm: island game — head-bump numbered packages.
 * Hub unfolds the cube into this full-screen world (?from=cube skips the old swim intro).
 */
const figure = '/milo/explorer-a.png';
const figureB = '/milo/explorer-b.png';
const figureC = '/milo/explorer-c.png';

const PACKAGES = [
  { name: 'Nice', emoji: '🌊', blurb: 'Alps meet the sea.', href: '/stories/nice' },
  { name: 'Mighty mountain', emoji: '⛰', blurb: 'Hairpins like a ladder.', href: '/stories/the-mighty-mountain' },
  { name: 'Personal ride', emoji: '🚲', blurb: 'One pair of legs, one map.', href: '/stories/my-personal-ride' },
  { name: 'The patch', emoji: '🧵', blurb: 'Small cloth, big story.', href: '/stories/the-patch-is-here' },
  { name: 'Wonderful patches', emoji: '✦', blurb: 'Colours from the road.', href: '/stories/the-most-wonderful-patches' },
  { name: 'Last shots of Nice', emoji: '☀', blurb: 'Gold on the bay.', href: '/stories/the-last-shots-of-nice' },
  { name: 'Night before a tour', emoji: '🌙', blurb: 'Bags packed, mind already gone.', href: '/stories/the-night-before-a-tour' },
  { name: 'Write it down', emoji: '✎', blurb: 'So the ride doesn’t vanish.', href: '/stories/write-it-down' },
  { name: 'Christoph', emoji: '🤝', blurb: 'A mate from Cologne.', href: '/stories/christoph-my-mate-from-cologne' },
  { name: 'Island', emoji: '🏝', blurb: 'Warm shore realm.', href: '/milo/island' },
  { name: 'Moon', emoji: '🌑', blurb: 'Quiet dust realm.', href: '/milo/moon' },
  { name: 'Sand sea', emoji: '🏜', blurb: 'Dunes and wind.', href: '/milo/sand' },
  { name: 'Cloud rail', emoji: '☁', blurb: 'Tracks in the sky.', href: '/milo/cloud' },
  { name: 'Ember hollow', emoji: '🔥', blurb: 'Night glow.', href: '/milo/ember' },
  { name: 'Home', emoji: '⌂', blurb: 'Back to the cube hub.', href: '/milo' },
];
---

<section class="dive" data-dive data-act="intro">
  <p class="dive-skip">
    <button type="button" data-dive-skip>Skip to realm</button>
    <a href="/milo">Cube</a>
  </p>

  <div class="dive-act dive-act--intro" data-act-panel="intro">
    <div class="dive-space" aria-hidden="true"></div>
    <div class="dive-cube-wrap" data-dive-cube>
      <div class="dive-cube">
        <span class="dive-cube-face dive-cube-face--f"></span>
        <span class="dive-cube-face dive-cube-face--b"></span>
        <span class="dive-cube-face dive-cube-face--r"></span>
        <span class="dive-cube-face dive-cube-face--l"></span>
        <span class="dive-cube-face dive-cube-face--t"></span>
        <span class="dive-cube-face dive-cube-face--bo"></span>
      </div>
    </div>
    <img class="dive-milo dive-milo--intro" data-milo-intro src={figure} alt="" width="160" height="160" />
    <p class="dive-caption" data-caption>Milo swims into the cube…</p>
  </div>

  <div class="dive-act dive-act--realm" data-act-panel="realm" hidden>
    <canvas class="dive-canvas" data-dive-canvas width="1400" height="900" aria-label="Milo island realm"></canvas>
    <div class="dive-touch" aria-hidden="true">
      <button type="button" data-key="ArrowLeft">‹</button>
      <button type="button" data-key="ArrowUp">⌃</button>
      <button type="button" data-key="ArrowRight">›</button>
    </div>
    <p class="dive-hud">
      Jump into numbers with your head · ← → ⌃ ·
      <span data-find-count>0</span>/{PACKAGES.length} ·
      <a href="/milo">Cube</a>
    </p>
  </div>

  <div class="sea-popup" data-sea-popup hidden role="dialog" aria-modal="true">
    <div class="sea-popup-panel">
      <p class="sea-popup-emoji" data-popup-emoji></p>
      <p class="sea-popup-num" data-popup-num></p>
      <h2 class="sea-popup-title" data-popup-title></h2>
      <p class="sea-popup-blurb" data-popup-blurb></p>
      <p class="sea-popup-actions">
        <a class="sea-popup-link" data-popup-link href="#">Open</a>
        <button type="button" class="sea-popup-close" data-popup-close>Keep playing</button>
      </p>
    </div>
  </div>
</section>

<script
  define:vars={{
    PACKAGES,
    FIGURE: figure,
    FIGURE_B: figureB,
    FIGURE_C: figureC,
  }}
>
  (function () {
    var root = document.querySelector('[data-dive]');
    if (!root) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var caption = root.querySelector('[data-caption]');
    var panels = {
      intro: root.querySelector('[data-act-panel="intro"]'),
      realm: root.querySelector('[data-act-panel="realm"]'),
    };
    var popup = root.querySelector('[data-sea-popup]');
    var findCountEl = root.querySelector('[data-find-count]');
    var opened = 0;
    var gameStarted = false;

    function showAct(name) {
      root.setAttribute('data-act', name);
      Object.keys(panels).forEach(function (key) {
        var el = panels[key];
        if (!el) return;
        el.hidden = key !== name;
      });
    }

    function wait(ms) {
      return new Promise(function (resolve) {
        window.setTimeout(resolve, reduce ? Math.min(ms, 60) : ms);
      });
    }

    async function runIntro() {
      showAct('intro');
      root.classList.add('is-swimming');
      if (caption) caption.textContent = 'Milo swims into the cube…';
      await wait(2000);
      root.classList.add('is-inside');
      if (caption) caption.textContent = 'The cube shrinks…';
      await wait(400);
      root.classList.add('is-shrinking');
      if (caption) caption.textContent = '…and the realm opens wide.';
      await wait(1100);
      enterRealm();
    }

    function enterRealm() {
      showAct('realm');
      root.classList.add('is-realm');
      startGame();
    }

    root.querySelector('[data-dive-skip]')?.addEventListener('click', enterRealm);

    function openPackage(pkg, num) {
      if (!popup || !pkg) return;
      opened += 1;
      if (findCountEl) findCountEl.textContent = String(opened);
      popup.hidden = false;
      root.querySelector('[data-popup-emoji]').textContent = pkg.emoji || '✦';
      root.querySelector('[data-popup-num]').textContent = '#' + num;
      root.querySelector('[data-popup-title]').textContent = pkg.name || '';
      root.querySelector('[data-popup-blurb]').textContent = pkg.blurb || '';
      root.querySelector('[data-popup-link]').setAttribute('href', pkg.href || '/milo');
      requestAnimationFrame(function () {
        popup.classList.add('is-visible');
      });
    }

    function closePopup() {
      if (!popup) return;
      popup.classList.remove('is-visible');
      window.setTimeout(function () {
        popup.hidden = true;
      }, 200);
    }

    root.querySelector('[data-popup-close]')?.addEventListener('click', closePopup);
    popup?.addEventListener('click', function (e) {
      if (e.target === popup) closePopup();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePopup();
    });

    function startGame() {
      if (gameStarted) return;
      gameStarted = true;
      var canvas = root.querySelector('[data-dive-canvas]');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = false;

      var W = 1400;
      var H = 900;
      var GROUND_Y = 780;
      var GRAVITY = 0.5;
      var JUMP = -16;
      var CW = 44;
      var CH = 44;
      var GAP = 8;
      var WORLD_W = 3200;

      function fit() {
        var parent = canvas.parentElement;
        var vw = parent.clientWidth;
        var vh = parent.clientHeight;
        var scale = Math.min(vw / W, vh / H);
        canvas.style.width = W * scale + 'px';
        canvas.style.height = H * scale + 'px';
      }
      fit();
      window.addEventListener('resize', fit);

      var bg = new Image();
      bg.src = '/milo/island-bg.png';
      var frames = [new Image(), new Image(), new Image()];
      frames[0].src = FIGURE;
      frames[1].src = FIGURE_B;
      frames[2].src = FIGURE_C;

      var wallY = GROUND_Y - 52 - CH - 160;
      var zones = [];
      for (var i = 0; i < PACKAGES.length; i++) {
        zones.push({
          x: 420 + i * (CW + GAP),
          y: wallY - (i % 3) * 70,
          w: CW,
          h: CH,
          number: i + 1,
          product: PACKAGES[i],
          hit: false,
          bumping: false,
          bounceY: 0,
          growing: 0,
          standingOn: false,
        });
      }

      var player = {
        x: 80,
        y: GROUND_Y - 52,
        w: 36,
        h: 52,
        vx: 0,
        vy: 0,
        onGround: false,
        dir: 1,
        frame: 0,
        frameTimer: 0,
        moving: false,
      };

      var keys = Object.create(null);
      var cameraX = 0;
      var targetCameraX = 0;
      var popupOpen = false;

      function setKey(k, down) {
        keys[k] = down;
      }

      window.addEventListener('keydown', function (e) {
        if (['ArrowLeft', 'ArrowRight', 'ArrowUp', ' '].indexOf(e.key) !== -1) {
          e.preventDefault();
          setKey(e.key, true);
        }
      });
      window.addEventListener('keyup', function (e) {
        setKey(e.key, false);
      });

      root.querySelectorAll('[data-key]').forEach(function (btn) {
        var k = btn.getAttribute('data-key');
        btn.addEventListener('touchstart', function (e) {
          e.preventDefault();
          setKey(k, true);
        });
        btn.addEventListener('touchend', function () {
          setKey(k, false);
        });
        btn.addEventListener('mousedown', function () {
          setKey(k, true);
        });
        btn.addEventListener('mouseup', function () {
          setKey(k, false);
        });
        btn.addEventListener('mouseleave', function () {
          setKey(k, false);
        });
      });

      function overlap(a, b) {
        return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
      }

      function cubeColor(n) {
        var h = (n * 47) % 360;
        return 'hsl(' + h + ',62%,48%)';
      }

      function drawCube(sx, sy, w, h, n) {
        ctx.fillStyle = cubeColor(n);
        ctx.fillRect(sx, sy, w, h);
        ctx.fillStyle = 'rgba(255,255,255,0.22)';
        ctx.fillRect(sx + 3, sy + 3, w - 6, h * 0.28);
        ctx.strokeStyle = '#1a1208';
        ctx.lineWidth = 3;
        ctx.strokeRect(sx, sy, w, h);
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 16px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(String(n), sx + w / 2, sy + h / 2 + 1);
        ctx.textAlign = 'left';
      }

      function drawMilo(ox) {
        var img = frames[player.moving ? player.frame % 3 : 0];
        var sx = player.x - ox;
        var sy = player.y;
        ctx.save();
        if (player.dir < 0) {
          ctx.translate(sx + player.w / 2, 0);
          ctx.scale(-1, 1);
          ctx.translate(-(sx + player.w / 2), 0);
        }
        if (img.complete && img.naturalWidth) {
          ctx.drawImage(img, sx - 6, sy - 8, player.w + 12, player.h + 10);
        } else {
          ctx.fillStyle = '#7F77DD';
          ctx.fillRect(sx, sy, player.w, player.h);
        }
        ctx.restore();
      }

      // Watch popup state
      var obs = new MutationObserver(function () {
        popupOpen = popup && !popup.hidden && popup.classList.contains('is-visible');
      });
      if (popup) obs.observe(popup, { attributes: true, attributeFilter: ['class', 'hidden'] });

      var last = 0;
      function loop(now) {
        var dt = last ? Math.min(2.2, (now - last) / 16.67) : 1;
        last = now;

        if (!popupOpen) {
          player.moving = false;
          if (keys.ArrowLeft) {
            player.vx = -4.2;
            player.dir = -1;
            player.moving = true;
          } else if (keys.ArrowRight) {
            player.vx = 4.2;
            player.dir = 1;
            player.moving = true;
          } else {
            player.vx *= 0.75;
            if (Math.abs(player.vx) < 0.2) player.vx = 0;
          }

          if ((keys.ArrowUp || keys[' ']) && player.onGround) {
            player.vy = JUMP;
            player.onGround = false;
          }

          player.vy += GRAVITY * dt;
          player.x += player.vx * dt;
          player.y += player.vy * dt;
          player.x = Math.max(0, Math.min(WORLD_W - player.w, player.x));

          player.onGround = false;
          if (player.y + player.h >= GROUND_Y) {
            player.y = GROUND_Y - player.h;
            player.vy = 0;
            player.onGround = true;
          }

          if (player.moving) {
            player.frameTimer += dt;
            if (player.frameTimer > 5) {
              player.frameTimer = 0;
              player.frame = (player.frame + 1) % 3;
            }
          }

          for (var zi = 0; zi < zones.length; zi++) {
            var z = zones[zi];
            if (z.hit) {
              if (z.growing < 1) z.growing = Math.min(1, z.growing + 0.05 * dt);
              continue;
            }
            if (overlap(player, z)) {
              var hitFromBelow = player.vy < 0 && player.y < z.y + z.h && player.y + player.h > z.y;
              var landingOnTop =
                player.vy >= 0 && player.y + player.h - z.y < 15 && player.y + player.h >= z.y;
              if (hitFromBelow) {
                z.bumping = true;
                z.bounceY = -18;
                player.vy = 2;
                if (z.y + z.h > player.y && z.y < player.y + 10) player.y = z.y + z.h + 2;
                (function (zone, num) {
                  window.setTimeout(function () {
                    zone.hit = true;
                    zone.growing = 0;
                    openPackage(zone.product, num);
                    popupOpen = true;
                  }, 280);
                })(z, z.number);
              } else if (landingOnTop) {
                player.y = z.y - player.h;
                player.vy = 0;
                player.onGround = true;
                z.standingOn = true;
              } else if (player.x + player.w - z.x < 15) {
                player.x = z.x - player.w;
                player.vx = 0;
              } else if (z.x + z.w - player.x < 15) {
                player.x = z.x + z.w;
                player.vx = 0;
              }
            } else {
              z.standingOn = false;
            }

            // Stand on cube and jump = also open (like old game)
            if (z.standingOn && !z.hit && (keys.ArrowUp || keys[' ']) && player.onGround) {
              z.bumping = true;
              z.bounceY = -10;
              z.standingOn = false;
              player.vy = JUMP * 0.8;
              player.onGround = false;
              (function (zone, num) {
                window.setTimeout(function () {
                  zone.hit = true;
                  zone.growing = 0;
                  openPackage(zone.product, num);
                  popupOpen = true;
                }, 280);
              })(z, z.number);
            }

            if (z.bumping && !z.hit) z.bounceY = Math.min(z.bounceY + 1.8 * dt, 0);
          }
        }

        targetCameraX = Math.max(0, Math.min(player.x - 280, WORLD_W - W));
        cameraX += (targetCameraX - cameraX) * 0.1 * dt;
        var ox = Math.round(cameraX);

        ctx.clearRect(0, 0, W, H);
        if (bg.complete && bg.naturalWidth) {
          var bgScale = H / bg.naturalHeight;
          var bgW = bg.naturalWidth * bgScale;
          var tiles = Math.ceil(WORLD_W / bgW) + 1;
          for (var t = 0; t < tiles; t++) {
            ctx.drawImage(bg, t * bgW - ox * 0.85, 0, bgW, H);
          }
        } else {
          var g = ctx.createLinearGradient(0, 0, 0, H);
          g.addColorStop(0, '#87CEEB');
          g.addColorStop(0.55, '#b8dce8');
          g.addColorStop(0.55, '#c9b07a');
          g.addColorStop(1, '#2f6b5a');
          ctx.fillStyle = g;
          ctx.fillRect(0, 0, W, H);
        }

        // Ground strip
        ctx.fillStyle = 'rgba(40, 80, 50, 0.35)';
        ctx.fillRect(0, GROUND_Y, W, H - GROUND_Y);

        for (var i = 0; i < zones.length; i++) {
          var zz = zones[i];
          var sx = zz.x - ox;
          var sy = zz.hit || zz.bumping ? zz.y + zz.bounceY : zz.y;
          if (sx < -120 || sx > W + 120) continue;
          if (zz.hit && zz.growing > 0) {
            var scale = 1 + zz.growing * 3.2;
            var ew = zz.w * scale;
            var eh = zz.h * scale;
            var ex = sx + zz.w / 2 - ew / 2;
            var ey = sy + zz.h / 2 - eh / 2;
            ctx.fillStyle = 'rgba(255,245,200,0.97)';
            ctx.fillRect(ex, ey, ew, eh);
            ctx.strokeStyle = '#26215C';
            ctx.lineWidth = 3;
            ctx.strokeRect(ex, ey, ew, eh);
            if (zz.growing > 0.55 && zz.product) {
              ctx.textAlign = 'center';
              ctx.fillStyle = '#26215C';
              ctx.font = 'bold ' + Math.round(ew / 3.2) + 'px sans-serif';
              ctx.fillText(zz.product.emoji || '✦', ex + ew / 2, ey + eh * 0.42);
              ctx.font = 'bold ' + Math.round(ew / 9) + 'px sans-serif';
              ctx.fillText(zz.product.name, ex + ew / 2, ey + eh * 0.72);
              ctx.textAlign = 'left';
            }
          } else if (!zz.hit) {
            drawCube(sx, sy, zz.w, zz.h, zz.number);
          }
        }

        drawMilo(ox);
        requestAnimationFrame(loop);
      }

      requestAnimationFrame(loop);
    }

    var fromCube = /(?:\?|&)from=cube(?:&|$)/.test(window.location.search);
    if (reduce || fromCube) enterRealm();
    else runIntro();
  })();
</script>

<style>
  .dive {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: #070b10;
    color: #eef3f7;
  }

  :global(body:has(.dive) .header),
  :global(body:has(.dive) .footer),
  :global(body:has(.dive) .logo-backdrop) {
    display: none;
  }

  .dive-skip {
    position: fixed;
    top: 0.75rem;
    right: 0.85rem;
    z-index: 40;
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.8rem;
  }

  .dive-skip a,
  .dive-skip button {
    color: rgba(215, 224, 232, 0.75);
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .dive-act {
    position: absolute;
    inset: 0;
  }

  .dive-caption {
    position: absolute;
    left: 50%;
    bottom: 12%;
    translate: -50% 0;
    z-index: 6;
    margin: 0;
    padding: 0.45rem 0.85rem;
    border: 1px solid rgba(240, 194, 122, 0.28);
    background: rgba(8, 12, 17, 0.55);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .dive-milo {
    position: absolute;
    z-index: 5;
    width: min(28vw, 9rem);
    height: auto;
    filter: drop-shadow(0 0.8rem 1rem rgba(0, 0, 0, 0.4));
    pointer-events: none;
  }

  .dive-space {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 50% 40%, rgba(61, 107, 122, 0.35), transparent 65%),
      #070b10;
  }

  .dive-cube-wrap {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(11rem, 42vw);
    height: min(11rem, 42vw);
    translate: -50% -50%;
    perspective: 40rem;
    transform-origin: center center;
    transition:
      transform 1.05s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.9s ease;
  }

  .dive.is-shrinking .dive-cube-wrap {
    transform: scale(0.08);
    opacity: 0;
  }

  .dive-cube {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    animation: cube-spin 10s linear infinite;
  }

  @keyframes cube-spin {
    to {
      transform: rotateX(-18deg) rotateY(360deg);
    }
  }

  .dive-cube-face {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(94, 196, 216, 0.45);
    background: linear-gradient(160deg, rgba(30, 80, 100, 0.85), rgba(10, 40, 55, 0.92));
  }

  .dive-cube-face--f {
    transform: translateZ(5.5rem);
  }
  .dive-cube-face--b {
    transform: rotateY(180deg) translateZ(5.5rem);
  }
  .dive-cube-face--r {
    transform: rotateY(90deg) translateZ(5.5rem);
  }
  .dive-cube-face--l {
    transform: rotateY(-90deg) translateZ(5.5rem);
  }
  .dive-cube-face--t {
    transform: rotateX(90deg) translateZ(5.5rem);
  }
  .dive-cube-face--bo {
    transform: rotateX(-90deg) translateZ(5.5rem);
  }

  .dive-milo--intro {
    left: -15%;
    top: 55%;
    opacity: 0;
  }

  .dive.is-swimming .dive-milo--intro {
    animation: swim-in 2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes swim-in {
    0% {
      left: -15%;
      top: 58%;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      left: 50%;
      top: 46%;
      translate: -50% -40%;
      opacity: 1;
      scale: 0.55;
    }
  }

  .dive.is-inside .dive-milo--intro,
  .dive.is-shrinking .dive-milo--intro {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .dive-act--realm {
    display: grid;
    place-items: center;
    background: #0a1520;
  }

  .dive-canvas {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 5.5rem);
    image-rendering: pixelated;
    border: 3px solid #26215c;
    background: #87ceeb;
  }

  .dive-touch {
    position: absolute;
    left: 50%;
    bottom: 3.4rem;
    translate: -50% 0;
    z-index: 20;
    display: none;
    gap: 0.75rem;
  }

  @media (max-width: 900px), (pointer: coarse) {
    .dive-touch {
      display: flex;
    }
  }

  .dive-touch button {
    width: 3.4rem;
    height: 3.4rem;
    border: 2px solid #7f77dd;
    border-radius: 0.5rem;
